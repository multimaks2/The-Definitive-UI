    { "GF_0004", { "Hi Carl!", "Salut, Carl_!", "Hi, Carl!", "Ciao Carl!", "¡Hola, Carl!", "Привет, Карл!", "¡Hola, Carl!", "¡Hola, Carl!" } },
    { "GF_0007", { "She seemed to have a good time, but she looks tired. You better take her home.", "Elle a l'air d'avoir passé une bonne soirée, on dirait, mais elle a l'air crevée. Tu ferais mieux de la ramener chez elle.", "Sie scheint sich amusiert zu haben, aber sie sieht müde aus. Fahr sie lieber nach Hause.", "Sembra che le sia piaciuto, ma ha l'aria un po' stanca. Faresti bene a riportarla a casa.", "Parece que se ha divertido, pero ahora está cansada. Será mejor que la lleves a su casa.", "Она хорошо провела время, но выглядит усталой. Тебе лучше отвезти ее домой.", "Parece que se ha divertido, pero ahora está cansada. Será mejor que la lleves a su casa.", "Parece que se ha divertido, pero ahora está cansada. Será mejor que la lleves a su casa." } },
    { "GF_0008", { "The date went well! Now she wants a lift back to her place...", "T'as assuré_! Maintenant, elle veut que tu la ramènes chez elle...", "Das Date ist gut gelaufen! Jetzt will sie nach Hause gefahren werden...", "L'appuntamento è andato bene! Ora vuole un passaggio per tornare a casa...", "¡La cita ha ido bien! Ahora quiere que la lleves a su casa...", "Свидание прошло отлично! Она хочет, чтобы ты отвез ее домой...", "¡La cita ha ido bien! Ahora quiere que la lleves a su casa...", "¡La cita ha ido bien! Ahora quiere que la lleves a su casa..." } },
    { "GF_0009", { "She seems happy enough. Now give her a run home!", "Elle à l'air jouasse. Maintenant, raccompagne-la chez elle_!", "Scheint ihr einigermaßen gefallen zu haben. Jetzt fahr sie nach Hause!", "Sembra abbastanza contenta. Dalle un passaggio a casa!", "Parece bastante contenta. ¡Ahora llévala a casa!", "Она очень счастлива. А теперь отвези ее домой", "Parece bastante contenta. ¡Ahora llévala a casa!", "Parece bastante contenta. ¡Ahora llévala a casa!" } },
    { "GF_0010", { "She likes you! Next time she might go a little further...", "Elle t'aime bien_! La prochaine fois, elle ira peut-être un peu plus loin...", "Sie mag dich! Das nächste Mal geht vielleicht ein bisschen mehr...", "Le piaci! La prossima volta potrebbe volersi spingere un po' più in là...", "¡Le gustas! La próxima vez puede que llegues más lejos con ella..", "Ты ей нравишься! В следующий раз она может зайти подальше...", "¡Le gustas! La próxima vez puede que llegues más lejos con ella..", "¡Le gustas! La próxima vez puede que llegues más lejos con ella.." } },
    { "GF_0011", { "Way to go, Casanova, she's dumped you! Oh well, there are plenty more fish in the sea.", "Bravo, Casanova, elle t'a largué_! Enfin, bon, c'est pas les meufs qui manquent dans le coin...", "Na, große Klasse, Casanova, sie hat mit dir Schluss gemacht! Na ja, andere Mütter haben auch schöne Töchter.", "Bel lavoro, Casanova, ti ha piantato! Oh beh, ci sono tanti altri pesci nel mare!", "Way to go, Casanova, she's dumped you! ¡Se acabó, Casanova, ha cortado contigo! Bueno, hay más peces en el mar.", "Ну что, Казанова, она бросила тебя! Ну и ладно, в океане еще много рыбы.", "Way to go, Casanova, she's dumped you! ¡Se acabó, Casanova, ha cortado contigo! Bueno, hay más peces en el mar.", "Way to go, Casanova, she's dumped you! ¡Se acabó, Casanova, ha cortado contigo! Bueno, hay más peces en el mar." } },
    { "GF_0012", { "Amateur! RULE No. 1 - NEVER drop a girl mid-date!", "Non mais quel amateur_! REGLE NUMERO 1_: ne JAMAIS, AU GRAND JAMAIS, larguer une meuf en plein rencard_!", "Du Amateur! REGEL Nr. 1 - Lass NIEMALS ein Mädchen während 'nem Date sitzen!", "Dilettante! REGOLA N. 1 - MAI mollare una ragazza nel mezzo di un appuntamento!", "¡Amateur! REGLA No. 1: ¡NUNCA dejes a una chica en mitad de una cita!", "ПРАВИЛО НОМЕР 1: Никогда не бросай свою девушку во время свидания!", "¡Amateur! REGLA No. 1: ¡NUNCA dejes a una chica en mitad de una cita!", "¡Amateur! REGLA No. 1: ¡NUNCA dejes a una chica en mitad de una cita!" } },
    { "GF_0014", { "This is it, she's inviting you in for coffee! Gird your loins for love...", "Ca y est, elle t'invite à boire un café_! Prépare-toi à une partie de jambes en l'air...", "Du hast es geschafft, sie lädt dich auf einen Kaffee ein! Mach deine Lenden bereit für Liebe....", "Ci sei, ti sta invitando da lei per un caffè! Preparati per un po' di movimento...", "¡Ya está, te ha invitado a tomar café! Esta noche mojas...", "Есть, она приглашает тебя зайти 'попить кофе'! Готовься к любви...", "¡Ya está, te ha invitado a tomar café! Esta noche mojas...", "¡Ya está, te ha invitado a tomar café! Esta noche mojas..." } },
    { "GF_0019", { "That's the spot! Remember; nice guys finish last!", "Tu \"tiens le bon bout\"_! Et rapelle-toi: les garçons bien élevés finissent toujours derniers_!", "Ja, das ist die Stelle! Denk daran: nette Kerle enden als Loser!", "Proprio così! Ricorda: i gentiluomini finiscono per ultimi!", "¡Ése es el punto! Recuerda: ¡los chicos buenos dejan que ellas acaben antes!", "Есть! Запомни, настоящие мужчины всегда кончают последними!", "¡Ése es el punto! Recuerda: ¡los chicos buenos dejan que ellas acaben antes!", "¡Ése es el punto! Recuerda: ¡los chicos buenos dejan que ellas acaben antes!" } },
    { "GF_0022", { "She wants you to drive her home! This could be it...", "Elle veut que tu la raccompagnes chez elle_! Ca s'présente pas mal, on dirait...", "Sie will, dass du sie nach Hause fährst! Das könnte was werden...", "Vuole che l'accompagni a casa! Forse ci sei...", "¡Quiere que la lleves a casa! Puede que la tengas en el bote...", "Она хочет, чтобы ты отвез ее домой. Может, она пригласит тебя зайти...", "¡Quiere que la lleves a casa! Puede que la tengas en el bote...", "¡Quiere que la lleves a casa! Puede que la tengas en el bote..." } },
    { "GF_0024", { "She wants to do a drive-by? This is one dangerous lady!", "Elle veut se faire une balade... disons explosive. Elle aime vivre dangereusement, cette meuf_!", "Sie will ein Drive-by machen? Das ist 'ne ganz schön gefährliche Lady!", "Vuole fare una sparatoria dall'auto? È una ragazza pericolosa!", "¿Quiere ponerse a disparar desde el coche? ¡Esta chica es de las peligrosas!", "Она хочет пострелять во врагов? А она опасная женщина!", "¿Quiere ponerse a disparar desde el coche? ¡Esta chica es de las peligrosas!", "¿Quiere ponerse a disparar desde el coche? ¡Esta chica es de las peligrosas!" } },
    { "GF_0025", { "You got a bit of a hair trigger there...", "T'es du genre 3 minutes douche comprise, toi_?", "Dein Abzug geht zu leicht los...", "Qualcuno è un po' troppo sensibile, qui...", "Parece que eres un poco precoz...", "У ТЕБЯ ТУТ НЕБОЛЬШАЯ ЗАГВОЗДКА...", "Parece que eres un poco precoz...", "Parece que eres un poco precoz..." } },
    { "GF_0026", { "She wants to go stuff her face!", "Elle veut se bâfrer, la gloutonne_!", "Sie will sich den Bauch vollschlagen!", "Vuole riempirsi la pancia!", "¡Se quiere poner cerda!", "Она хочет, чтобы ты убрал эту дурь от ее лица!", "¡Se quiere poner cerda!", "¡Se quiere poner cerda!" } },
    { "GF_0027", { "She wants to cruise. Maybe she'll want to park up someplace...", "Elle veut aller se promener. Elle voudra peut-être que tu te gares quelque part...", "Sie will eine kleine Spazierfahrt machen. Vielleicht will sie ja dann irgendwo parken und...", "Vuole farsi un giro! Magari poi vorrà anche parcheggiare da qualche parte...", "Quiere dar un paseo. Pero a lo mejor le apetece que aparques en alguna parte...", "Она хочет покататься. Может, она захочет где-нибудь остановиться...", "Quiere dar un paseo. Pero a lo mejor le apetece que aparques en alguna parte...", "Quiere dar un paseo. Pero a lo mejor le apetece que aparques en alguna parte..." } },
    { "GF_0028", { "She wants to check your dance moves! The ladies like a real mover!", "Elle veut voir comment tu bouges_! Cette meuf adore les danseurs_!", "Sie will sehen, wie du tanzt! Die Damen stehen auf gute Tänzer!", "Vuole vedere come ti muovi! Alle donne piace chi si sa muovere!", "¡Quiere ver cómo te mueves! ¡A las damas les gustan los bailongos!", "Она хочет посмотреть, как ты танцуешь! Девушки любят настоящих танцоров!", "¡Quiere ver cómo te mueves! ¡A las damas les gustan los bailongos!", "¡Quiere ver cómo te mueves! ¡A las damas les gustan los bailongos!" } },
    { "GF_0031", { "Uh-oh. She sounds bored. Quick, do something fun!", "Hum, on dirait qu'elle se fait chier. Vite, fais quelque chose_!", "O-oh! Sie klingt gelangweilt. Schnell, mach irgendwas Lustiges mit ihr!", "Oh oh. Sembra annoiata. Forza, fai qualcosa di divertente!", "Oh-oh. Parece aburrida. ¡Rápido, haz algo divertido!", "Ох-ох. Кажется, ей скучно. Быстро сделай что-нибудь, чтобы развлечь ее!", "Oh-oh. Parece aburrida. ¡Rápido, haz algo divertido!", "Oh-oh. Parece aburrida. ¡Rápido, haz algo divertido!" } },
    { "GF_0032", { "Ah. There you go, you see. You bored her legs shut!", "Ah_! Elle se fait tellement chier que ce soir, ce s'ra ceinture...", "Ah. Das hast du jetzt davon. Du hast sie so gelangweilt, dass sie die Beine garantiert nicht breit macht!", "Ecco fatto, vedi? Le hai fatto chiudere le gambe dalla noia!", "Ah. Ya ves, se acabó. ¡Si se aburre no va a abrirse de piernas!", "Вот видишь, ты вымотал ее, она устала бегать за тобой пешком!", "Ah. Ya ves, se acabó. ¡Si se aburre no va a abrirse de piernas!", "Ah. Ya ves, se acabó. ¡Si se aburre no va a abrirse de piernas!" } },
