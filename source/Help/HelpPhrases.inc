    { "TX_FULL", { "~r~You need an empty car to start taxi missions.", "~r~Il te faut une caisse vide pour commencer les missions Taxi.", "~r~Du brauchst ein leeres Auto, um Taxi-Missionen zu beginnen.", "~r~Ti serve una macchina vuota per iniziare le missioni da tassista.", "~r~Necesitas un coche vacío para comenzar las misiones de taxi.", "~r~Тебе нужна пустая машина, чтобы приступить к работе таксиста.", "~r~Necesitas un coche vacío para comenzar las misiones de taxi.", "~r~Necesitas un coche vacío para comenzar las misiones de taxi." } },
    { "HMLS_01", { "Hey buddy, spare a dollar?", "Hé mec, t'aurais pas un dollar_?", "Hey, Alter, haste mal 'n Dollar?", "Ehi amico, hai un dollaro?", "Ey, coleguita, ¿tienes un dólar?", "Эй, друг, лишнего доллара не найдется?", "Ey, coleguita, ¿tienes un dólar?", "Ey, coleguita, ¿tienes un dólar?" } },
    { "HMLS_02", { "C'mon you must have something you can give me?", "Allez, tu dois bien avoir quelque chose à me filer, non_?", "Komm schon, du musst doch irgendwas haben, was du mir geben kannst.", "Andiamo, davvero non hai niente da darmi?", "Vamos, seguro que me puedes dar algo.", "ДА ЛАДНО У ТЕБЯ ДОЛЖНО БЫТЬ ЧТО МНЕ ДАТЬ?", "Vamos, seguro que me puedes dar algo.", "Vamos, seguro que me puedes dar algo." } },
    { "HMLS_04", { "Hey man, got anything to drink?", "Hé mec, t'as pas un truc à boire_?", "Hey, Mann, hast du was zu trinken?", "Ehi amico, hai qualcosa da bere?", "Ey, tío, ¿tienes algo de beber?", "ЗИ МУЖИК ЕСТЬ ЧТО-НИБУДЬ ВЫПИТЬ?", "Ey, tío, ¿tienes algo de beber?", "Ey, tío, ¿tienes algo de beber?" } },
    { "BURG_03", { "Please don't kill me!", "Pitié, ne me tuez pas_!", "Bitte bringen Sie mich nicht um!", "Ti prego, non uccidermi!", "¡Por favor, no me mates!", "Пожалуйста, не убивай меня!", "¡Por favor, no me mates!", "¡Por favor, no me mates!" } },
    { "BURG_04", { "Somebody help there's a strange man in my house!", "Au secours, il y a un type louche dans ma maison_!", "Zu Hilfe, da ist ein fremder Mann in meinem Haus!", "Qualcuno mi aiuti, c'è un tizio sospetto in casa mia!", "¡Socorro, hay un desconocido en mi casa!", "Кто-нибудь, помогите, в моем доме чужак!", "¡Socorro, hay un desconocido en mi casa!", "¡Socorro, hay un desconocido en mi casa!" } },
    { "BURG_05", { "I'm not letting you just walk in here and take my stuff without a fight.", "J'vais pas vous laisser entrer chez moi comme ça et me voler ce qui m'appartient sans me battre.", "Ich lass dich doch nicht einfach hier reinlatschen und mir widerstandslos mein Zeug klauen.", "Non ti permetterò di entrare qui dentro e prendere la mia roba senza combattere.", "No voy a dejar que te metas aquí y te lleves mis cosas sin luchar.", "Я НЕ ПОЗВОЛЮ ТЕБЕ ПРОСТО ВОИТИ СЮДА И ЗАБРАТЬ МОИ ВЕШИ БЕЗ БОЯ.", "No voy a dejar que te metas aquí y te lleves mis cosas sin luchar.", "No voy a dejar que te metas aquí y te lleves mis cosas sin luchar." } },
    { "BURG_07", { "Is that the police?... I'm being robbed send someone over here quick!", "Allô, la police_? Il y a un cambrioleur chez moi, envoyez quelqu'un_! Vite_!", "Ist da die Polizei?...Bei mir wird gerade eingebrochen, schicken Sie schnell jemand her!", "Polizia? Sono stato derubato... mandate subito qualcuno!", "¿Es la policía? ¡Me están robando, manden a alguien, deprisa!", "Это полиция?... Меня грабят, быстрее, пришлите сюда кого-нибудь!", "¿Es la policía? ¡Me están robando, manden a alguien, deprisa!", "¿Es la policía? ¡Me están robando, manden a alguien, deprisa!" } },
    { "BURG_08", { "Hey! Don't you know it's wrong to steal?", "Hé_! Vous savez pas que c'est mal de voler_?", "Hey! Weißt du nicht, dass stehlen Unrecht ist?", "Ehi! Non sai che rubare è peccato?", "¡Oiga! ¿No sabe que robar está mal?", "ЗИ! РАЗВЕ ТЫ НЕ ЗНАЕШЬ ЧТО ВОРОВАТЬ НЕ ХОРОШО?", "¡Oiga! ¿No sabe que robar está mal?", "¡Oiga! ¿No sabe que robar está mal?" } },
    { "BURG_09", { "Put that back right now!", "Reposez ça tout de suite_!", "Stell das sofort wieder zurück!", "Rimettilo a posto!", "¡Devuelva eso ahora mismo!", "А НУ ПОЛОЖИ ЭТО НА МЕСТО СЕИЧАС ЖЕ!", "¡Devuelva eso ahora mismo!", "¡Devuelva eso ahora mismo!" } },
    { "BURG_10", { "Get the hell out of my house!", "Fichez le camp de ma maison_!", "Verschwinde aus meinem Haus, verdammt!", "Fuori dalla mia casa!", "¡Salga de mi casa!", "Убирайся к черту из моего дома!", "¡Salga de mi casa!", "¡Salga de mi casa!" } },
    { "BURG_11", { "What do you want, why are you here?", "Qu'est-ce que vous voulez_? Qu'est-ce que vous faites ici_?", "Was wollen Sie? Was machen Sie hier?", "Cosa vuoi? Perché sei qui?", "¿Qué quiere? ¿Qué hace aquí?", "ЧТО ТЕБЕ НУЖНО, ЧТО ТЫ ДЕЛАЕШЬ В МОЕМ ДОМЕ?", "¿Qué quiere? ¿Qué hace aquí?", "¿Qué quiere? ¿Qué hace aquí?" } },
    { "BURG_12", { "Please, just leave us alone", "Je vous en prie, laissez-nous tranquilles.", "Bitte, lassen Sie uns in Ruhe!", "Ti prego, lasciaci stare.", "Por favor, déjenos en paz.", "Оставьте нас в покое.", "Por favor, déjenos en paz.", "Por favor, déjenos en paz." } },
    { "BURG_13", { "Hey where are you going with that?", "Hé, qu'est-ce que vous faites avec ça_?", "Hey, wo wollen Sie damit hin?", "Ehi, dove stai andando con quello?", "Oiga, ¿adónde va con eso?", "Эй, ты куда идешь?", "Oiga, ¿adónde va con eso?", "Oiga, ¿adónde va con eso?" } },
    { "BURG_15", { "Why does this keep happening to me?", "Pourquoi moi_? Pourquoi moi_?", "Warum passiert mir nur immer so was?", "Perché succedono tutte a me?", "¿Por qué me pasa esto siempre a mí?", "И ПОЧЕМУ ЭТО ВСЕГДА СО МНОИ ПРОИСХОДИТ?", "¿Por qué me pasa esto siempre a mí?", "¿Por qué me pasa esto siempre a mí?" } },
    { "BURG_17", { "I'm not taking this!", "Là, je ne marche pas_!", "Das lasse ich mir nicht gefallen!", "Non mi sta proprio bene!", "¡No voy a tolerar esto!", "Я ЭТО НЕ ЗАБИРАЮ!", "¡No voy a tolerar esto!", "¡No voy a tolerar esto!" } },
    { "BURG_18", { "Take it easy!", "Doucement_!", "Immer mit der Ruhe!", "Rilassati!", "¡Con calma!", "Не принимай всерьез!", "¡Con calma!", "¡Con calma!" } },
    { "BURG_20", { "I'm too young to die!", "J'suis trop jeune pour mourir_!", "Ich bin zu jung zum Sterben!", "Sono troppo giovane per morire!", "¡Soy muy joven para morir!", "Я СЛИШКОМ МОЛОД ЧТОБЫ УМИРАТЬ!", "¡Soy muy joven para morir!", "¡Soy muy joven para morir!" } },
    { "BURG_21", { "Who the fuck are you?", "Mais qui êtes-vous, bordel_?", "Verdammt, wer sind Sie?", "Tu chi cazzo sei?", "¿Quién cojones eres?", "КТО ТЫ ЧЕРТ ВОЗЬМИ?", "¿Quién cojones eres?", "¿Quién cojones eres?" } },
    { "PROS_01", { "We need to find somewhere more secluded.", "Il nous faut un endroit plus discret.", "Wir müssen was Abgeschiedeneres finden.", "Dobbiamo trovare un luogo più appartato.", "Tenemos que encontrar un lugar más discreto.", "Нам нужно найти более уединенное место.", "Tenemos que encontrar un lugar más discreto.", "Tenemos que encontrar un lugar más discreto." } },
    { "PROS_02", { "This seems an ok place.", "Ca a l'air pas mal, ici...", "Das sieht mir nach einem guten Plätzchen aus.", "Questo sembra il posto giusto.", "Éste parece un buen sitio.", "Это подходящее место.", "Éste parece un buen sitio.", "Éste parece un buen sitio." } },
    { "PROS_03", { "Nice car", "Sympa, la caisse...", "Schönes Auto.", "Bella macchina...", "Bonito coche.", "ХОРОШАЯ МАШИНА", "Bonito coche.", "Bonito coche." } },
    { "PROS_04", { "You want a good time, honey?", "Tu veux prendre du bon temps, chéri_?", "Willst du Spaß haben, Süßer?", "Vuoi spassartela, tesoro?", "¿Quieres pasar un buen rato, encanto?", "Хочешь хорошо провести время, дорогой?", "¿Quieres pasar un buen rato, encanto?", "¿Quieres pasar un buen rato, encanto?" } },
    { "PROS_05", { "Money first, then we'll party.", "Allonge d'abord, j'm'allonge après.", "Erst die Knete, dann die Fete.", "Prima i soldi, poi il piacere.", "Primero la pasta, luego la diversión.", "Сначала деньги, а потом уже и вечеринка.", "Primero la pasta, luego la diversión.", "Primero la pasta, luego la diversión." } },
    { "PROS_06", { "You've got money right ?", "T'as du fric, j'espère_?", "Du hast doch Geld, oder?", "Hai i soldi, vero?", "Tienes dinero, ¿no?", "У тебя есть деньги, так?", "Tienes dinero, ¿no?", "Tienes dinero, ¿no?" } },
