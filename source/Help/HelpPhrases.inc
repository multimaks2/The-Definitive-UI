    { "DCKCR01", { "~s~Stop the boats carrying drugs from entering the docks.", "~s~Empêche les bateaux transportant de la drogue d'entrer dans les docks.", "~s~Verhindere, dass die Boote, die Drogen an Bord haben, in die Docks einlaufen.", "~s~Ferma le navi che trasportano droga prima che entrino nel porto.", "~s~Impide que las embarcaciones lleven drogas al muelle.", "~s~НЕ ПОВЗОЛЬ ЛОДКАМ, КОТОРЫЕ ВЕЗУТ НАРКОТИКИ, ЗАИТИ В ДОКИ.", "~s~Impide que las embarcaciones lleven drogas al muelle.", "~s~Impide que las embarcaciones lleven drogas al muelle." } },
    { "DCKCR02", { "~s~Use the crane to fling shit at them.", "Utilise la grue pour leur balancer des trucs.", "~s~Benutze den Kran, um sie mit Kram zu bombardieren.", "~s~Usa la gru per ricoprirle di merda.", "~s~Usa la grúa para echarles mierda.", "~s~ИСПОЛЬЗУЙ КРАН, ЧТОБЫ ВЫСЫПАТЬ НА НИХ ДЕРЬМО.", "~s~Usa la grúa para echarles mierda.", "~s~Usa la grúa para echarles mierda." } },
