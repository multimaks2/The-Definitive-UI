    { "DRV6_6", { "~s~The car is almost damaged enough to see into!", "~s~La caisse a morflé. On peut presque voir l'intérieur_!", "~s~Das Auto ist fast so stark beschädigt, dass man hineinsehen kann!", "~s~La macchina è quasi danneggiata abbastanza da poterci vedere dentro!", "~s~¡El coche está tan dañado que casi se ve su interior!", "~s~Машина так повреждена, что будет легко увидеть, кто сидит внутри!", "~s~¡El coche está tan dañado que casi se ve su interior!", "~s~¡El coche está tan dañado que casi se ve su interior!" } },
    { "DRV6_7", { "~r~You blew your cover!", "~r~Tu t'es grillé_!", "~r~Sie haben dich entdeckt!", "~r~Hai fatto saltare la tua copertura!", "~r~¡Te has cargado tu tapadera!", "~r~Твою подставу раскрыли!", "~r~¡Te has cargado tu tapadera!", "~r~¡Te has cargado tu tapadera!" } },
    { "DRV6_11", { "~r~The decoy car was destroyed!", "~r~La caisse-leurre est foutue_!", "~r~Das Lockvogel-Auto wurde zerstört!", "~r~La macchina esca è stata distrutta!", "~r~¡Tu coche señuelo ha sido destruido!", "~r~Машина-приманка уничтожена!", "~r~¡Tu coche señuelo ha sido destruido!", "~r~¡Tu coche señuelo ha sido destruido!" } },
    { "DRV6_15", { "~s~Don't let the bikers see into the damaged car for too long or your cover will be blown.", "~s~Laisse pas les bikers regarder à l'intérieur de la caisse trop longtemps, sinon tu seras grillé_!", "~s~Gönne den Bikern keinen zu langen Blick in das beschädigte Auto, sonst entdecken sie dich.", "~s~Non lasciare che i motociclisti guardino troppo a lungo dentro la macchina altrimenti la tua copertura salterà.", "~s~No dejes que los motoristas vean durante demasiado tiempo el interior del coche dañado, o se descubrirá tu tapadera.", "~s~Не давай байкерам долго смотреть через поврежденные двери, иначе твою подставу могут раскрыть.", "~s~No dejes que los motoristas vean durante demasiado tiempo el interior del coche dañado, o se descubrirá tu tapadera.", "~s~No dejes que los motoristas vean durante demasiado tiempo el interior del coche dañado, o se descubrirá tu tapadera." } },
    { "DRV6_16", { "~s~The bikers can see into the car! Keep them away from the doors.", "~s~Les bikers peuvent voir l'intérieur de la caisse_! Les laisse pas s'approcher des portières_!", "~s~Die Biker können in das Auto hineinsehen! Halt sie von den Türen fern.", "~s~I motociclisti possono vedere dentro la macchina! Tienili lontani dalle portiere.", "~s~¡Los motoristas pueden ver el interior del coche! Mantenlos alejados de las puertas.", "~s~Байкеры могут увидеть, кто сидит внутри машины! Держи их подальше от дверей!", "~s~¡Los motoristas pueden ver el interior del coche! Mantenlos alejados de las puertas.", "~s~¡Los motoristas pueden ver el interior del coche! Mantenlos alejados de las puertas." } },
