    { "VAL_82", { "~S~Other valets will attempt to service waiting cars before you.", "~S~Les autres voituriers essaieront de te chourer les caisses en attente.", "~S~Andere Park-Boys werden versuchen, wartende Autos vor dir abzufertigen.", "~S~Altri parcheggiatori cercheranno di accaparrarsi prima di te le auto in attesa.", "~s~Otros aparcacoches intentarán atender a los coches antes que tú.", "~s~Остальные лакеи попытаются обслужить машину клиента раньше тебя.", "~s~Otros aparcacoches intentarán atender a los coches antes que tú.", "~s~Otros aparcacoches intentarán atender a los coches antes que tú." } },
    { "VAL_83", { "~r~You killed one of the valets.", "~r~T'as buté un voiturier.", "~r~Du hast einen der Park-Boys getötet.", "~r~Hai ucciso uno dei parcheggiatori.", "~r~Has matado a uno de los aparcacoches.", "~r~Ты убил лакея.", "~r~Has matado a uno de los aparcacoches.", "~r~Has matado a uno de los aparcacoches." } },
    { "VAL_84", { "~s~There's a car waiting to be serviced.", "~s~Y a une caisse qui attend d'être garée.", "~s~Ein Auto wartet darauf, abgefertigt zu werden.", "~s~C'è un auto in attesa di essere parcheggiata.", "~s~Hay un coche esperando a que lo atiendan.", "~s~Клиент оставил машину для обслуживания.", "~s~Hay un coche esperando a que lo atiendan.", "~s~Hay un coche esperando a que lo atiendan." } },
    { "VAL_85", { "~s~Service cars within the time limit.", "~s~Occupe-toi des caisses avant la fin du chrono.", "~s~Fertige die Autos innerhalb des Zeitlimits ab.", "~s~Parcheggia le auto entro il limite di tempo.", "~s~Atiende a los coches dentro del límite de tiempo.", "~s~Припаркуй необходимое количество машин за отведенное время.", "~s~Atiende a los coches dentro del límite de tiempo.", "~s~Atiende a los coches dentro del límite de tiempo." } },
    { "VAL_86", { "~s~Each car you park will give a time bonus.", "~s~Pour chaque caisse garée, tu gagnes un bonus de temps.", "~s~Jedes Auto, das du parkst, bringt dir einen Zeitbonus.", "~s~Ogni auto parcheggiata ti frutterà un bonus di tempo.", "~s~Cada coche que aparques te dará una bonificación de tiempo.", "~s~Каждая припаркованная машина дает бонусное время.", "~s~Cada coche que aparques te dará una bonificación de tiempo.", "~s~Cada coche que aparques te dará una bonificación de tiempo." } },
    { "VAL_87", { "~s~Damaging a car will reduce your time bonus.", "~s~Si tu niques une caisse, ton bonus de temps est réduit.", "~s~Beschädigst du ein Auto, verringert sich dein Zeitbonus.", "~s~Danneggiando un'auto, riceverai un bonus di tempo inferiore.", "~s~Al dañar un coche se reducirá tu bonificación de tiempo.", "~s~При повреждении машины бонусное время будет уменьшаться.", "~s~Al dañar un coche se reducirá tu bonificación de tiempo.", "~s~Al dañar un coche se reducirá tu bonificación de tiempo." } },
    { "VAL_91", { "~S~Valet Mission.", "~S~Mission Voiturier.", "~S~Parkservice-Mission.", "~S~Missione Parcheggiatore.", "~s~Misión de aparcacoches.", "~S~Миссия лакея.", "~s~Misión de aparcacoches.", "~s~Misión de aparcacoches." } },
    { "VAL_2", { "You've got the Valet uniform.", "T'as l'uniforme du voiturier.", "Du hast die Parkservice-Uniform.", "Hai l'uniforme da parcheggiatore.", "Has obtenido un uniforme de aparcacoches.", "Ты получил униформу лакея.", "Has obtenido un uniforme de aparcacoches.", "Has obtenido un uniforme de aparcacoches." } },
    { "VAL_3", { "Valet Challenge", "Défi voiturier", "Parkservice-Mission", "Sfida Parcheggio", "Desafío de aparcacoches", "Чемпионат лакеев", "Desafío de aparcacoches", "Desafío de aparcacoches" } },
    { "VAL_5", { "~s~The D.A. is on his way to the ~y~Vank Hoff Hotel~s~ in downtown San Fierro. Get over there now.", "~s~Le procureur est en route pour le ~y~Vank Hoff Hotel~s~, au centre-ville de San Fierro. Vas-y tout de suite.", "~s~Der Staatsanwalt ist unterwegs zum ~y~Vank Hoff Hotel~s~ in Downtown San Fierro. Begib dich sofort dorthin.", "~s~Il pubblico ministero sta andando verso l'~y~Hotel Vank Hoff~s~ nel cuore di San Fierro. Dirigiti laggiù.", "~s~El fiscal se dirige al ~y~Hotel Vank Hoff~s~, en el centro de San Fierro. Dirígete allí.", "~s~Прокурор сейчас на пути к ~y~отелю Ванк Хофф~s~ в центре Сан-Фиерро. Отправляйся туда.", "~s~El fiscal se dirige al ~y~Hotel Vank Hoff~s~, en el centro de San Fierro. Dirígete allí.", "~s~El fiscal se dirige al ~y~Hotel Vank Hoff~s~, en el centro de San Fierro. Dirígete allí." } },
    { "VAL_6", { "This hotel operates a valet service. The D.A. will be dropping his car off here shortly.", "Cet hôtel a un service de voituriers. Le procureur va leur laisser sa caisse dans pas longtemps.", "Dieses Hotel hat einen Parkservice. Der Staatsanwalt wird seinen Wagen in Kürze dort abgeben.", "Questo hotel ha un servizio parcheggiatori. Il pubblico ministero lascerà la sua macchina qui a breve.", "Este hotel tiene un servicio de aparcacoches. El fiscal dejará su coche aquí en breve.", "В отеле действуют услуги лакеев. Прокурор оставит здесь свою машину.", "Este hotel tiene un servicio de aparcacoches. El fiscal dejará su coche aquí en breve.", "Este hotel tiene un servicio de aparcacoches. El fiscal dejará su coche aquí en breve." } },
    { "VAL_7", { "~s~Follow one of the ~r~valets~s~ to the underground car park and waste him. Make sure no one is around.", "~s~Suis un ~r~voiturier~s~ dans le parking souterrain et bute-le. Assure-toi qu'il y ait personne dans le coin.", "~s~Folge einem der ~r~Serviceleute~s~ in die Tiefgarage und schalte ihn aus. Achte darauf, dass niemand in der Nähe ist.", "~s~Segui uno dei ~r~parcheggiatori~s~ al parcheggio sotterraneo e fallo fuori. Assicurati che nessuno ti veda.", "~s~Sigue a uno de los ~r~aparcacoches~s~ al aparcamiento subterráneo y liquídalo. Asegúrate de que no te vea nadie.", "~s~Следуй за ~r~лакеем~s~ на подземную автостоянку и избавься от него. Убедись, что этого никто не увидит.", "~s~Sigue a uno de los ~r~aparcacoches~s~ al aparcamiento subterráneo y liquídalo. Asegúrate de que no te vea nadie.", "~s~Sigue a uno de los ~r~aparcacoches~s~ al aparcamiento subterráneo y liquídalo. Asegúrate de que no te vea nadie." } },
    { "VAL_8", { "~s~Pick up the ~g~valet's uniform~s~", "~s~Prends l'~g~uniforme du voiturier~s~.", "~s~Schnapp dir die ~g~Uniform des Park-Boys~s~.", "~s~Raccogli ~g~l'uniforme da parcheggiatore~s~.", "~s~Recoge el ~g~uniforme del aparcacoches~s~.", "~s~Подбери ~g~униформу лакея~s~.", "~s~Recoge el ~g~uniforme del aparcacoches~s~.", "~s~Recoge el ~g~uniforme del aparcacoches~s~." } },
    { "VAL_9", { "~r~You were spotted wasting the valet.", "~r~T'as été repéré pendant que tu butais le voiturier.", "~r~Du wurdest gesehen, wie du den Park-Boy erledigt hast.", "~r~Sei stato visto mentre uccidevi il parcheggiatore.", "~r~Te han visto cargándote al aparcacoches.", "~r~Тебя заметили при попытке убить лакея.", "~r~Te han visto cargándote al aparcacoches.", "~r~Te han visto cargándote al aparcacoches." } },
    { "VAL_11", { "~s~Get back up top to the valet ~y~carport~s~.", "~s~Remonte jusqu'au ~y~poste des voituriers~s~ devant l'hôtel.", "~s~Begib dich nach oben zum ~y~Carport~s~.", "~s~Torna di sopra, alla ~y~corsia~s~ dei parcheggiatori.", "~s~Vuelve arriba a la ~y~zona~s~ de los aparcacoches.", "~s~Возвращайся к ~y~месту сбора~s~ лакеев.", "~s~Vuelve arriba a la ~y~zona~s~ de los aparcacoches.", "~s~Vuelve arriba a la ~y~zona~s~ de los aparcacoches." } },
    { "VAL_12", { "~s~The D.A. is driving a blue Merit. Remember it, you'll need to identify it correctly when it arrives.", "~s~Le procureur conduit une Merit bleue. Souviens-toi bien_: il faut que tu l'identifies à coup sûr dès qu'il arrive.", "~s~Der Staatsanwalt fährt einen blauen Merit. Merke ihn dir. Du musst ihn erkennen, wenn er ankommt.", "~s~Il pubblico ministero è alla guida di una Merit blu. Ricordati di identificarlo correttamente quando arriverà.", "~s~El fiscal vendrá en un Merit azul. No te olvides: tendrás que identificarlo correctamente cuando llegue.", "~s~Прокурор едет в Меriт'е синего цвета. Запомни это, тебе надо опознать его машину, когда она приедет.", "~s~El fiscal vendrá en un Merit azul. No te olvides: tendrás que identificarlo correctamente cuando llegue.", "~s~El fiscal vendrá en un Merit azul. No te olvides: tendrás que identificarlo correctamente cuando llegue." } },
    { "VAL_13", { "~s~Make sure none of the other valets service his car first.", "~s~Te fais pas chourer la caisse par un autre voiturier.", "~s~Achte darauf, dass kein anderer Park-Boy seinen Wagen übernimmt.", "~s~Assicurati che nessuno degli altri parcheggiatori si occupi della sua macchina.", "~s~Asegúrate de que ningún otro aparcacoches coja su vehículo antes que tú.", "~s~Смотри, чтобы другие лакеи не опередили тебя.", "~s~Asegúrate de que ningún otro aparcacoches coja su vehículo antes que tú.", "~s~Asegúrate de que ningún otro aparcacoches coja su vehículo antes que tú." } },
    { "VAL_14", { "~s~Identify and enter the ~g~D.A.'s car~s~ when it arrives.", "~s~Identifie la ~g~caisse du procureur~s~ quand il arrive et monte dedans.", "~s~Identifiziere den ~g~Wagen des Staatsanwalts~s~, wenn er kommt, und steig ein.", "~s~Identifica e sali sulla ~g~macchina del pubblico ministero~s~ quando sarà arrivato.", "~s~Identifica el ~g~coche del fiscal~s~ cuando llegue y súbete a él.", "~s~Распознай ~g~машину прокурора~s~ и сядь в нее, когда она приедет.", "~s~Identifica el ~g~coche del fiscal~s~ cuando llegue y súbete a él.", "~s~Identifica el ~g~coche del fiscal~s~ cuando llegue y súbete a él." } },
    { "VAL_15", { "~s~You're in the D.A.'s car. Get over to ~y~the Garage~s~ where the drugs will be planted.", "~s~T'es dans la caisse du procureur. Va à ton ~y~garage~s~ pour charger la came dans la caisse.", "~s~Du sitzt im Wagen des Staatsanwalts. Fahr zu der ~y~Garage~s~, wo die Drogen platziert werden.", "~s~Sei nell'auto del pubblico ministero. Dirigiti al tuo ~y~garage~s~ per mettere la partita di droga nell'auto.", "Estás en el coche del fiscal. Vuelve a tu ~y~garaje~s~, donde lo cargarán con drogas.", "~s~Ты в машине прокурора. Езжай в ~y~гараж~s~, где в нее подкинут наркотики.", "Estás en el coche del fiscal. Vuelve a tu ~y~garaje~s~, donde lo cargarán con drogas.", "Estás en el coche del fiscal. Vuelve a tu ~y~garaje~s~, donde lo cargarán con drogas." } },
    { "VAL_20", { "~s~The drugs are planted. Take the car to the valet's ~y~car park~s~.", "~s~La came est dans la caisse. Ramène la voiture au ~y~parking~s~ des voituriers.", "~s~Die Drogen wurden platziert. Fahr den Wagen in die ~y~Garage~s~ des Hotels.", "~s~La partita di droga è stata piazzata. Porta la macchina al ~y~parcheggio~s~ dei parcheggiatori.", "~s~Las drogas están a bordo. Lleva el vehículo al ~y~aparcamiento~s~ de los aparcacoches.", "~s~Наркотики подкинуты. Теперь доставь машину обратно на ~y~стоянку~s~.", "~s~Las drogas están a bordo. Lleva el vehículo al ~y~aparcamiento~s~ de los aparcacoches.", "~s~Las drogas están a bordo. Lleva el vehículo al ~y~aparcamiento~s~ de los aparcacoches." } },
