    { "VAL_48", { "~r~A Valet picked up The D.A.'s Car!", "~r~Un autre voiturier a pris la caisse du procureur_!", "~r~Ein anderer Park-Boy hat den Wagen des Staatsanwalts übernommen!", "~r~Un parcheggiatore è salito sulla macchina del pubblico ministero!", "~r~¡Un aparcacoches ha cogido el coche del fiscal!", "~r~Лакей первый взялся обслуживать машину прокурора!", "~r~¡Un aparcacoches ha cogido el coche del fiscal!", "~r~¡Un aparcacoches ha cogido el coche del fiscal!" } },
