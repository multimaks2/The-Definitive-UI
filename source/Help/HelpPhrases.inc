    { "MAN2_27", { "~s~Enemy jet destroyed. ~1~ still active.", "~s~Avion ennemi détruit. Plus que ~1~.", "~s~Feindlicher Jet zerstört. ~1~ immer noch aktiv.", "~s~Jet nemico abbattuto. Jet rimanenti: ~1~.", "~s~Caza enemigo destruido. Sigue habiendo ~1~.", "~s~Вражеский истребитель уничтожен. Осталось истребителей: ~1~.", "~s~Caza enemigo destruido. Sigue habiendo ~1~.", "~s~Caza enemigo destruido. Sigue habiendo ~1~." } },
