    { "QUAR_08", { "~s~Drive carefully up to the ~y~quarry entrance~s~.", "~s~Conduis prudemment jusqu'à l'~y~entrée de la carrière~s~.", "~s~Fahr vorsichtig zur ~y~Einfahrt des Steinbruchs~s~ hoch.", "~s~Guida con cautela fino all'~y~ingresso della cava~s~.", "~s~Conduce con cuidado hasta la ~y~entrada a la cantera~s~.", "~s~Аккуратно езжай к ~y~главному входу~s~.", "~s~Conduce con cuidado hasta la ~y~entrada a la cantera~s~.", "~s~Conduce con cuidado hasta la ~y~entrada a la cantera~s~." } },
    { "QUAR_09", { "~s~Dump the body and the bike in the ~y~water~s~.", "~s~Balance le cadavre et la moto dans l'~y~eau~s~.", "~s~Kippe die Leiche und das Motorrad ins ~y~Wasser~s~.", "~s~Scarica il corpo e la moto nell'~y~acqua~s~.", "~s~Tira el cadáver y la moto al ~y~agua~s~.", "~s~Сбрось тело и мотоцикл в ~y~воду~s~.", "~s~Tira el cadáver y la moto al ~y~agua~s~.", "~s~Tira el cadáver y la moto al ~y~agua~s~." } },
    { "QUAR_11", { "~s~Use the ~b~bulldozer~s~ to clear the paths before the next delivery arrives.", "~s~Utilise le ~b~bulldozer~s~ pour enlever les traces sur la route avant l'arrivée de la prochaine livraison.", "~s~Räume mit dem ~b~Bulldozer~s~ die Wege frei, bevor die nächste Lieferung kommt.", "~s~Usa il ~b~bulldozer~s~ per sgomberare i percorsi prima dell'arrivo della prossima spedizione.", "~s~Usa el ~b~bulldozer~s~ para despejar los caminos antes de que llegue la siguiente entrega.", "~s~Используй ~b~бульдозер~s~, чтобы расчистить дорогу в карьере.", "~s~Usa el ~b~bulldozer~s~ para despejar los caminos antes de que llegue la siguiente entrega.", "~s~Usa el ~b~bulldozer~s~ para despejar los caminos antes de que llegue la siguiente entrega." } },
    { "QUAR_12", { "~s~Clear a path by pushing the ~g~rocks~s~ over the edge into the markers.", "~s~Nettoie le chemin en poussant les ~g~rochers~s~ pour les faire tomber sur les repères rouges.", "~s~Räum einen Weg frei, indem du die ~g~Steinbrocken~s~ über die Kante in die Markierungen schiebst.", "~s~Sgombera un percorso spostando le ~g~rocce~s~ oltre il bordo, nei segnali.", "~s~Despeja un camino empujando las ~g~rocas~s~ por el borde a los marcadores.", "~s~Очисти путь, сбрасывая ~g~камни~s~ с края дороги вниз.", "~s~Despeja un camino empujando las ~g~rocas~s~ por el borde a los marcadores.", "~s~Despeja un camino empujando las ~g~rocas~s~ por el borde a los marcadores." } },
    { "QUAR_13", { "~s~~1~ rocks cleared. ~1~ to go.", "~s~~1~ rochers écartés. Plus que ~1~.", "~s~~1~ Steine weggeräumt. ~1~ übrig.", "~s~~1~ rocce sgomberate. Ancora ~1~.", "~s~~1~ rocas despejadas. ~1~ más y listo.", "~s~Камней убрано - ~1~. Осталось - ~1~.", "~s~~1~ rocas despejadas. ~1~ más y listo.", "~s~~1~ rocas despejadas. ~1~ más y listo." } },
    { "QUAR_14", { "~s~~1~ rock cleared. ~1~ to go.", "~s~~1~ rocher écarté. Encore ~1~.", "~s~~1~ Stein weggeräumt. ~1~ übrig.", "~s~~1~ roccia sgomberata. Ancora ~1~.", "~s~~1~ roca despejada. ~1~ más y listo.", "~s~Камней убрано - ~1~. Осталось - ~1~.", "~s~~1~ roca despejada. ~1~ más y listo.", "~s~~1~ roca despejada. ~1~ más y listo." } },
    { "QUAR_15", { "~s~Bombs have been planted by a rival organization. Use the ~b~bulldozer~s~ to push the bombs to safe area markers.", "~s~Des bombes ont été posées par une organisation rivale. Sers-toi du ~b~bulldozer~s~ pour mettre les bombes à l'abri dans les repères indiqués.", "~s~Ein Konkurrenzunternehmen hat Bomben gelegt. Schiebe die Bomben mit dem ~b~Bulldozer~s~ in die markierten sicheren Bereiche.", "~s~Sono state posizionate delle bombe da una organizzazione avversaria. Usa il ~b~bulldozer~s~ per spingere le bombe nell'area sicura identificata dai segnali.", "~s~Una organización rival ha puesto bombas. Usa el ~b~bulldozer~s~ para empujarlas a los marcadores de zona segura.", "~s~Конкурирующая организация установила бомбы на территории карьера. Используй ~b~бульдозер~s~, чтобы сдвинуть бомбы в безопасные места.", "~s~Una organización rival ha puesto bombas. Usa el ~b~bulldozer~s~ para empujarlas a los marcadores de zona segura.", "~s~Una organización rival ha puesto bombas. Usa el ~b~bulldozer~s~ para empujarlas a los marcadores de zona segura." } },
    { "QUAR_16", { "~s~The first ~g~bomb~s~ is behind the site office. Push it to ~y~safety~s~.", "~s~La première ~g~bombe~s~ est derrière le bureau de chantier. Va la mettre en ~y~sécurité~s~.", "~s~Die erste ~g~Bombe~s~ liegt hinter dem Büro. Schieb sie in einen ~y~sicheren Bereich~s~.", "~s~La prima ~g~bomba~s~ è dietro l'ufficio. Spingila verso l'~y~area sicura~s~.", "~s~La primera ~g~bomba~s~ está detrás de la oficina de la explotación. Empújala a la zona ~y~segura~s~.", "~s~Первая ~g~бомба~s~ установлена за офисом. Передвинь ее в ~y~безопасное место~s~.", "~s~La primera ~g~bomba~s~ está detrás de la oficina de la explotación. Empújala a la zona ~y~segura~s~.", "~s~La primera ~g~bomba~s~ está detrás de la oficina de la explotación. Empújala a la zona ~y~segura~s~." } },
    { "QUAR_17", { "~s~There's a ~g~bomb~s~ beside the crane. Make it ~y~safe~s~.", "~s~Il y a une ~g~bombe~s~ derrière la grue. Mets-la en ~y~lieu sûr~s~_!", "~s~Eine ~g~Bombe~s~ liegt neben dem Kran. Bring sie in den ~y~sicheren Bereich~s~.", "~s~C'è una ~g~bomba~s~ vicino alla gru. Portala nell'~y~area sicura~s~.", "~s~Hay una ~g~bomba~s~ detrás de la grúa. Ponla en la zona ~y~segura~s~.", "~s~Еще одна ~g~бомба~s~ установлена возле подъемного крана. Передвинь ее в ~y~безопасное место~s~.", "~s~Hay una ~g~bomba~s~ detrás de la grúa. Ponla en la zona ~y~segura~s~.", "~s~Hay una ~g~bomba~s~ detrás de la grúa. Ponla en la zona ~y~segura~s~." } },
    { "QUAR_18", { "~s~The next ~g~bomb~s~ is at the grinder. Push it to the ~y~safe area~s~.", "~s~La prochaine ~g~bombe~s~ est près du broyeur. Mets-la à l'~y~abri~s~_!", "~s~Die nächste ~g~Bombe~s~ befindet sich bei der Brechanlage. Schieb sie in einen ~y~sicheren Bereich~s~.", "~s~La prossima ~g~bomba~s~ è presso il frantumatore. Spingila verso l'~y~area sicura~s~.", "~s~La siguiente ~g~bomba~s~ está en la trituradora. Empújala a la ~y~zona segura~s~.", "~s~Следующая ~g~бомба~s~ находится возле очистного сооружения. Передвинь ее ~y~подальше от этого объекта~s~.", "~s~La siguiente ~g~bomba~s~ está en la trituradora. Empújala a la ~y~zona segura~s~.", "~s~La siguiente ~g~bomba~s~ está en la trituradora. Empújala a la ~y~zona segura~s~." } },
    { "QUAR_19", { "~s~The last ~g~bomb~s~ is between the crushers. Move out of the blast radius when you've made it ~y~safe~s~.", "~s~La dernière ~g~bombe~s~ est entre les concasseurs. Tire-toi du rayon d'action une fois que tu l'auras mise en ~y~sécurité~s~_!", "~s~Die letzte ~g~Bombe~s~ liegt zwischen den Quetschanlagen. Begib dich aus dem Explosionsradius, wenn du sie in den ~y~sicheren Bereich~s~ gebracht hast.", "~s~L'ultima ~g~bomba~s~ è tra i frantumatori. Allontanati dall'area di esplosione quando l'avrai spinta nell'~y~area sicura~s~.", "~s~La última ~g~bomba~s~ está entre las trituradoras. Sal fuera del radio de la explosión cuando la hayas llevado a la zona ~y~segura~s~.", "~s~Последняя ~g~бомба~s~ находится между сооружениями для обработки руды. Передвинь ее в ~y~безопасное место~s~ и покинь зону действия взрывной волны.", "~s~La última ~g~bomba~s~ está entre las trituradoras. Sal fuera del radio de la explosión cuando la hayas llevado a la zona ~y~segura~s~.", "~s~La última ~g~bomba~s~ está entre las trituradoras. Sal fuera del radio de la explosión cuando la hayas llevado a la zona ~y~segura~s~." } },
    { "QUAR_20", { "~s~Move out of the bomb's blast radius.", "~s~Tire-toi du rayon d'action de la bombe.", "~s~Begib dich aus dem Explosionsradius der Bombe.", "~s~Allontanati dall'area di esplosione della bomba.", "~s~Sal del radio de explosión de la bomba.", "~s~Убирайся подальше от зоны действия взрывной волны.", "~s~Sal del radio de explosión de la bomba.", "~s~Sal del radio de explosión de la bomba." } },
    { "QUAR_21", { "~s~Move the ~g~bomb~s~ to the alternative ~y~safe area~s~.", "~s~Mets la ~g~bombe~s~ dans l'autre ~y~zone sûre~s~.", "~s~Schaff die ~g~Bombe~s~ in den anderen ~y~sicheren Bereich~s~.", "~s~Sposta la ~g~bomba~s~ nell'~y~area sicura~s~ alternativa.", "~s~Lleva la ~g~bomba~s~ a la ~y~zona segura~s~ alternativa.", "~s~Передвинь ~g~бомбу~s~ в другое ~y~безопасное место~s~.", "~s~Lleva la ~g~bomba~s~ a la ~y~zona segura~s~ alternativa.", "~s~Lleva la ~g~bomba~s~ a la ~y~zona segura~s~ alternativa." } },
    { "QUAR_22", { "~s~The bombers have been caught. Their bodies are loaded on a ~b~dumper~s~ at the quarry's ~y~other entrance~s~. Dump them before the cops come snooping.", "~s~Les maniaques de la bombe se sont fait buter. Leurs cadavres sont chargés sur un ~b~dumper~s~ à l'~y~autre entrée~s~ de la carrière. Débarrasse-t'en avant que les flics débarquent.", "~s~Die Bombenleger wurden geschnappt. Ihre Leichen liegen auf einem ~b~Kipper~s~ bei der ~y~anderen Einfahrt des Steinbruchs~s~. Schaff sie weg, bevor die Cops kommen und hier herumschnüffeln.", "~s~I dinamitardi sono stati catturati. I loro corpi sono stati caricati nell'~b~autoribaltabile~s~ presso l'~y~altro ingresso~s~ della cava. Scaricali lontano prima che arrivino i poliziotti.", "~s~Han pillado a los que ponían las bombas. Sus cadáveres están metidos en un ~b~volquete~s~ en la ~y~otra entrada~s~ de la cantera. Deshazte de ellos antes de que la poli venga a husmear.", "~s~Тела членов вражеской организации погружены в кузов ~b~самосвала~s~ у ~y~второго входа~s~ в карьер. Избавься от этих тел, пока не прибыли копы.", "~s~Han pillado a los que ponían las bombas. Sus cadáveres están metidos en un ~b~volquete~s~ en la ~y~otra entrada~s~ de la cantera. Deshazte de ellos antes de que la poli venga a husmear.", "~s~Han pillado a los que ponían las bombas. Sus cadáveres están metidos en un ~b~volquete~s~ en la ~y~otra entrada~s~ de la cantera. Deshazte de ellos antes de que la poli venga a husmear." } },
    { "QUAR_23", { "~s~Take the bodies to the quarry ~y~main entrance~s~.", "~s~Emmène les cadavres jusqu'à l'~y~entrée principale~s~ de la carrière.", "~s~Schaff die Leichen zum ~y~Haupteingang~s~ des Steinbruchs.", "~s~Porta i corpi all'~y~ingresso principale~s~ della cava.", "~s~Lleva los cadáveres a la ~y~entrada principal~s~ de la cantera.", "~s~Отвези тела до ~y~главного входа~s~ в карьер.", "~s~Lleva los cadáveres a la ~y~entrada principal~s~ de la cantera.", "~s~Lleva los cadáveres a la ~y~entrada principal~s~ de la cantera." } },
    { "QUAR_24", { "~s~Follow the tracks down to the quarry floor and burn the bodies in the ~y~fire~s~.", "~s~Suis la piste jusqu'au fond de la carrière et fais ~y~cramer~s~ les cadavres.", "~s~Folge dem Weg in den Steinbruch hinunter und verbrenne die Leichen im ~y~Feuer~s~.", "~s~Segui la strada fino al fondo della cava e brucia i corpi nel ~y~fuoco~s~.", "~s~Sigue el camino hasta la cantera y quema los cadáveres en el ~y~fuego~s~.", "~s~Спустись на самый низ карьера и сбрось тела в ~y~костер~s~.", "~s~Sigue el camino hasta la cantera y quema los cadáveres en el ~y~fuego~s~.", "~s~Sigue el camino hasta la cantera y quema los cadáveres en el ~y~fuego~s~." } },
    { "QUAR_25", { "~s~The ~b~dumper~s~ is loaded with explosives and needs to be driven gently. Deliver the explosives to the ~y~desert airstrip~s~ then return to the Quarry.", "~s~Le ~b~dumper~s~ est chargé d'explosifs et doit être conduit prudemment. Livre les explosifs à la ~y~piste du désert~s~ et retourne à la carrière.", "~s~Der ~b~Kipper~s~ ist mit Sprengstoff beladen und muss sachte gefahren werden. Liefere den Sprengstoff an den ~y~Flugplatz in der Wüste~s~ und kehre dann zum Steinbruch zurück.", "~s~L'~b~autoribaltabile~s~ è carico di esplosivo e deve essere guidato con cautela. Consegna gli esplosivi alla ~y~pista d'atterraggio nel deserto~s~ e poi ritorna alla cava.", "~s~El ~b~volquete~s~ está cargado con explosivos y hay que conducirlo con cuidado. Lleva los explosivos a la ~y~pista de aterrizaje del desierto~s~ y luego vuelve a la cantera.", "~s~В кузов ~b~самосвала~s~ загружены бочки со взрывчаткой, поэтому вести машину нужно аккуратно. Отвези бочки на ~y~аэродром в пустыне~s~ и возвращайся в карьер.", "~s~El ~b~volquete~s~ está cargado con explosivos y hay que conducirlo con cuidado. Lleva los explosivos a la ~y~pista de aterrizaje del desierto~s~ y luego vuelve a la cantera.", "~s~El ~b~volquete~s~ está cargado con explosivos y hay que conducirlo con cuidado. Lleva los explosivos a la ~y~pista de aterrizaje del desierto~s~ y luego vuelve a la cantera." } },
    { "QUAR_26", { "~s~Drop the barrels. The soft sand will prevent an explosion.", "~s~Largue les barils. Le sable mou les empêchera d'exploser.", "~s~Wirf die Fässer ab. Durch den weichen Sand werden sie nicht explodieren.", "~s~Scarica i barili. La sabbia attutirà il colpo e impedirà l'esplosione.", "~s~Suelta los bidones. La blanda arena impedirá la explosión.", "~s~Сбрось бочки. Мягкий песок не даст им взорваться.", "~s~Suelta los bidones. La blanda arena impedirá la explosión.", "~s~Suelta los bidones. La blanda arena impedirá la explosión." } },
    { "QUAR_27", { "~s~Return to the ~y~Quarry~s~.", "~s~Retourne à la ~y~carrière~s~.", "~s~Kehre zurück zum ~y~Steinbruch~s~.", "~s~Ritorna alla ~y~cava~s~.", "~s~Vuelve a la ~y~cantera~s~.", "~s~Возвращайся в ~y~карьер~s~.", "~s~Vuelve a la ~y~cantera~s~.", "~s~Vuelve a la ~y~cantera~s~." } },
    { "QUAR_28", { "~s~A dumper has spilled it's load of explosives all along the train tracks. Use the ~b~bulldozer~s~ to clear them before the next train passes.", "~s~Un dumper a déchargé sa cargaison d'explosifs le long de la voie ferrée. Utilise le ~b~bulldozer~s~ pour les virer avant le passage du prochain train.", "~s~Ein Kipper hat überall entlang der Strecke Sprengstoff verloren. Räume ihn mit dem ~b~Bulldozer~s~ weg, bevor der nächste Zug durchkommt.", "~s~Un autoribaltabile ha perso il suo carico di esplosivi lungo i binari del treno. Usa il ~b~bulldozer~s~ per rimuoverli prima del passaggio del prossimo convoglio.", "~s~A un volquete se le ha caído la carga de explosivos sobre las vías del tren. Usa el ~b~bulldozer~s~ para quitarlos antes de que pase el siguiente tren.", "~s~Из кузова самосвала повыпадали бочки со взрывчаткой вдоль железнодорожного полотна. Используй ~b~бульдозер~s~, чтобы очистить полотно до прибытия поезда.", "~s~A un volquete se le ha caído la carga de explosivos sobre las vías del tren. Usa el ~b~bulldozer~s~ para quitarlos antes de que pase el siguiente tren.", "~s~A un volquete se le ha caído la carga de explosivos sobre las vías del tren. Usa el ~b~bulldozer~s~ para quitarlos antes de que pase el siguiente tren." } },
    { "QUAR_29", { "~s~The ~b~train~s~ is approaching.", "~s~Le ~b~train~s~ approche.", "~s~Der ~b~Zug~s~ nähert sich.", "~s~Il ~b~treno~s~ è in arrivo.", "~s~El ~b~tren~s~ se aproxima.", "~s~~b~Поезд~s~ приближается.", "~s~El ~b~tren~s~ se aproxima.", "~s~El ~b~tren~s~ se aproxima." } },
    { "QUAR_30", { "~s~Thieves have stolen equipment and are escaping in a ~r~dumper~s~. Use this ~b~dumper~s~ to destroy it.", "~s~Des voleurs ont chouré l'équipement et s'enfuient à bord d'un ~r~dumper~s~. Utilise ce ~b~dumper~s~ pour le bousiller.", "~s~Diebe haben Geräte gestohlen und fliehen in einem ~r~Kipper~s~. Zerstöre ihn mit diesem ~b~Kipper~s~.", "~s~Dei ladri hanno rubato dell'equipaggiamento e stanno scappando con un ~r~autoribaltabile~s~. Usa questo ~b~autoribaltabile~s~ per distruggerlo.", "~s~Los ladrones han robado equipamiento y se escapan en un ~r~volquete~s~. Usa este ~b~volquete~s~ para destruirlo.", "~s~ВОРЫ УКРАЛИ СНАРЯДЕНИЕ И ТЫ УЕЗЖАЕШЬ НА ~r~ГРУЗОВИКЕ~s~. ИСПОЛЬЗУЙ ~b~ГРУЗОВИК~s~ ЧТОБЫ УНИЧТОЖИТЬ ЕГО.", "~s~Los ladrones han robado equipamiento y se escapan en un ~r~volquete~s~. Usa este ~b~volquete~s~ para destruirlo.", "~s~Los ladrones han robado equipamiento y se escapan en un ~r~volquete~s~. Usa este ~b~volquete~s~ para destruirlo." } },
