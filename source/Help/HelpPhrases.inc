    { "CA3_1", { "~s~Head towards the ~y~factory unit~s~ on the outskirts of town. You're going to disturb their operation.", "~s~Dirige-toi vers l'~y~usine~s~ à la périphérie de la ville. Tu vas foutre la merde dans leur bizness.", "~s~Begib dich zu der ~y~Fabrik~s~ am Stadtrand. Du musst ihnen einen Strich durch die Rechnung machen.", "~s~Vai verso la ~y~zona industriale~s~ alla periferia della città. Dovrai disturbare le loro operazioni.", "~s~Dirígete hacia la ~y~fábrica~s~ en las afueras de la ciudad. Vas a interrumpir su funcionamiento.", "~s~Отправляйся на ~y~завод~s~ на окраине города. Ты должен прекратить его деятельность.", "~s~Dirígete hacia la ~y~fábrica~s~ en las afueras de la ciudad. Vas a interrumpir su funcionamiento.", "~s~Dirígete hacia la ~y~fábrica~s~ en las afueras de la ciudad. Vas a interrumpir su funcionamiento." } },
    { "CA3_2", { "~s~Those mobsters have some guards watching the main goods entrance. Try and get into the ~y~factory~s~ unnoticed.", "~s~Ces enfoirés ont posté des gardes pour surveiller l'entrée principale des marchandises. Essaie de rentrer dans l'~y~usine~s~ sans te faire choper.", "~s~Die Mafiosi haben einige Wachen, die die Liefereinfahrt bewachen. Versuche, unbemerkt in die ~y~Fabrik~s~ zu gelangen.", "~s~Questi criminali hanno delle sentinelle di guardia all'ingresso principale. Cerca di entrare nella ~y~fabbrica~s~ senza farti notare.", "~s~Esos gánsteres tienen unos guardias vigilando la entrada principal de mercancías. Intenta entrar en la ~y~fábrica~s~ sin que te vean.", "~s~Эти бандиты поставили часовых, которые следят за главным входом. Попытайся проникнуть на ~y~завод~s~ незамеченным.", "~s~Esos gánsteres tienen unos guardias vigilando la entrada principal de mercancías. Intenta entrar en la ~y~fábrica~s~ sin que te vean.", "~s~Esos gánsteres tienen unos guardias vigilando la entrada principal de mercancías. Intenta entrar en la ~y~fábrica~s~ sin que te vean." } },
    { "CA3_7", { "~s~Destroy every one of those injection molding ~g~machines~s~ now!", "~s~Détruis toutes ces ~g~machines~s~ à moulage_!", "~s~Zerstöre jetzt alle ~g~Druckguss-Maschinen~s~!", "~s~Ora distruggi ogni ~g~macchinario~s~ per gli stampi!", "¡~s~Ahora, destruye todas esas ~g~máquinas~s~ moldeadoras!", "~s~Уничтожь все ~g~станки~s~ для производства фишек!", "¡~s~Ahora, destruye todas esas ~g~máquinas~s~ moldeadoras!", "¡~s~Ahora, destruye todas esas ~g~máquinas~s~ moldeadoras!" } },
    { "CA3_12", { "~s~Excellent! Those machines are outta commission!", "~s~Excellent_! Ces machines fabriqueront plus rien_!", "~s~Ausgezeichnet! Die Maschinen sind außer Betrieb!", "~s~Ottimo! Quei macchinari sono fuori uso!", "~s~¡Excelente! ¡Las máquinas están fuera de servicio!", "~s~ОТЛИНО! ЗТИ СТАНКИ ТЕПЕРЬ НЕ РАБОТАЮТ!", "~s~¡Excelente! ¡Las máquinas están fuera de servicio!", "~s~¡Excelente! ¡Las máquinas están fuera de servicio!" } },
    { "CA3_13", { "~s~I don't know who that guy thinks he is but his card is gonna get marked if he sees too much!", "~s~Je sais pas pour qui il se prend, ce mec, mais il va avoir des emmerdes s'il en voit trop_!", "~s~Ich weiß nicht, für wen der Kerl sich hält, aber man wird auf ihn aufmerksam werden, wenn er zu viel sieht!", "~s~Non so chi si creda di essere quel tipo, ma se vede troppe cose finirà segnato!", "~s~¡No sé quién se cree que es ese tipo, pero habrá que ficharlo si ve demasiado!", "~s~Я НЕ ЗНАЮ ЧТО ДУМАЕТ ЗТОТ ПАРЕНЬ НО ЕГО КАРТА ТОЧНО ПОМЕТИТСЯ ЕСЛИ ОН УВИДИТ БОЛЬШЕ ЧЕМ ДОЛЖЕН!", "~s~¡No sé quién se cree que es ese tipo, pero habrá que ficharlo si ve demasiado!", "~s~¡No sé quién se cree que es ese tipo, pero habrá que ficharlo si ve demasiado!" } },
    { "CA3_17", { "~w~Stay away! I'll make ya eat your fucking shoes!", "~w~Approche pas_! J'vais t'faire bouffer tes putains d'pompes_!", "~w~Bleib weg! Ich geb dir deine eigenen Scheißschuhe zu fressen!", "~w~Stai lontano! Ti farò mangiare le tue fottute scarpe!", "~w~¡Atrás! ¡O haré que te comas tus jodidos zapatos!", "~w~А НУ ПРОЧЬ! Я ЗАСТАВЛЮ ТЕБЯ ЕСТЬ ТВОИ СОБСТВЕНЫЕ ТУФЛИ!", "~w~¡Atrás! ¡O haré que te comas tus jodidos zapatos!", "~w~¡Atrás! ¡O haré que te comas tus jodidos zapatos!" } },
    { "CA3_20", { "~r~What the fuck? I said no rough stuff! The mafia are gonna be on red alert now! Dumbass!", "~r~C'est quoi ce bordel_? J'ai dit pas d'embrouilles_! La Mafia va être sur les dents, maintenant_! Connard_!", "~r~Was soll der Scheiß? Ich sagte, keine Gewalt! Jetzt herrscht bei der Mafia Alarmstufe rot! Dämlicher Arsch!", "~r~Che cazzo succede? Ho detto di non fare casino! La mafia sarà in allarme rosso adesso! Testa di cazzo!", "~r~¿Qué diablos? ¡He dicho que sin violencia! ¡Ahora la Mafia va a ponerse en alerta roja! ¡Botarate!", "~r~Какого хрена? Теперь мафия подняла тревогу! Недоумок!", "~r~¿Qué diablos? ¡He dicho que sin violencia! ¡Ahora la Mafia va a ponerse en alerta roja! ¡Botarate!", "~r~¿Qué diablos? ¡He dicho que sin violencia! ¡Ahora la Mafia va a ponerse en alerta roja! ¡Botarate!" } },
    { "CA3_22", { "~s~Heads up! It's the minimum wage crew! Get safely away from the factory to complete the job!", "~s~Fais gaffe_! V'là les smicards_! Sors sain et sauf de l'usine pour finir ton job_!", "~s~Vorsicht! Das sind die Mindestlohn-Arbeiter! Sieh zu, dass du heil von der Fabrik wegkommst, um den Job abzuschließen!", "~s~All'erta! Sono gli operai di bassa forza! Allontanati dalla fabbrica per completare la missione!", "~s~¡Atención! ¡Son los curritos! ¡Aléjate de la fábrica para terminar el trabajo!", "~s~ГОЛОВУ ВВЕРХ! ЭТО КОМАНДА МИНИМАЛЬНОИ СТАВКИ! БЕЗОПАСНО УИДИТЕ С ФАБРИКИ ЧТОБЫ ЗАВЕРШИТЬ РАБОТУ!", "~s~¡Atención! ¡Son los curritos! ¡Aléjate de la fábrica para terminar el trabajo!", "~s~¡Atención! ¡Son los curritos! ¡Aléjate de la fábrica para terminar el trabajo!" } },
    { "CA3_23", { "~s~Great work, the job's done! Get back to ~y~Woozie's casino~s~ in one piece!", "~s~Bien joué, le boulot est fait_! Retourne au ~y~casino de Woozie~s~ en un seul morceau_!", "~s~Sehr gute Arbeit, der Job ist erledigt! Sieh zu, dass du heil zu ~y~Woozies Casino~s~ kommst!", "~s~Ben fatto, bel lavoro! Ora torna al ~y~casino di Woozie~s~ intero!", "~s~¡Genial, buen trabajo! ¡Vuelve al ~y~casino de Woozie~s~ de una pieza!", "~s~Хорошая работа! Возвращайся в ~y~казино~s~, берегись западни!", "~s~¡Genial, buen trabajo! ¡Vuelve al ~y~casino de Woozie~s~ de una pieza!", "~s~¡Genial, buen trabajo! ¡Vuelve al ~y~casino de Woozie~s~ de una pieza!" } },
    { "CAS4_17", { "That ain't right man, I'll never look at a rasher of back bacon the same way again", "C'est trop bizarre, mec. Je regarderai plus jamais une tranche de bacon de la même façon, maintenant.", "Das ist nicht okay, Mann. In Zukunft werde ich Hinterschinken mit völlig anderen Augen sehen.", "C'è qualcosa che non va. Non guarderò mai più una fetta di pancetta come una volta...", "Vaya ful, tío, ya no volveré a mirar igual una loncha de beicon...", "ЗТО НЕПРАВИЛЬНО, ЧУВАК, Я БОЛЬШЕ НИКОГДА НЕ ПОСМОТРЮ НА ЖАРЕННЫХ БЕКОН НОРМАЛЬНО", "Vaya ful, tío, ya no volveré a mirar igual una loncha de beicon...", "Vaya ful, tío, ya no volveré a mirar igual una loncha de beicon..." } },
    { "CAS4_18", { "I think I remember... hold on a mo, weren't you the one holding the video camera!", "Je crois que je me souviens... attends un peu, c'est pas toi qui tenais la caméra vidéo_?", "Ich glaube, ich erinnere mich... Moment mal, hattest du nicht die Videokamera in der Hand?", "Credo di ricordare... aspetta un attimo, non eri tu quello che aveva la telecamera?", "Creo que recuerdo... ¡Espera, ya sé, tú eras el de la videocámara!", "КАЖЕТСЯ Я ПОМНЮ... ПОГОДИ СЕКУНДУ, РАЗВЕ ЭТО НЕ ТЫ ДЕРЖАД ВИДЕОКАМЕРУ!", "Creo que recuerdo... ¡Espera, ya sé, tú eras el de la videocámara!", "Creo que recuerdo... ¡Espera, ya sé, tú eras el de la videocámara!" } },
    { "CAS4_26", { "I think I broke a nail", "Je crois que je me suis cassé un ongle.", "Ich glaub, ich hab mir 'nen Nagel abgebrochen", "Credo di essermi spezzato un'unghia...", "Creo que me he roto una uña.", "КАЖЕТСЯ Я СЛОМАЛА НОГОТЬ", "Creo que me he roto una uña.", "Creo que me he roto una uña." } },
    { "CAS4_27", { "I'm too pretty to fight", "Je suis trop beau pour me battre.", "Ich bin zu hübsch, um zu kämpfen", "Sono troppo carino per combattere...", "Soy demasiado guapo para luchar.", "Я СЛИШКОМ КРАСИВАЯ ЧТОБЫ ДРАТЬСЯ", "Soy demasiado guapo para luchar.", "Soy demasiado guapo para luchar." } },
    { "CAS4_29", { "What's that smell?", "C'est quoi, cette odeur_?", "Was riecht denn hier so?", "Cos'è questo odore?", "¿Qué es ese olor?", "ЧТО ЭТО ЗА ЗАПАХ?", "¿Qué es ese olor?", "¿Qué es ese olor?" } },
    { "CAS4_30", { "Oh wait a minute it's me.", "Oh, attends... c'est moi.", "Oh, Moment, das bin ja ich.", "Oh, aspetta un minuto, sono io!", "Eh, espera, si soy yo.", "ЗИ ПОГОДИ МИНУТУ ЭТО Я.", "Eh, espera, si soy yo.", "Eh, espera, si soy yo." } },
    { "CAS4_45", { "I ain't getting in no damn bus, go find us a proper ride!", "Je refuse de monter dans un putain de bus, trouve-moi quelque chose de mieux_!", "Ich steig in keinen verdammten Bus ein. Such uns ein angemessenes Gefährt!", "Non salirò su nessun dannato autobus, vai a cercare un mezzo appropriato!", "No voy a subirme a un maldito autobús, ¡consigue un vehículo en condiciones!", "Я НЕ ПОЛЕЗУ В ЗТОТ ГРЕБАННЫИ АВТОБУС ПОИДИ ПОИШИ НОРМАЛЬНУЮ ТАЧКУ!", "No voy a subirme a un maldito autobús, ¡consigue un vehículo en condiciones!", "No voy a subirme a un maldito autobús, ¡consigue un vehículo en condiciones!" } },
