    { "CRA1_32", { "~s~Good shot! A few more like that should do it.", "~s~Bien joué_! Encore quelques-uns et ça devrait aller.", "~s~Guter Wurf! Ein paar mehr davon sollten reichen.", "~s~Bel colpo! Ancora un paio e dovresti farcela.", "¡~s~Buen disparo! Con unos pocos más así será suficiente.", "~s~Отличное попадание! Осталось еще несколько окон.", "¡~s~Buen disparo! Con unos pocos más así será suficiente.", "¡~s~Buen disparo! Con unos pocos más así será suficiente." } },
