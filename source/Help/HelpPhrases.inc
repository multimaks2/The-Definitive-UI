    { "CM2_16", { "~s~Attack enemy gang members to start the territory take over!", "~s~Attaque les membres du gang ennemi pour essayer de choper leur territoire_!", "~s~Greife feindliche Gangmitglieder an, um die Übernahme des Gebiets einzuleiten!", "~s~Attacca i membri delle gang nemiche per cominciare a prendere il controllo del territorio!", "~s~¡Ataca a los miembros de la banda enemiga para iniciar la conquista del territorio!", "~s~Напади на членов вражеской банды, чтобы начать захват территории!", "~s~¡Ataca a los miembros de la banda enemiga para iniciar la conquista del territorio!", "~s~¡Ataca a los miembros de la banda enemiga para iniciar la conquista del territorio!" } },
