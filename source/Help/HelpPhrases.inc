    { "VCR1__2", { "~s~You were too slow. One of the guards has grabbed the stuff.", "~s~T'as été trop lent. Un des gardes a pris ce qu'on voulait.", "~s~Du warst zu langsam. Einer der Wachmänner hat sich das Zeug geschnappt.", "~s~Sei stato troppo lento. Una delle guardie ha preso la roba.", "~s~Has sido demasiado lento. Uno de los guardias ha cogido el dossier.", "~s~ТЫ СЛИШКОМ МЕДЛЕННО. ОДИН ИЗ ОХРАННИКОВ УЖЕ СХВАТИЛ ВСЕ.", "~s~Has sido demasiado lento. Uno de los guardias ha cogido el dossier.", "~s~Has sido demasiado lento. Uno de los guardias ha cogido el dossier." } },
