    { "DE10_01", { "~s~Fly the jet pack to the ~g~train~s~, and steal whatever they least want you to get.", "~s~Va en jetpack jusqu'au ~g~train~s~ et vole-leur ce qu'ils veulent surtout pas qu'on leur pique.", "~s~Flieg das Jet Pack zum ~g~Zug~s~ und stehle das, was sie hüten wie ihren Augapfel.", "~s~Vola col jet pack fino al ~g~treno~s~ e ruba ciò che è loro più caro.", "~s~Vuela con la mochila propulsora hasta el ~g~tren~s~ y roba lo que estén protegiendo.", "~s~Отправляйся на джетпаке к ~g~поезду~s~ и забери то, что они меньше всего хотели бы тебе отдать.", "~s~Vuela con la mochila propulsora hasta el ~g~tren~s~ y roba lo que estén protegiendo.", "~s~Vuela con la mochila propulsora hasta el ~g~tren~s~ y roba lo que estén protegiendo." } },
    { "DE10_02", { "~s~That's the right one! Grab the ~g~jar of green goo.", "~s~C'est la bonne caisse_! Prends le ~g~bocal de gelée verte~s~.", "~s~Das ist die richtige! Schnapp dir ~g~den Behälter mit dem grünen Glibber~s~.", "~s~Ci siamo! Prendi la poltiglia verde.", "¡Lo has encontrado! Coge el ~g~frasco de cieno verde~s~.", "~s~Это то, что тебе нужно! Подбери ~g~сосуд с зеленой вязкостью~s~.", "¡Lo has encontrado! Coge el ~g~frasco de cieno verde~s~.", "¡Lo has encontrado! Coge el ~g~frasco de cieno verde~s~." } },
    { "DE10_03", { "~s~The ~g~crate~s~ is empty, try another.", "~s~La ~g~caisse~s~ est vide, essaies-en une autre.", "~s~Die ~g~Kiste~s~ ist leer. Versuch's mit einer anderen.", "~s~La ~g~cassa~s~ è vuota, provane un'altra.", "~s~La ~g~caja~s~ está vacía, prueba con otra.", "~s~Этот ~g~ящик~s~ пуст, попробуй другой.", "~s~La ~g~caja~s~ está vacía, prueba con otra.", "~s~La ~g~caja~s~ está vacía, prueba con otra." } },
    { "DE10_04", { "~s~You have the jar of green goo. Take it to ~y~The Truth.", "~s~T'as récupéré le bocal de gelée verte, apporte-le à ~y~Truth~s~.", "~s~Du hast den Behälter mit dem grünen Glibber. Bring ihn zu ~y~The Truth~s~.", "~s~Hai preso la poltiglia verde. Portala a ~y~Truth.", "~s~Tienes el frasco de cieno verde. Llévaselo a ~y~Truth~s~.", "~s~Отнеси сосуд с зеленой вязкостью ~y~Праведнику.", "~s~Tienes el frasco de cieno verde. Llévaselo a ~y~Truth~s~.", "~s~Tienes el frasco de cieno verde. Llévaselo a ~y~Truth~s~." } },
    { "DE10_05", { "~r~You failed to get the green goo in time.", "~r~T'as pas réussi à piquer la gelée verte à temps.", "~r~Du hast den grünen Glibber nicht rechtzeitig in deinen Besitz gebracht.", "~r~Non sei riuscito a recuperare la poltiglia verde in tempo.", "~r~No has logrado hacerte con el cieno verde a tiempo.", "~r~ТЕБЕ НЕ УДАЛОСЬ ДОСТАВИТЬ ЗЕЛЕНУЮ ГАДОСТЬ ВОВРЕМЯ.", "~r~No has logrado hacerte con el cieno verde a tiempo.", "~r~No has logrado hacerte con el cieno verde a tiempo." } },
    { "DE10_06", { "~s~Shoot the ~g~crates~s~ on the train to find the jar of green goo.", "~s~Tire sur les ~g~caisses~s~ du train pour trouver le bocal de gelée verte.", "~s~Zerschieße die ~g~Kisten~s~, um den Behälter mit dem grünen Glibber zu finden.", "~s~Spara alle ~g~casse~s~ sul treno per trovare il contenitore della poltiglia verde.", "~s~Dispara a las ~g~cajas~s~ del tren y encuentra el frasco de cieno verde.", "~s~Разбей в ~g~ящики~s~, чтобы найти сосуд с зеленой вязкостью.", "~s~Dispara a las ~g~cajas~s~ del tren y encuentra el frasco de cieno verde.", "~s~Dispara a las ~g~cajas~s~ del tren y encuentra el frasco de cieno verde." } },
