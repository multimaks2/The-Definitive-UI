    { "DOC2_11", { "~s~Go back and rescue ~b~Madd Dogg~s~!", "~s~Faut que tu retournes sauver ~b~Madd Dogg~s~_!", "~s~Du musst zurück, ~b~Madd Dogg~s~ retten!", "~s~Torna a salvare ~b~Madd Dogg~s~!", "~s~¡Vuelve y rescata a ~b~Madd Dogg~s~!", "~s~Вернись и спаси ~b~Мэдд Догга~s~!", "~s~¡Vuelve y rescata a ~b~Madd Dogg~s~!", "~s~¡Vuelve y rescata a ~b~Madd Dogg~s~!" } },
    { "DOC2_15", { "~s~Go and save ~y~Madd Dogg ~s~before he jumps!", "~s~Faut que tu sauves ~y~Madd Dogg ~s~avant qu'il se foute en l'air_!", "~s~Rette ~y~Madd Dogg~s~, ehe er springt!", "~s~Vai a salvare ~b~Madd Dogg ~s~prima che si butti!", "~s~¡Ve a salvar a ~y~Madd Dogg ~s~antes de que salte!", "~s~СПАСИ ~y~СУМАСШЕДШЕГО ПСА ~s~ПРЕЖДЕ ЧЕМ ОН ПРЫГНЕТ!", "~s~¡Ve a salvar a ~y~Madd Dogg ~s~antes de que salte!", "~s~¡Ve a salvar a ~y~Madd Dogg ~s~antes de que salte!" } },
