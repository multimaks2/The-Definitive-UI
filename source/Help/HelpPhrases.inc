    { "DES5_8A", { "~s~Push ~k~~VEHICLE_STEERUP~ and press ~k~~VEHICLE_ACCELERATE~ to maintain your forward speed.", "~s~Utilise ~k~~VEHICLE_STEERUP~ et appuie sur ~k~~VEHICLE_ACCELERATE~ pour maintenir ta vitesse horizontale.", "~s~Drücke ~k~~VEHICLE_STEERUP~ und ~k~~VEHICLE_ACCELERATE~, um deine Vorwärtsgeschwindigkeit beizubehalten.", "~s~Usa ~k~~VEHICLE_STEERUP~ e ~k~~VEHICLE_ACCELERATE~ per conservare la velocità di crociera.", "~s~~k~~VEHICLE_STEERUP~ y pulsa ~k~~VEHICLE_ACCELERATE~ para mantener tu velocidad de avance.", "~s~Удерживай ~k~~VEHICLE_STEERUP~ и ~k~~VEHICLE_ACCELERATE~, чтобы сохранять скорость.", "~s~~k~~VEHICLE_STEERUP~ y pulsa ~k~~VEHICLE_ACCELERATE~ para mantener tu velocidad de avance.", "~s~~k~~VEHICLE_STEERUP~ y pulsa ~k~~VEHICLE_ACCELERATE~ para mantener tu velocidad de avance." } },
    { "DES5_8D", { "~s~Hold ~k~~VEHICLE_BRAKE~ to descend slowly and land.~N~Land in the ~y~target area ~s~for extra points.", "~s~Maintiens ~k~~VEHICLE_BRAKE~ enfoncée pour descendre lentement et te poser.~N~Pose-toi dans la ~y~zone cible ~s~pour gagner plus de points.", "~s~Halte ~k~~VEHICLE_BRAKE~ gedrückt, um langsam in den Sinkflug überzugehen und zu landen.~N~Lande im ~y~Zielgebiet~s~, um Extrapunkte zu sammeln.", "~s~Tieni premuto ~k~~VEHICLE_BRAKE~ per abbassarti lentamente.~N~Atterra nella ~y~zona del bersaglio~s~ per conquistare punti extra.", "~s~Mantén pulsado ~k~~VEHICLE_BRAKE~ para descender lentamente y aterrizar.~N~Aterriza en la ~y~zona objetivo~s~ para obtener puntos adicionales.", "~s~Удерживай ~k~~VEHICLE_BRAKE~, чтобы опуститься на землю.~N~Приземлись в ~y~отмеченной зоне~s~ для получения дополнительных очков.", "~s~Mantén pulsado ~k~~VEHICLE_BRAKE~ para descender lentamente y aterrizar.~N~Aterriza en la ~y~zona objetivo~s~ para obtener puntos adicionales.", "~s~Mantén pulsado ~k~~VEHICLE_BRAKE~ para descender lentamente y aterrizar.~N~Aterriza en la ~y~zona objetivo~s~ para obtener puntos adicionales." } },
    { "DES5_8E", { "~s~If you start to descend too quickly, release ~k~~VEHICLE_BRAKE~ and hold ~k~~VEHICLE_ACCELERATE~ to slow your descent.", "~s~Si tu descends trop vite, relâche ~k~~VEHICLE_BRAKE~ et maintiens ~k~~VEHICLE_ACCELERATE~ enfoncée pour ralentir ta descente.", "~s~Wenn du zu schnell sinkst, lass ~k~~VEHICLE_BRAKE~ los und halte ~k~~VEHICLE_ACCELERATE~ gedrückt, um langsamer zu werden.", "~s~Se cominci ad abbassarti troppo velocemente, rilascia ~k~~VEHICLE_BRAKE~ e tieni premuto ~k~~VEHICLE_ACCELERATE~ per frenare la caduta.", "~s~Si empiezas a descender demasiado deprisa, suelta ~k~~VEHICLE_BRAKE~ y mantén pulsado ~k~~VEHICLE_ACCELERATE~ para ralentizar tu descenso.", "~s~Если ты стал снижаться слишком быстро, отпусти ~k~~VEHICLE_BRAKE~ и удерживай ~k~~VEHICLE_ACCELERATE~, чтобы замедлить приземление.", "~s~Si empiezas a descender demasiado deprisa, suelta ~k~~VEHICLE_BRAKE~ y mantén pulsado ~k~~VEHICLE_ACCELERATE~ para ralentizar tu descenso.", "~s~Si empiezas a descender demasiado deprisa, suelta ~k~~VEHICLE_BRAKE~ y mantén pulsado ~k~~VEHICLE_ACCELERATE~ para ralentizar tu descenso." } },
    { "DES5_8F", { "Press ~k~~VEHICLE_BRAKE~ to descend and ~k~~VEHICLE_ACCELERATE~ to ascend.", "Appuie sur ~k~~VEHICLE_BRAKE~ pour descendre et sur ~k~~VEHICLE_ACCELERATE~ pour monter.", "Drücke ~k~~VEHICLE_BRAKE~, um zu sinken, und ~k~~VEHICLE_ACCELERATE~, um zu steigen.", "Premi ~k~~VEHICLE_BRAKE~ per salire e ~k~~VEHICLE_ACCELERATE~ per scendere.", "Pulsa ~k~~VEHICLE_BRAKE~ para descender y ~k~~VEHICLE_ACCELERATE~ para ascender.", "НАЖМИТЕ ~k~~VEHICLE_BRAKE~, ЧТОБЫ СПУСТИТЬСЯ И ~k~~VEHICLE_ACCELERATE~, ЧТОБЫ ПОДНЯТЬСЯ.", "Pulsa ~k~~VEHICLE_BRAKE~ para descender y ~k~~VEHICLE_ACCELERATE~ para ascender.", "Pulsa ~k~~VEHICLE_BRAKE~ para descender y ~k~~VEHICLE_ACCELERATE~ para ascender." } },
    { "DES5_9B", { "~s~Press ~k~~VEHICLE_FIREWEAPON_ALT~ to fire the guns and ~k~~PED_FIREWEAPON~ to fire rockets.", "~s~Appuie sur ~k~~VEHICLE_FIREWEAPON_ALT~ pour tirer au canon et sur ~k~~PED_FIREWEAPON~ pour tirer une roquette.", "~s~Drücke ~k~~VEHICLE_FIREWEAPON_ALT~, um die Waffen abzufeuern, und ~k~~PED_FIREWEAPON~, um Raketen abzufeuern.", "~s~Premi ~k~~VEHICLE_FIREWEAPON_ALT~ per sparare con le mitragliatrici e ~k~~PED_FIREWEAPON~ per sparare i razzi.", "~s~Pulsa ~k~~VEHICLE_FIREWEAPON_ALT~ para disparar las ametralladoras y ~k~~PED_FIREWEAPON~ para disparar los cohetes.", "~s~Нажми ~k~~VEHICLE_FIREWEAPON_ALT~, чтобы стрелять из пулемета, и ~k~~PED_FIREWEAPON~, чтобы стрелять из ракетомета.", "~s~Pulsa ~k~~VEHICLE_FIREWEAPON_ALT~ para disparar las ametralladoras y ~k~~PED_FIREWEAPON~ para disparar los cohetes.", "~s~Pulsa ~k~~VEHICLE_FIREWEAPON_ALT~ para disparar las ametralladoras y ~k~~PED_FIREWEAPON~ para disparar los cohetes." } },
    { "DES5_AC", { "~s~Push ~k~~VEHICLE_STEERDOWN~ now.", "~s~Utilise ~k~~VEHICLE_STEERDOWN~ maintenant.", "~s~Drücke jetzt ~k~~VEHICLE_STEERDOWN~.", "~s~Ora, usa ~k~~VEHICLE_STEERDOWN~.", "Usa ~k~~VEHICLE_STEERDOWN~ ahora.", "~s~Нажми ~k~~VEHICLE_STEERDOWN~ прямо сейчас.", "Usa ~k~~VEHICLE_STEERDOWN~ ahora.", "Usa ~k~~VEHICLE_STEERDOWN~ ahora." } },
    { "DES5_CA", { "~s~While freefalling, push ~k~~GO_FORWARD~ to dive forward.", "~s~Pendant la chute libre, utilise ~k~~GO_FORWARD~ pour plonger vers l'avant.", "~s~Drücke im freien Fall ~k~~GO_FORWARD~, um nach vorne abzutauchen.", "~s~Quando sei in caduta libera, premi ~k~~GO_FORWARD~ per andare in picchiata.", "~s~Durante la caída libre, usa ~k~~GO_FORWARD~ para hacer un picado.", "~s~Во время свободного падения нажми ~k~~GO_FORWARD~, чтобы ускорить падение.", "~s~Durante la caída libre, usa ~k~~GO_FORWARD~ para hacer un picado.", "~s~Durante la caída libre, usa ~k~~GO_FORWARD~ para hacer un picado." } },
    { "DES5_CB", { "~s~Push ~k~~GO_BACK~ to move backward and use ~k~~GO_LEFT~ and ~k~~GO_RIGHT~ to rotate.", "~s~Utilise ~k~~GO_BACK~ pour reculer et utilise ~k~~GO_LEFT~ et ~k~~GO_RIGHT~ pour effectuer une rotation.", "~s~Drücke ~k~~GO_BACK~, um dich rückwärts zu bewegen, und drücke ~k~~GO_LEFT~ und ~k~~GO_RIGHT~, um zu rotieren.", "~s~Premi ~k~~GO_BACK~ per andare all'indietro e usa ~k~~GO_LEFT~ e ~k~~GO_RIGHT~ per roteare.", "~s~Usa ~k~~GO_BACK~ para moverte hacia atrás y ~k~~GO_RIGHT~ para girar.", "~s~НАЖМИТЕ ~k~~GO_BACK~, ЧТОБЫ ОТСТУПИТЬ НАЗАД И С ПОМОШЬЮ ~k~~GO_LEFT~ И ~k~~GO_RIGHT~ ДЛЯ ВРАШЕНИЯ.", "~s~Usa ~k~~GO_BACK~ para moverte hacia atrás y ~k~~GO_RIGHT~ para girar.", "~s~Usa ~k~~GO_BACK~ para moverte hacia atrás y ~k~~GO_RIGHT~ para girar." } },
    { "DES5_CC", { "~s~Press ~k~~PED_FIREWEAPON~ to open the parachute now.", "~s~Appuie sur ~k~~PED_FIREWEAPON~ pour ouvrir le parachute maintenant.", "~s~Drücke jetzt ~k~~PED_FIREWEAPON~, um den Fallschirm zu öffnen.", "~s~Ora premi ~k~~PED_FIREWEAPON~ per aprire il paracadute.", "~s~Ahora, pulsa ~k~~PED_FIREWEAPON~ para abrir el paracaídas.", "~s~Нажми ~k~~PED_FIREWEAPON~, чтобы открыть парашют прямо сейчас.", "~s~Ahora, pulsa ~k~~PED_FIREWEAPON~ para abrir el paracaídas.", "~s~Ahora, pulsa ~k~~PED_FIREWEAPON~ para abrir el paracaídas." } },
    { "DES5_CE", { "~s~Use ~k~~GO_LEFT~ and ~k~~GO_RIGHT~ to guide the parachute left and right.", "~s~Utilise ~k~~GO_LEFT~ et ~k~~GO_RIGHT~ pour guider le parachute vers la gauche et la droite.", "~s~Benutze ~k~~GO_LEFT~ und ~k~~GO_RIGHT~, um den Fallschirm nach links und rechts zu lenken.", "~s~Usa ~k~~GO_LEFT~ e ~k~~GO_RIGHT~ per guidare il paracadute a sinistra e destra.", "~s~Usa ~k~~GO_LEFT~ y ~k~~GO_RIGHT~ para guiar el paracaídas hacia la izquierda o hacia la derecha.", "~s~Нажми ~k~~GO_LEFT~ или ~k~~GO_RIGHT~, чтоб поворачивать парашют налево или направо.", "~s~Usa ~k~~GO_LEFT~ y ~k~~GO_RIGHT~ para guiar el paracaídas hacia la izquierda o hacia la derecha.", "~s~Usa ~k~~GO_LEFT~ y ~k~~GO_RIGHT~ para guiar el paracaídas hacia la izquierda o hacia la derecha." } },
    { "DES5_CF", { "~s~Push ~k~~GO_BACK~ to lift your legs up and move forward.", "~s~Utilise ~k~~GO_BACK~ pour lever les jambes et avancer.", "~s~Drücke ~k~~GO_BACK~, um deine Beine zu heben und vorwärts zu fliegen.", "~s~Premi ~k~~GO_BACK~ per alzare le gambe e muoverti in avanti.", "~s~Usa ~k~~GO_BACK~ para levantar las piernas y moverte hacia delante.", "~s~Нажми ~k~~GO_BACK~, чтобы поднять ноги и увеличить скорость движения вперед.", "~s~Usa ~k~~GO_BACK~ para levantar las piernas y moverte hacia delante.", "~s~Usa ~k~~GO_BACK~ para levantar las piernas y moverte hacia delante." } },
