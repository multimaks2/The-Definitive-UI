    { "GF_H014", { "You've been spotted by another girlfriend. Quick, shake her off your tail!", "T'as été repéré par une autre meuf. Vite, sème-la_!", "Du wurdest von einer anderen Freundin gesehen. Schnell, schüttle sie ab!", "Sei stato visto da un'altra ragazza. Svelto, seminala!", "Otra de tus novias te ha visto. ¡Rápido, despístala!", "Тебя заметила твоя другая девушка. Быстро, сбрось ее с хвоста!", "Otra de tus novias te ha visto. ¡Rápido, despístala!", "Otra de tus novias te ha visto. ¡Rápido, despístala!" } },
    { "GF_H015", { "You have been discovered two-timing. Your date is over.", "On t'a vu tromper ta meuf. Tu peux dire adieu à ton rencard.", "Du wurdest beim Seitensprung ertappt. Das Date ist zu Ende.", "Sei stato beccato in flagrante. Il tuo appuntamento è finito.", "Te han descubierto jugando a dos bandas. Tu cita ha terminado.", "Тебя уличили в измене. Свидание окончено.", "Te han descubierto jugando a dos bandas. Tu cita ha terminado.", "Te han descubierto jugando a dos bandas. Tu cita ha terminado." } },
    { "GF_H016", { "You've managed to lose the jealous girlfriend. Well done.", "T'as réussi à te débarrasser de la meuf jalouse. Bien ouèj'_!", "Du hast es geschafft, die eifersüchtige Freundin abzuhängen. Gut gemacht.", "Sei riuscito a seminare la ragazza gelosa. Ben fatto.", "Has logrado despistar a tu novia celosa. Bien hecho.", "Тебе удалось оторваться от твоей ревнивой девушки. Молодец.", "Has logrado despistar a tu novia celosa. Bien hecho.", "Has logrado despistar a tu novia celosa. Bien hecho." } },
    { "GF_H017", { "You've abandoned your girlfriend. Your date is over.", "T'as laissé tomber ta meuf. Ton rencard est à l'eau.", "Du hast deine Freundin zurückgelassen. Euer Date ist zu Ende.", "Hai abbandonato la tua ragazza. Il tuo appuntamento è finito.", "Has abandonado a tu novia. Tu cita ha terminado.", "Ты бросил свою девушку. Свидание окончено.", "Has abandonado a tu novia. Tu cita ha terminado.", "Has abandonado a tu novia. Tu cita ha terminado." } },
    { "GF_H018", { "You've abused your girlfriend. Your date is over!", "C'est pas comme ça qu'on traite une meuf. Ton rencard est terminé_!", "Du hast deine Freundin schlecht behandelt. Euer Date ist zu Ende!", "Hai maltrattato la tua ragazza. Il tuo appuntamento è finito!", "Has tratado mal a tu novia. ¡Tu cita ha terminado!", "Ты плохо обошелся со своей девушкой. Свидание окончено!", "Has tratado mal a tu novia. ¡Tu cita ha terminado!", "Has tratado mal a tu novia. ¡Tu cita ha terminado!" } },
    { "GF_RAD", { "Use ~k~~VEHICLE_RADIO_STATION_UP~ and ~k~~VEHICLE_RADIO_STATION_DOWN~ to change radio station.", "Appuie sur ~k~~VEHICLE_RADIO_STATION_UP~ ou ~k~~VEHICLE_RADIO_STATION_DOWN~ pour changer de station de radio.", "Benutze ~k~~VEHICLE_RADIO_STATION_UP~ oder ~k~~VEHICLE_RADIO_STATION_DOWN~, um den Radiosender zu wechseln.", "Usa ~k~~VEHICLE_RADIO_STATION_UP~ e ~k~~VEHICLE_RADIO_STATION_DOWN~ per cambiare stazione radio.", "Usa ~k~~VEHICLE_RADIO_STATION_UP~ y ~k~~VEHICLE_RADIO_STATION_DOWN~ para cambiar la emisora de radio.", "~k~~VEHICLE_RADIO_STATION_UP~ и ~k~~VEHICLE_RADIO_STATION_DOWN~ - сменить радиостанцию.", "Usa ~k~~VEHICLE_RADIO_STATION_UP~ y ~k~~VEHICLE_RADIO_STATION_DOWN~ para cambiar la emisora de radio.", "Usa ~k~~VEHICLE_RADIO_STATION_UP~ y ~k~~VEHICLE_RADIO_STATION_DOWN~ para cambiar la emisora de radio." } },
    { "GIMPGOT", { "The gimp suit has been delivered to your wardrobe!", "La combi en latex a été livrée dans ta penderie_!", "Der S&M-Anzug steht ab jetzt in deinem Kleiderschrank zur Verfügung!", "Il vestito sadomaso è stato inviato al tuo guardaroba!", "Se ha llevado a tu ropero el traje de masoca.", "Кожаный костюм доставлен в твой гардероб!", "Se ha llevado a tu ropero el traje de masoca.", "Se ha llevado a tu ropero el traje de masoca." } },
    { "GUNS118", { "Press ~k~~VEHICLE_ENTER_EXIT~ to pick up the crate.", "Appuie sur ~k~~VEHICLE_ENTER_EXIT~ pour prendre la caisse.", "Drücke ~k~~VEHICLE_ENTER_EXIT~, um die Kiste aufzuheben.", "Premi ~k~~VEHICLE_ENTER_EXIT~ per raccogliere la cassa.", "Pulsa ~k~~VEHICLE_ENTER_EXIT~ para recoger la caja.", "~k~~VEHICLE_ENTER_EXIT~ - взять ящик.", "Pulsa ~k~~VEHICLE_ENTER_EXIT~ para recoger la caja.", "Pulsa ~k~~VEHICLE_ENTER_EXIT~ para recoger la caja." } },
    { "GYM1101", { "Defeat your opponent to learn new moves!", "Botte le cul de ton adversaire pour apprendre de nouveaux mouvements_!", "Besiege deinen Gegner, um neue Kampftechniken zu erlernen.", "Sconfiggi il tuo avversario per apprendere nuove mosse!", "¡Derrota a tu oponente para aprender nuevos movimientos!", "Победи своего противника, чтобы изучить новые приемы!", "¡Derrota a tu oponente para aprender nuevos movimientos!", "¡Derrota a tu oponente para aprender nuevos movimientos!" } },
    { "GYM1106", { "Defeat your opponent to learn new moves. If you leave the ring you lose!", "Bats ton adversaire pour apprendre de nouveaux mouvements. Si tu quittes le ring, tu perds_!", "Besiege deinen Gegner, um neue Kampftechniken zu erlernen. Wenn du den Ring verlässt, hast du verloren!", "Sconfiggi i tuoi avversari per imparare nuove mosse. Se abbandoni il ring, perderai!", "Derrota a tu oponente para aprender nuevos movimientos. ¡Si abandonas el ring perderás!", "Победи своего противника, чтобы изучить новые приемы. Если ты покинешь ринг, то проиграешь!", "Derrota a tu oponente para aprender nuevos movimientos. ¡Si abandonas el ring perderás!", "Derrota a tu oponente para aprender nuevos movimientos. ¡Si abandonas el ring perderás!" } },
    { "GYM1_25", { "Press ~k~~VEHICLE_ENTER_EXIT~ to exit.", "Appuie sur ~k~~VEHICLE_ENTER_EXIT~ pour quitter.", "Drücke ~k~~VEHICLE_ENTER_EXIT~ zum Beenden.", "Premi ~k~~VEHICLE_ENTER_EXIT~ per uscire.", "Pulsa ~k~~VEHICLE_ENTER_EXIT~ para salir.", "~k~~VEHICLE_ENTER_EXIT~ - выход.", "Pulsa ~k~~VEHICLE_ENTER_EXIT~ para salir.", "Pulsa ~k~~VEHICLE_ENTER_EXIT~ para salir." } },
    { "GYM1_36", { "To lift the dumbbells alternate between pressing ~k~~PED_SPRINT~ and ~k~~PED_FIREWEAPON~.~n~This will increase your power.", "Pour soulever les haltères, appuie alternativement sur ~k~~PED_SPRINT~ et ~k~~PED_FIREWEAPON~.~n~Tu gagneras en puissance.", "Um die Hanteln zu stemmen, drücke abwechselnd ~k~~PED_SPRINT~ und ~k~~PED_FIREWEAPON~. Dadurch erhöht sich dein Krafteinsatz.", "Per sollevare i manubri, alterna la pressione di ~k~~PED_SPRINT~ e ~k~~PED_FIREWEAPON~. Così aumenterai la tua forza.", "Para levantar las pesas, alterna entre pulsar ~k~~PED_SPRINT~ y ~k~~PED_FIREWEAPON~. Esto aumentará tu potencia.", "Чтобы поднимать гантели, поочередно нажимай ~k~~PED_SPRINT~ и ~k~~PED_FIREWEAPON~.~n~Чем быстрее ты будешь их нажимать, тем скорее будет заполняться шкала энергии.", "Para levantar las pesas, alterna entre pulsar ~k~~PED_SPRINT~ y ~k~~PED_FIREWEAPON~. Esto aumentará tu potencia.", "Para levantar las pesas, alterna entre pulsar ~k~~PED_SPRINT~ y ~k~~PED_FIREWEAPON~. Esto aumentará tu potencia." } },
    { "GYM1_37", { "~w~To lift the weight alternate between pressing ~k~~PED_SPRINT~ and ~k~~PED_FIREWEAPON~.~n~This will increase your power.", "~w~Pour soulever le poids, appuie alternativement sur ~k~~PED_SPRINT~ et ~k~~PED_FIREWEAPON~.~n~Tu gagneras en puissance.", "~w~Um das Gewicht zu stemmen, drücke abwechselnd ~k~~PED_SPRINT~ und ~k~~PED_FIREWEAPON~. Dadurch erhöht sich dein Krafteinsatz.", "Per sollevare un peso, alterna la pressione di ~k~~PED_SPRINT~ e di ~k~~PED_FIREWEAPON~. Così aumenterai la tua forza.", "~w~Para levantar el peso alterna entre pulsar ~k~~PED_SPRINT~ y ~k~~PED_FIREWEAPON~. Esto aumentará tu potencia.", "~w~Чтобы поднимать штангу, поочередно нажимай ~k~~PED_SPRINT~ и ~k~~PED_FIREWEAPON~.~n~Чем быстрее ты будешь их нажимать, тем скорее будет заполняться шкала энергии.", "~w~Para levantar el peso alterna entre pulsar ~k~~PED_SPRINT~ y ~k~~PED_FIREWEAPON~. Esto aumentará tu potencia.", "~w~Para levantar el peso alterna entre pulsar ~k~~PED_SPRINT~ y ~k~~PED_FIREWEAPON~. Esto aumentará tu potencia." } },
    { "GYM1_40", { "Press ~k~~PED_SPRINT~ rapidly to begin to pedal.", "Appuie rapidement sur ~k~~PED_SPRINT~ pour commencer à pédaler.", "Indem du mehrmals schnell ~k~~PED_SPRINT~ drückst, fängst du an, in die Pedale zu treten.", "Premi rapidamente ~k~~PED_SPRINT~ per iniziare a pedalare.", "Pulsa ~k~~PED_SPRINT~ rápidamente para empezar a pedalear.", "Быстро нажимай ~k~~PED_SPRINT~, чтобы крутить педали.", "Pulsa ~k~~PED_SPRINT~ rápidamente para empezar a pedalear.", "Pulsa ~k~~PED_SPRINT~ rápidamente para empezar a pedalear." } },
