    { "CRA1_00", { "~s~Tenpenny has hidden some ~g~molotovs~s~ in an alleyway in Downtown Los Santos. Pick them up.", "~s~Tenpenny a planqué des ~g~cocktails Molotov~s~ dans une ruelle du centre-ville de Los Santos. Va les récupérer.", "~s~Tenpenny hat einige ~g~Molotowcocktails~s~ in einem Durchgang in Downtown Los Santos versteckt. Hol sie ab.", "~s~Tenpenny ha nascosto delle ~g~molotov~s~ in una strada nel centro di Los Santos. Recuperale.", "~s~Tenpenny ha escondido unos ~g~cócteles molotov~s~ en un callejón del centro de Los Santos. Recógelos.", "~s~Тенпенни припрятал немного ~g~коктейлей Молотова~s~ в переулке в Центре Лос-Сантоса. Найди их.", "~s~Tenpenny ha escondido unos ~g~cócteles molotov~s~ en un callejón del centro de Los Santos. Recógelos.", "~s~Tenpenny ha escondido unos ~g~cócteles molotov~s~ en un callejón del centro de Los Santos. Recógelos." } },
    { "CRA1_08", { "~s~There's a ~g~fire extinguisher~s~ in the kitchen downstairs.", "~s~Y a un ~g~extincteur~s~ dans la cuisine, en bas.", "~s~In der Küche unten ist ein ~g~Feuerlöscher~s~.", "~s~C'è un ~g~estintore~s~ nella cucina di sotto.", "~s~Hay un ~g~extintor~s~ en la cocina, bajando las escaleras.", "~s~~g~Огнетушитель~s~ находится в кухне на первом этаже.", "~s~Hay un ~g~extintor~s~ en la cocina, bajando las escaleras.", "~s~Hay un ~g~extintor~s~ en la cocina, bajando las escaleras." } },
    { "CRA1_11", { "~s~Drive the ~b~girl~s~ ~y~home~s~.", "~s~Ramène la ~b~fille~s~ ~y~chez elle~s~.", "~s~Fahr das ~b~Mädchen~s~ ~y~nach Hause~s~.", "~s~Riporta la ~b~ragazza~s~ a ~y~casa~s~.", "~s~Lleva a la ~b~chica~s~ a ~y~casa~s~.", "~s~Отвези ~b~девчонку~s~ ~y~домой~s~.", "~s~Lleva a la ~b~chica~s~ a ~y~casa~s~.", "~s~Lleva a la ~b~chica~s~ a ~y~casa~s~." } },
    { "RUMBLE", { "Rumble... Rumble... (sounds of building collapsing)", "(Le bâtiment commence à s'effondrer.)", "Rumpel...Rumpel...", "Rumble... Rumble...", "Rumble... Rumble... (sounds of building collapsing)", "БАХ... БАХ... (ЗВУКИ РАЗРУШЕНИЯ ЗДАНИЯ)", "Rumble... Rumble... (sounds of building collapsing)", "Rumble... Rumble... (sounds of building collapsing)" } },
    { "NEWSHAG", { "Denise is now a potential girlfriend. Return here at any time to ask her for a date.", "Denise peut maintenant devenir ta meuf. Reviens ici quand tu veux pour lui filer rencard.", "Denise kommt jetzt als Freundin in Frage. Komm jederzeit wieder und bitte sie um ein Date.", "Denise è una tua potenziale fidanzata. Torna qui quando vuoi e chiedile di uscire.", "Ahora, Denise es un posible ligue. Vuelve aquí cuando quieras y pídele salir.", "Теперь Дениз - твоя потенциальная подружка. Приходи к ней в любое время, чтобы пригласить ее на свидание.", "Ahora, Denise es un posible ligue. Vuelve aquí cuando quieras y pídele salir.", "Ahora, Denise es un posible ligue. Vuelve aquí cuando quieras y pídele salir." } },
    { "CRA1_01", { "~s~You've got molotovs. Go to the ~y~gang house~s~ and torch it.", "~s~T'as des cocktails Molotov. Va à la ~y~planque du gang~s~ et fais-la cramer.", "~s~Du hast die Molotowcocktails. Begib dich zum ~y~Gang-Haus~s~ und stecke es in Brand.", "~s~Hai le molotov. Raggiungi il ~y~covo della gang~s~ e dagli fuoco.", "~s~Has conseguido cócteles molotov. Ve a la ~y~casa de la banda~s~ y préndele fuego.", "~s~У тебя есть коктейли Молотова. Подожги с их помощью ~y~бандитский дом~s~.", "~s~Has conseguido cócteles molotov. Ve a la ~y~casa de la banda~s~ y préndele fuego.", "~s~Has conseguido cócteles molotov. Ve a la ~y~casa de la banda~s~ y préndele fuego." } },
    { "CRA1_02", { "~s~Torch the house. Throw molotovs into the ~r~5 downstairs windows~s~ - that'll make it burn.", "~s~Fais cramer la baraque. Jette des cocktails Molotov par les ~r~5 fenêtres du bas~s~ pour y mettre le feu.", "~s~Setz das Haus in Brand. Wirf dazu Molotowcocktails in die ~r~5 unteren Fenster~s~.", "~s~Dai fuoco alla casa. Lancia delle molotov nelle ~r~5 finestre al piano terra~s~, per far scoppiare l'incendio.", "~s~Quema la casa. Lanza cócteles molotov a las ~r~5 ventanas de abajo~s~, eso hará que se incendie.", "~s~Подожги дом. Забрось в каждое из ~r~пяти окон~s~ по коктейлю Молотова, чтобы пламя охватило весь дом.", "~s~Quema la casa. Lanza cócteles molotov a las ~r~5 ventanas de abajo~s~, eso hará que se incendie.", "~s~Quema la casa. Lanza cócteles molotov a las ~r~5 ventanas de abajo~s~, eso hará que se incendie." } },
    { "CRA1_03", { "~s~There are some more ~g~molotovs~s~ nearby.", "~s~Y a d'autres ~g~cocktails Molotov~s~ dans le coin.", "~s~In der Nähe gibt es noch mehr ~g~Molotowcocktails~s~.", "~s~Ci sono altre ~g~molotov~s~ nei paraggi.", "~s~Hay algunos ~g~cócteles molotov~s~ más en las cercanías.", "~s~Рядом есть еще несколько ~g~коктейлей Молотова~s~.", "~s~Hay algunos ~g~cócteles molotov~s~ más en las cercanías.", "~s~Hay algunos ~g~cócteles molotov~s~ más en las cercanías." } },
    { "CRA1_04", { "~s~Well done. The house is going to burn to the ground.", "~s~Bien joué_! Les flammes vont dévorer la baraque.", "~s~Gut gemacht. Das Haus wird abbrennen.", "~s~Ben fatto. La casa verrà rasa al suolo dall'incendio.", "~s~Bien hecho. La casa arderá hasta los cimientos.", "~s~Отлично. Скоро от дома не останется и следа.", "~s~Bien hecho. La casa arderá hasta los cimientos.", "~s~Bien hecho. La casa arderá hasta los cimientos." } },
    { "CRA1_05", { "~s~You've trapped a girl inside the burning building. You'll have to save her.", "~s~Une meuf est coincée dans le bâtiment en flammes. Tu dois aller la sauver.", "~s~Ein Mädchen befindet sich noch in dem brennenden Haus. Du musst es retten.", "~s~C'è una ragazza intrappolata all'interno dell'edificio. Dovrai salvarla.", "~s~Hay una chica atrapada en el edificio en llamas. Tendrás que salvarla.", "~s~В горящем доме оказалась девушка. Ты обязан ее спасти.", "~s~Hay una chica atrapada en el edificio en llamas. Tendrás que salvarla.", "~s~Hay una chica atrapada en el edificio en llamas. Tendrás que salvarla." } },
    { "CRA1_06", { "~s~Go in through the ~y~front door~s~.", "~s~Entre par la ~y~porte de devant~s~.", "~s~Geh durch die ~y~Vordertür~s~ hinein.", "~s~Entra dall'~y~ingresso principale~s~.", "~s~Ve por la ~y~puerta delantera~s~.", "~s~Войди в здание, используя ~y~парадную дверь~s~.", "~s~Ve por la ~y~puerta delantera~s~.", "~s~Ve por la ~y~puerta delantera~s~." } },
    { "CRA1_07", { "The girl is upstairs. You don't have much time before she burns.", "La meuf est à l'étage. Magne-toi, elle va bientôt cramer.", "Das Mädchen ist oben. Du hast nicht viel Zeit, bevor es verbrennt.", "La ragazza è al piano di sopra. Non hai molto tempo prima che muoia.", "La chica está arriba. No tienes mucho tiempo antes de que se queme.", "Девушка находится на втором этаже. У тебя немного времени, чтоб вытащить ее до того, как она сгорит.", "La chica está arriba. No tienes mucho tiempo antes de que se queme.", "La chica está arriba. No tienes mucho tiempo antes de que se queme." } },
    { "CRA1_09", { "~s~Take the fire extinguisher upstairs and rescue the ~b~girl~s~.", "~s~Emmène l'extincteur à l'étage et sauve la ~b~meuf~s~.", "~s~Nimm den Feuerlöscher mit ins Obergeschoss und rette das ~b~Mädchen~s~.", "~s~Porta l'estintore al piano di sopra e salva la ~b~ragazza~s~.", "~s~Lleva el extintor arriba y rescata a la ~b~chica~s~.", "~s~Возьми огнетушитель и спаси ~b~девушку~s~.", "~s~Lleva el extintor arriba y rescata a la ~b~chica~s~.", "~s~Lleva el extintor arriba y rescata a la ~b~chica~s~." } },
    { "CRA1_10", { "~s~You have left the ~b~girl~s~ behind. Go back and get her.", "~s~T'as oublié la ~b~meuf~s~. Retourne la chercher_!", "~s~Du hast das ~b~Mädchen~s~ zurückgelassen. Kehr um und hole es.", "~s~Hai lasciato indietro la ~b~ragazza~s~. Torna a prenderla.", "~s~Has dejado atrás a la ~b~chica~s~. Vuelve a por ella.", "~s~Ты оставил ~b~девчонку~s~ позади. Вернись и забери ее.", "~s~Has dejado atrás a la ~b~chica~s~. Vuelve a por ella.", "~s~Has dejado atrás a la ~b~chica~s~. Vuelve a por ella." } },
