    { "IE24", { "~s~You have successfully delivered this vehicle for export.", "~s~T'as réussi à livrer ce véhicule pour l'exportation.", "~s~Du hast dieses Fahrzeug erfolgreich zum Export abgeliefert.", "~s~Hai consegnato con successo questo veicolo agli esportatori.", "~s~Has entregado con éxito este vehículo para su exportación.", "~s~Машина для экспорта успешно доставлена.", "~s~Has entregado con éxito este vehículo para su exportación.", "~s~Has entregado con éxito este vehículo para su exportación." } },
    { "IE28", { "~r~There are no cars available to import on this day.", "~r~Il n'y a aucune voiture disponible à l'importation ce jour-là.", "Heute werden keine Fahrzeuge importiert.", "~r~Nessuna auto disponibile in questo giorno.", "~r~No hay coches disponibles para importar este día.", "~r~На этот день нет доступных тачек для импорта.", "~r~No hay coches disponibles para importar este día.", "~r~No hay coches disponibles para importar este día." } },
    { "BUSY", { "You look a bit busy, why don't you come back later.", "T'as l'air d'avoir plein de trucs à faire, tu devrais revenir plus tard.", "Sieht aus, als wärst du beschäftigt. Komm doch später wieder.", "Hai da fare, perché non passi più tardi?", "Pareces ocupado, ¿por qué no vienes luego?", "Ты немного занят, почему бы тебе не прийти попозже.", "Pareces ocupado, ¿por qué no vienes luego?", "Pareces ocupado, ¿por qué no vienes luego?" } },
    { "NOCASH", { "You don't have enough cash to play here.", "T'as pas assez de fric pour jouer ici.", "Du hast nicht genug Bares, um hier zu spielen.", "Non hai abbastanza soldi per giocare qui.", "No tienes suficiente dinero para jugar aquí.", "У тебя недостаточно денег.", "No tienes suficiente dinero para jugar aquí.", "No tienes suficiente dinero para jugar aquí." } },
    { "CAT_HI", { "Where shall we rob today?", "Alors, c'est quoi qu'on choure aujourd'hui_?", "Wo gehen wir heute auf Raubzug?", "Dove vuoi rubare, oggi?", "¿Dónde vamos a robar hoy?", "ГДЕ МЫ БУДЕМ ГРАБИТЬ СЕГОДНЯ?", "¿Dónde vamos a robar hoy?", "¿Dónde vamos a robar hoy?" } },
    { "CATLOS1", { "I have managed to lose you. I'll meet you back at the cabin.", "J'ai réussi à te semer. On se retrouve à la cabane.", "Ich hab dich verloren. Wir treffen uns bei der Hütte.", "Ti ho perso. Ci rivediamo al rifugio.", "Te he perdido. Te veré de vuelta en la cabina.", "МНЕ УДАЛОСЬ ОТОРВАТЬСЯ ОТ ТЕБЯ. МЫ ВСТРЕТИМСЯ СНОВА ВОЗЛЕ ХИЖИНЫ.", "Te he perdido. Te veré de vuelta en la cabina.", "Te he perdido. Te veré de vuelta en la cabina." } },
    { "CATLOS2", { "I have managed to lose you. I'll meet you back at the truck stop.", "J'ai réussi à te semer. On se retrouve au resto des camionneurs.", "Ich hab dich verloren. Wir treffen uns bei der Raststätte.", "Ti ho perso. Ci rivediamo alla stazione dei camion.", "Te he perdido. Te veré de vuelta en la parada de camiones.", "Мне удалось оторваться от тебя. Встретимся на стоянке дальнобойщиков.", "Te he perdido. Te veré de vuelta en la parada de camiones.", "Te he perdido. Te veré de vuelta en la parada de camiones." } },
    { "BCE2_04", { "You stole $~1~ from the courier.", "T'as piqué ~1~$ au coursier.", "Du hast dem Kurier $~1~ gestohlen.", "Hai rubato ~1~_$ dal corriere.", "Le has robado ~1~ $ al mensajero.", "Ты отнял у курьера $~1~.", "Le has robado ~1~ $ al mensajero.", "Le has robado ~1~ $ al mensajero." } },
