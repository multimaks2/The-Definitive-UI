    { "GA_7", { "Arm with ~k~~PED_FIREWEAPON~. Bomb will go off when engine is started.", "Amorce la bombe avec ~k~~PED_FIREWEAPON~. Elle explosera quand le moteur démarrera.", "Mach die Bombe mit ~k~~PED_FIREWEAPON~ scharf. Dann geht sie hoch, wenn der Wagen angelassen wird.", "Innesca la bomba premendo ~k~~PED_FIREWEAPON~. Esploderà all'accensione del motore.", "Actívala con ~k~~PED_FIREWEAPON~. La bomba estallará cuando el motor arranque.", "Активируй бомбу нажатием на ~k~~PED_FIREWEAPON~. Бомба взорвется, как только машина заведется.", "Actívala con ~k~~PED_FIREWEAPON~. La bomba estallará cuando el motor arranque.", "Actívala con ~k~~PED_FIREWEAPON~. La bomba estallará cuando el motor arranque." } },
    { "GA_7B", { "Arm with ~k~~PED_FIREWEAPON~. Bomb will go off when engine is started.", "Amorce la bombe avec ~k~~PED_FIREWEAPON~. Elle explosera quand le moteur démarrera.", "Mach die Bombe mit ~k~~PED_FIREWEAPON~ scharf. Dann geht sie hoch, wenn der Wagen angelassen wird.", "Innesca la bomba premendo ~k~~PED_FIREWEAPON~. Esploderà all'accensione del motore.", "Actívala con ~k~~PED_FIREWEAPON~. La bomba estallará cuando el motor arranque.", "Активируй бомбу нажатием ~k~~PED_FIREWEAPON~. Бомба взорвется, когда движок заведут.", "Actívala con ~k~~PED_FIREWEAPON~. La bomba estallará cuando el motor arranque.", "Actívala con ~k~~PED_FIREWEAPON~. La bomba estallará cuando el motor arranque." } },
    { "GA_8", { "Use the detonator to activate the bomb.", "Utilise le détonateur pour amorcer la bombe.", "Benutze den Zünder, um die Bombe scharfzumachen.", "Usa il detonatore per far esplodere la bomba.", "Usa el detonador para activar la bomba.", "Используй детонатор, чтобы активировать бомбу.", "Usa el detonador para activar la bomba.", "Usa el detonador para activar la bomba." } },
    { "GA_6", { "Park it, prime it by pressing ~k~~PED_FIREWEAPON~ and LEG IT!", "Gare-la, amorce la bombe avec ~k~~PED_FIREWEAPON~ et CASSE-TOI_!", "Park die Karre, mach sie durch Drücken von ~k~~PED_FIREWEAPON~ scharf und dann HAU AB!", "Parcheggiala, innesca la bomba premendo ~k~~PED_FIREWEAPON~ e SQUAGLIATELA!", "Aparca, activa la bomba pulsando ~k~~PED_FIREWEAPON~ ¡y a correr!", "Припаркуйся, активируй бомбу нажатием на ~k~~PED_FIREWEAPON~ и СМАТЫВАЙСЯ!", "Aparca, activa la bomba pulsando ~k~~PED_FIREWEAPON~ ¡y a correr!", "Aparca, activa la bomba pulsando ~k~~PED_FIREWEAPON~ ¡y a correr!" } },
    { "GA_6B", { "Park it, prime it by pressing ~k~~PED_FIREWEAPON~ and LEG IT!", "Gare-la, amorce la bombe avec ~k~~PED_FIREWEAPON~ et CASSE-TOI_!", "Park die Karre, mach sie durch Drücken von ~k~~PED_FIREWEAPON~ scharf und dann HAU AB!", "Parcheggiala, innesca la bomba premendo ~k~~PED_FIREWEAPON~ e SQUAGLIATELA!", "Aparca, activa la bomba pulsando ~k~~PED_FIREWEAPON~ ¡y a correr!", "Припаркуйся, активируй бомбу нажатием на ~k~~PED_FIREWEAPON~ и СМАТЫВАЙСЯ!", "Aparca, activa la bomba pulsando ~k~~PED_FIREWEAPON~ ¡y a correr!", "Aparca, activa la bomba pulsando ~k~~PED_FIREWEAPON~ ¡y a correr!" } },
