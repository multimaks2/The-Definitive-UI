    { "RM3_1", { "~s~Go to the ~y~Market~s~ area of town and take over all of the ~y~Los Santos Vagos territory~s~.", "~s~Va dans le secteur de ~y~Market~s~ et empare-toi du ~y~territoire des Vagos de Los Santos~s~.", "~s~Begib dich in die Nähe von ~y~Market~s~ und übernimm das gesamte ~y~Los Santos Vagos-Gebiet~s~.", "~s~Vai nella zona ~y~Market~s~ della città e prendi il controllo di tutti i ~y~territori dei Vagos di Los Santos~s~.", "~s~Ve a la zona de ~y~Market~s~ de la ciudad y hazte con todo el ~y~territorio de Los Santos Vagos~s~.", "~s~ОТПРАВЛЯИСЯ В ~y~ТОРГОВЫИ~s~ РАИОН И ЗАХВАТИ ВСЮ ~y~ТЕРРИТОРИЮ ВАГОСОВ В ЛОС САНТОС~s~.", "~s~Ve a la zona de ~y~Market~s~ de la ciudad y hazte con todo el ~y~territorio de Los Santos Vagos~s~.", "~s~Ve a la zona de ~y~Market~s~ de la ciudad y hazte con todo el ~y~territorio de Los Santos Vagos~s~." } },
    { "RM3_2", { "~s~Attack the Los Santos Vagos gang members and take over the territory.", "~s~Attaque le gang des Vagos de Los Santos et empare-toi de leur territoire.", "~s~Greife die Gangmitglieder der Los Santos Vagos an und übernimm das Gebiet.", "~s~Attacca i membri della gang Vagos di Los Santos e prendi il controllo del territorio.", "~s~Ataca a los miembros de la banda de Los Santos Vagos y hazte con el territorio.", "~s~НАПАДИ НА БАНДУ ВАГОСА В ЛОС САНТОСЕ И ЗАХВАТИ ТЕРРЕТОРИЮ.", "~s~Ataca a los miembros de la banda de Los Santos Vagos y hazte con el territorio.", "~s~Ataca a los miembros de la banda de Los Santos Vagos y hazte con el territorio." } },
    { "RM3_3", { "~s~The enemy gang have retaken the territory, go and take it over.", "~s~Le gang ennemi a reconquis son territoire. Retourne là-bas pour le reprendre_!", "~s~Die feindliche Gang hat das Gebiet zurückerobert. Übernimm es.", "~s~La gang nemica ha riconquistato il territorio, vai a riprenderlo.", "~s~La banda enemiga ha retomado el territorio: ve a recuperarlo.", "~s~ВРАЖЕСКАЯ БАНДА ВНОВЬ ЗАХВАТИЛА ТЕРРИТОРИЮ, ИДИ И ОТБЕИ ЕЕ.", "~s~La banda enemiga ha retomado el territorio: ve a recuperarlo.", "~s~La banda enemiga ha retomado el territorio: ve a recuperarlo." } },
    { "RM4_51", { "To move the crosshair use camera movement controls, to fire press ~k~~PED_FIREWEAPON~.", "Pour déplacer le viseur, utilise les contrôles de mouvement de la caméra et appuie sur ~k~~PED_FIREWEAPON~ pour tirer.", "Benutze die Kamerakontrolle, um das Fadenkreuz zu bewegen. Um zu feuern, drücke ~k~~PED_FIREWEAPON~.", "Per muovere il mirino usa i comandi della visuale, per sparare premi ~k~~PED_FIREWEAPON~.", "Para mover el punto de mira, usa los controles de movimiento de cámara, y para disparar, pulsa ~k~~PED_FIREWEAPON~.", "ЧТОБЫ ПЕРЕМЕСТИТЬ КУРСОР ИСПОЛЬЗУЙ КНОПКИ ДВИЖЕНИЯ КАМЕРЫ, ДЛЯ СТРЕЛЬБЫ ЖМИ ~k~~PED_FIREWEAPON~.", "Para mover el punto de mira, usa los controles de movimiento de cámara, y para disparar, pulsa ~k~~PED_FIREWEAPON~.", "Para mover el punto de mira, usa los controles de movimiento de cámara, y para disparar, pulsa ~k~~PED_FIREWEAPON~." } },
    { "RM4_1", { "~s~Get in the car with ~b~Sweet~s~.", "~s~Monte dans la caisse avec ~b~Sweet~s~.", "~s~Steig zu ~b~Sweet~s~ in den Wagen.", "~s~Sali in macchina con ~b~Sweet~s~.", "~s~Sube al coche con ~b~Sweet~s~.", "~s~Садись в машину ~b~Свита~s~.", "~s~Sube al coche con ~b~Sweet~s~.", "~s~Sube al coche con ~b~Sweet~s~." } },
    { "RM4_2", { "~s~Drive to ~y~Big Smoke's Crack Fortress~s~.", "Conduis jusqu'à la ~y~forteresse de Big Smoke~s~.", "~s~Fahr zu ~y~Big Smokes Crack-Festung~s~.", "~s~Guida fino alla ~y~Reggia del crack di Big Smoke~s~.", "~s~Conduce a la ~y~fortaleza de crack de Big Smoke~s~.", "~s~Езжай к ~y~наркоубежищу Биг Смоука~s~.", "~s~Conduce a la ~y~fortaleza de crack de Big Smoke~s~.", "~s~Conduce a la ~y~fortaleza de crack de Big Smoke~s~." } },
    { "RM4_3", { "Yo! Quit foolin' around and find a way in there!", "Yo_! Arrête de faire le con et trouve un moyen de venir jusqu'ici_!", "Yo! Lass den Quatsch und such einen Weg hinein.", "Ehi! Smettila di perdere tempo e trova il modo di entrare qui dentro!", "¡Eh! ¡Déjate de payasadas y encuentra un modo de entrar ahí dentro!", "ИО! ХВАТИТ ТЫНЯТЬСЯ И НАИДИ КАК ТУДА ПОПАСТЬ!", "¡Eh! ¡Déjate de payasadas y encuentra un modo de entrar ahí dentro!", "¡Eh! ¡Déjate de payasadas y encuentra un modo de entrar ahí dentro!" } },
    { "RM4_4", { "~s~Security is tight in the Crack Fortress. There is only one way in but the door is locked down because of the riots.", "~s~La forteresse du crack est très bien gardée, il n'y a qu'une seule entrée mais la porte est verrouillée à cause des émeutes.", "~s~Es gibt viele Wachleute in der Crack Festung. Es führt nur ein Weg hinein, aber wegen der Unruhen ist die Tür verschlossen.", "~s~La sorveglianza è strettissima, nella Fortezza. C'è solo un modo per entrare, ma la porta è chiusa a causa delle sommosse.", "~s~La seguridad es muy estricta, solo hay una forma de entrar, pero la puerta está bloqueada debido a los disturbios.", "~s~В наркоубежище Смоука серьезная охрана. Есть только один способ попасть внутрь - это дверь, но из-за беспорядков в городе ее перекрыли.", "~s~La seguridad es muy estricta, solo hay una forma de entrar, pero la puerta está bloqueada debido a los disturbios.", "~s~La seguridad es muy estricta, solo hay una forma de entrar, pero la puerta está bloqueada debido a los disturbios." } },
    { "RM4_5", { "~s~A heavy vehicle like the SWAT Tank will be able to smash down the entrance easily.", "~s~Un engin assez lourd comme le SWAT Tank pourrait facilement enfoncer la porte d'entrée.", "~s~Ein schweres Fahrzeug wie etwa ein SWAT Panzer kann den Eingang ohne weiteres einrammen.", "~s~Un veicolo pesante come il carro SWAT potrebbe sfondare l'ingresso facilmente.", "~s~Un vehículo pesado, como la tanqueta de los SWAT, podría echar abajo la entrada con facilidad.", "~s~Самый простой способ разнести его - это использовать тяжелое транспортное средство, например SWАТ Таnк.", "~s~Un vehículo pesado, como la tanqueta de los SWAT, podría echar abajo la entrada con facilidad.", "~s~Un vehículo pesado, como la tanqueta de los SWAT, podría echar abajo la entrada con facilidad." } },
    { "RM4_6", { "~s~Go get the ~b~SWAT Tank~s~.", "~s~Va chercher le ~b~SWAT Tank~s~.", "~s~Hol dir den ~b~SWAT Panzer~s~.", "~s~Vai a prendere il ~b~carro SWAT~s~.", "~s~Hazte con la ~b~tanqueta de los SWAT~s~.", "~s~Угони ~b~SWАТ Таnк~s~.", "~s~Hazte con la ~b~tanqueta de los SWAT~s~.", "~s~Hazte con la ~b~tanqueta de los SWAT~s~." } },
    { "RM4_7", { "~s~Get back in the ~b~car~s~!", "~s~Remonte dans la ~b~caisse~s~_!", "~s~Steig wieder in den ~b~Wagen~s~!", "~s~Torna in ~b~macchina~s~!", "~s~¡Vuelve a meterte en el ~b~coche~s~!", "~s~Вернись в ~b~машину~s~!", "~s~¡Vuelve a meterte en el ~b~coche~s~!", "~s~¡Vuelve a meterte en el ~b~coche~s~!" } },
    { "RM4_8", { "~s~Use the SWAT Tank to ram right through the entrance of ~y~Big Smoke's Crack Fortress~s~.", "~s~Utilise le SWAT Tank pour enfoncer la porte de la ~y~forteresse du crack de Big Smoke~s~.", "~s~Ramm den Eingang zu ~y~Big Smokes Crack Festung~s~ mit dem SWAT Panzer ein.", "~s~Usa il carro SWAT per sfondare l'ingresso della ~y~Reggia del crack di Big Smoke~s~.", "~s~Usa la tanqueta de los SWAT para embestir la entrada de la ~y~fortaleza de crack de Big Smoke~s~.", "~s~Используй SWАТ Таnк, чтобы пробить и разнести вход ~y~наркоубежища Биг Смоука~s~.", "~s~Usa la tanqueta de los SWAT para embestir la entrada de la ~y~fortaleza de crack de Big Smoke~s~.", "~s~Usa la tanqueta de los SWAT para embestir la entrada de la ~y~fortaleza de crack de Big Smoke~s~." } },
    { "RM4_9", { "You need to ram that wall right through, get back in the ~b~SWAT Tank~s~!", "Tu dois défoncer ce mur, remonte dans le ~b~SWAT Tank~s~_!", "Du musst diese Wand vollständig einrammen. Steig wieder in den ~b~SWAT Panzer~s~!", "Devi sfondare quella parete! Torna nel ~b~carro SWAT~s~!", "¡Tienes que embestir esa pared y atravesarla, vuelve a la ~b~tanqueta de los SWAT~s~!", "Ты должен проломать стену здания, вернись в ~b~SWАТ Таnк~s~!", "¡Tienes que embestir esa pared y atravesarla, vuelve a la ~b~tanqueta de los SWAT~s~!", "¡Tienes que embestir esa pared y atravesarla, vuelve a la ~b~tanqueta de los SWAT~s~!" } },
    { "RM4_10", { "~r~The SWAT Tank has been destroyed! How are you going to get into Big Smoke's Crack Fortress now?", "~r~Le SWAT Tank est bousillé, comment tu vas faire pour entrer dans la forteresse du crack de Big Smoke, maintenant_?", "~r~Der SWAT Panzer wurde zerstört. Wie willst du jetzt in Big Smokes Crack Festung kommen?", "~r~Il carro SWAT è stato distrutto, come farai ora a entrare nella Reggia del Crack di Big Smoke?", "~r~La tanqueta de los SWAT ha sido destruida, ¿ahora cómo vas a entrar en la fortaleza de crack de Big Smoke?", "~r~SWАТ Таnк уничтожен! Как ты теперь попадешь в наркоубежище Биг Смоука?", "~r~La tanqueta de los SWAT ha sido destruida, ¿ahora cómo vas a entrar en la fortaleza de crack de Big Smoke?", "~r~La tanqueta de los SWAT ha sido destruida, ¿ahora cómo vas a entrar en la fortaleza de crack de Big Smoke?" } },
