    { "WZI2_30", { "~s~Press ~k~~VEHICLE_ENTER_EXIT~ to plant the bug", "~s~Appuie sur ~k~~VEHICLE_ENTER_EXIT~ pour poser le mouchard.", "~s~Drücke ~k~~VEHICLE_ENTER_EXIT~, um die Wanze zu platzieren.", "~s~Premi ~k~~VEHICLE_ENTER_EXIT~ per piazzare la cimice.", "~s~Pulsa ~k~~VEHICLE_ENTER_EXIT~ para colocar el micro.", "~s~~k~~VEHICLE_ENTER_EXIT~ - установить жучок.", "~s~Pulsa ~k~~VEHICLE_ENTER_EXIT~ para colocar el micro.", "~s~Pulsa ~k~~VEHICLE_ENTER_EXIT~ para colocar el micro." } },
    { "WZI2_50", { "You need more practice in the water before you can start this mission.", "Faut que tu t'entraînes plus longtemps dans l'eau avant de commencer cette mission.", "Du brauchst mehr Übung im Wasser, bevor du diese Mission beginnen kannst.", "Devi allenarti di più in acqua prima di poter cominciare questa missione.", "Necesitas practicar más en el agua para poder empezar esta misión.", "Тебе нужно больше плавать под водой. Возвращайся, когда объем твоих легких повысится.", "Necesitas practicar más en el agua para poder empezar esta misión.", "Necesitas practicar más en el agua para poder empezar esta misión." } },
    { "WZI2_8", { "~s~Swim to the ~y~tanker~s~ and get aboard.", "~s~Nage jusqu'au ~y~pétrolier~s~ et monte à bord.", "~s~Schwimm zu dem ~y~Tanker~s~ und geh an Bord.", "~s~Nuota fino alla ~y~petroliera~s~ e sali a bordo.", "~s~Nada hasta el ~y~buque cisterna~s~ y sube a bordo.", "~s~Плыви к ~y~кораблю~s~ и заберись на его борт.", "~s~Nada hasta el ~y~buque cisterna~s~ y sube a bordo.", "~s~Nada hasta el ~y~buque cisterna~s~ y sube a bordo." } },
    { "WZI2_31", { "~s~Lose the attention of the ~r~guards~s~ before you plant the bug.", "~s~Les ~r~gardes~s~ doivent pas te remarquer pour que tu puisses poser le mouchard.", "~s~Sorg dafür, dass die ~r~Wachmänner~s~ nicht mehr auf dich achten, bevor du die Wanze platzierst.", "~s~Eludi le ~r~guardie~s~ prima di piazzare la cimice.", "~s~Líbrate de la atención de los ~r~guardias~s~ antes de colocar el micro.", "~s~Избавься от внимания ~r~охранников~s~, чтобы установить жучок.", "~s~Líbrate de la atención de los ~r~guardias~s~ antes de colocar el micro.", "~s~Líbrate de la atención de los ~r~guardias~s~ antes de colocar el micro." } },
    { "WZI2_32", { "~s~You have planted the bug! Get off the tanker and back to the ~y~docks~s~.", "~s~T'as posé le mouchard. Barre-toi du bateau et reviens sur les ~y~quais~s~_!", "~s~Du hast die Wanze platziert. Verlasse den Tanker und begib dich wieder zu den ~y~Docks~s~.", "~s~Hai piazzato la cimice, scendi dalla nave e torna al ~y~porto~s~.", "~s~Has colocado el micro, sal del buque cisterna y vuelve a los ~y~muelles~s~.", "~s~Ты установил жучок! Выбирайся с корабля и плыви к ~y~причалу~s~.", "~s~Has colocado el micro, sal del buque cisterna y vuelve a los ~y~muelles~s~.", "~s~Has colocado el micro, sal del buque cisterna y vuelve a los ~y~muelles~s~." } },
    { "WZI2_35", { "~s~Sneak to the back of the tanker and plant the ~y~bug~s~, be as quiet as possible to avoid the attention of the ~r~guards~s~ onboard.", "~s~Faufile-toi jusqu'à l'arrière du bateau et pose le ~y~mouchard~s~. Sois très discret pour éviter d'attirer l'attention des ~r~gardes~s~ à bord.", "~s~Schleich dich in den hinteren Teil des Tankers und platziere die ~y~Wanze~s~. Sei möglichst leise, um nicht die Aufmerksamkeit der ~r~Wachmänner~s~ an Bord zu erregen.", "~s~Raggiungi la poppa della petroliera e piazza la ~y~cimice~s~, fallo in silenzio per evitare che le ~r~guardie~s~ a bordo s'insospettiscano.", "~s~Cuélate por la parte de atrás del buque cisterna y coloca el ~y~micro~s~. Sé lo más silencioso que puedas para no llamar la atención de los ~r~guardias~s~ de a bordo.", "~s~Проберись на корму корабля и установи ~y~жучок~s~, веди себя тихо, чтобы не привлекать внимания ~r~охранников~s~, находящихся на палубе.", "~s~Cuélate por la parte de atrás del buque cisterna y coloca el ~y~micro~s~. Sé lo más silencioso que puedas para no llamar la atención de los ~r~guardias~s~ de a bordo.", "~s~Cuélate por la parte de atrás del buque cisterna y coloca el ~y~micro~s~. Sé lo más silencioso que puedas para no llamar la atención de los ~r~guardias~s~ de a bordo." } },
    { "WZI2_40", { "The main route across the water is guarded by two patrol boats. If they spot you, dive underwater to lose their attention.", "Le principal itinéraire dans l'eau est gardé par deux bateaux en patrouille. S'ils te repèrent, plonge sous l'eau pour qu'ils ne te voient plus.", "Die Hauptroute über das Wasser wird von zwei Patrouillenbooten bewacht. Wenn sie dich bemerken, tauch unter, damit sie nicht mehr auf dich achten.", "Il percorso principale è controllato da due imbarcazioni di pattuglia. Se ti avvistano, nuota sott'acqua per far perdere le tue tracce.", "La ruta principal cruzando el agua está protegida por dos botes patrulla. Si te ven, sumérgete para despistar su atención.", "Путь к кораблю лежит через зону, патрулируемую двумя лодками. Если они тебя заметят, ныряй под воду, чтобы избавиться от их внимания.", "La ruta principal cruzando el agua está protegida por dos botes patrulla. Si te ven, sumérgete para despistar su atención.", "La ruta principal cruzando el agua está protegida por dos botes patrulla. Si te ven, sumérgete para despistar su atención." } },
    { "WZI2_41", { "Don't swim on the surface of the water or you will be spotted.", "Ne nage pas à la surface, sinon tu vas te faire repérer.", "Schwimm nicht an der Wasseroberfläche, sonst wird man dich bemerken.", "Non nuotare in superficie, altrimenti verrai avvistato.", "No nades en la superficie del agua, o te verán.", "Не плыви на поверхности воды, иначе тебя заметят.", "No nades en la superficie del agua, o te verán.", "No nades en la superficie del agua, o te verán." } },
