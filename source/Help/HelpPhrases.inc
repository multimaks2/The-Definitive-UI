    { "SSTFLY0", { "~h~Flying Skill~w~ - Upgraded. Keep practising and you will receive a pilots licence.", "~h~Habileté en pilotage_:~w~ améliorée. Continue à t'entraîner pour obtenir ton brevet de pilote.", "~h~Flug-Skill~w~ verbessert. Trainiere weiter und du erhältst den Pilotenschein.", "~h~Abilità di pilotaggio~w~ - Migliorata. Continua ad allenarti e riceverai il brevetto di volo.", "~h~Habilidad de vuelo~w~ mejorada. Sigue practicando y recibirás una licencia de piloto.", "~h~Навык пилота~w~ улучшен. Больше практикуйся - и ты получишь удостоверение пилота.", "~h~Habilidad de vuelo~w~ mejorada. Sigue practicando y recibirás una licencia de piloto.", "~h~Habilidad de vuelo~w~ mejorada. Sigue practicando y recibirás una licencia de piloto." } },
    { "SSTFLY1", { "~h~Flying Skill~w~ - Upgraded. Pilots licence obtained. You can now access all airports.", "~h~Habileté en pilotage_:~w~ améliorée. T'as eu ton brevet de pilote. Il te donne accès à tous les aéroports.", "~h~Flug-Skill~w~ verbessert. Pilotenschein erhalten. Du hast nun Zutritt zu allen Flughäfen.", "~h~Abilità di pilotaggio~w~ - Migliorata. Hai ottenuto il brevetto di volo e puoi accedere a tutti gli aeroporti.", "~h~Habilidad de vuelo~w~ mejorada. Licencia de piloto obtenida. Ahora puedes acceder a todos los aeropuertos.", "~h~Навык пилота~w~ улучшен. Получено удостоверение пилота. Теперь у тебя есть доступ во все аэропорты.", "~h~Habilidad de vuelo~w~ mejorada. Licencia de piloto obtenida. Ahora puedes acceder a todos los aeropuertos.", "~h~Habilidad de vuelo~w~ mejorada. Licencia de piloto obtenida. Ahora puedes acceder a todos los aeropuertos." } },
    { "SWPIST", { "~h~Pistol Skill~w~ - Gangster level reached. Lock-on range, accuracy and rate of fire have all increased.", "~h~Habileté pistolet_:~w~ niveau Gangster atteint. La portée de ta visée automatique, ta précision et ta cadence de tir ont augmenté.", "~h~Pistolen-Skill~w~ - Gangster-Level erreicht. Du kannst jetzt weiter entfernte Ziele anvisieren. Deine Treffsicherheit und Feuerrate haben sich erhöht.", "~h~Abilità con la pistola~w~ - Hai raggiunto il livello di gangster. Precisione, portata e rapidità di tiro sono aumentate.", "~h~Habilidad con pistola~w~ a nivel de gánster. Tu alcance para fijar blanco, precisión, cadencia de disparo y velocidad de desplazamiento lateral han aumentado.", "~h~Владение пистолетом~w~ - достигнут уровень гангстера. Твои дальность попадания, скорострельность и точность стрельбы увеличены.", "~h~Habilidad con pistola~w~ a nivel de gánster. Tu alcance para fijar blanco, precisión, cadencia de disparo y velocidad de desplazamiento lateral han aumentado.", "~h~Habilidad con pistola~w~ a nivel de gánster. Tu alcance para fijar blanco, precisión, cadencia de disparo y velocidad de desplazamiento lateral han aumentado." } },
    { "SWPIPR", { "~h~Pistol Skill~w~ - Hitman level reached. You can now wield two pistols simultaneously and your lock-on range has increased.", "~h~Habileté pistolet_:~w~ niveau Tueur atteint. Tu peux maintenant utiliser 2 pistolets en même temps. La portée de ta visée automatique a augmenté.", "~h~Pistolen-Skill~w~ - Hit-Man-Level erreicht. Du kannst jetzt mit 2 Pistolen gleichzeitig schießen und weiter entfernte Ziele anvisieren.", "~h~Abilità con la pistola~w~ - Hai raggiunto il livello di killer. Puoi impugnare due pistole e la portata è aumentata.", "~h~Habilidad con pistola~w~ a nivel de asesino. Ahora puedes empuñar dos pistolas a la vez y tienes más alcance para fijar blanco.", "~h~Владение пистолетом~w~ - достигнут уровень убийцы. Теперь ты сможешь стрелять одновременно из двух пистолетов, а твоя дальность попадания увеличена.", "~h~Habilidad con pistola~w~ a nivel de asesino. Ahora puedes empuñar dos pistolas a la vez y tienes más alcance para fijar blanco.", "~h~Habilidad con pistola~w~ a nivel de asesino. Ahora puedes empuñar dos pistolas a la vez y tienes más alcance para fijar blanco." } },
