    { "CONS_3B", { "Press ~k~~PED_JUMPING~ to raise the magnet.", "Appuie sur ~k~~PED_JUMPING~ pour élever l'aimant.", "Drücke ~k~~PED_JUMPING~, um den Magneten anzuheben.", "Premi ~k~~PED_JUMPING~ per alzare il magnete.", "Pulsa ~k~~PED_JUMPING~ para subir el imán.", "~k~~PED_JUMPING~ - поднять магнит.", "Pulsa ~k~~PED_JUMPING~ para subir el imán.", "Pulsa ~k~~PED_JUMPING~ para subir el imán." } },
