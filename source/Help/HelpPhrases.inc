    { "VAL_40", { "~r~You destroyed the D.A.'s car!", "~r~T'as bousillé la bagnole du procureur_!", "~r~Du hast den Wagen des Staatsanwalts zerstört!", "~r~Hai distrutto la macchina del pubblico ministero!", "~r~¡Has destruido el coche del fiscal!", "~r~Ты уничтожил машину прокурора!", "~r~¡Has destruido el coche del fiscal!", "~r~¡Has destruido el coche del fiscal!" } },
