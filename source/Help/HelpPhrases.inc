    { "STP3_19", { "~s~Damage the ~r~car~s~ to force the driver out.", "~s~Bousille la ~r~caisse~s~ pour forcer le chauffeur à sortir.", "~s~Beschädige das ~r~Auto~s~, um den Fahrer zum Aussteigen zu zwingen.", "~s~Danneggia l'~r~auto~s~ per costringere l'autista a uscire.", "~s~Daña el ~r~coche~s~ para obligar al conductor a salir.", "~s~Повреди ~r~машину~s~, чтобы водитель вышел из нее.", "~s~Daña el ~r~coche~s~ para obligar al conductor a salir.", "~s~Daña el ~r~coche~s~ para obligar al conductor a salir." } },
    { "STP3_20", { "~r~You were too slow! Madd Dogg's other cars have left without you.", "~r~T'as été trop lent_! Les autres caisses de Madd Dogg sont parties sans toi.", "~r~Du warst zu langsam! Die anderen Autos von Madd Dogg sind ohne dich losgefahren.", "~r~Troppo lento! Le altre vetture di Madd Dogg se ne sono andate senza di te.", "~r~¡Has sido demasiado lento! Los otros coches de Madd Dogg se han ido sin ti.", "~r~Ты опоздал! Остальные машины Мэдд Догга уехали без тебя.", "~r~¡Has sido demasiado lento! Los otros coches de Madd Dogg se han ido sin ti.", "~r~¡Has sido demasiado lento! Los otros coches de Madd Dogg se han ido sin ti." } },
    { "STP3_21", { "~r~You were too slow! Madd Dogg's cars have left!", "~r~T'as été trop lent_! Les caisses de Madd Dogg sont parties_!", "~r~Du warst zu langsam! Madd Doggs Autos sind weg!", "~r~Troppo lento! Le macchine di Madd Dogg se ne sono andate!", "~r~¡Has sido demasiado lento! ¡Los coches de Madd Dogg se han ido!", "~r~Ты опоздал! Машины Мэдд Догга уехали!", "~r~¡Has sido demasiado lento! ¡Los coches de Madd Dogg se han ido!", "~r~¡Has sido demasiado lento! ¡Los coches de Madd Dogg se han ido!" } },
    { "STP3_22", { "~s~The car is damaged, go and get it repaired.", "~s~La caisse est niquée_! Va la faire réparer_!", "~s~Das Auto ist beschädigt. Sorg dafür, dass es repariert wird.", "~s~La macchina è danneggiata, vai a farla riparare.", "~s~El coche está dañado: llévalo a reparar.", "~s~Машина повреждена, почини ее.", "~s~El coche está dañado: llévalo a reparar.", "~s~El coche está dañado: llévalo a reparar." } },
