    { "VAL_B6", { "~r~The customer's car was destroyed.", "~r~La caisse du client a été détruite.", "~r~Das Auto des Kunden wurde zerstört.", "~r~La macchina del cliente è stata distrutta.", "~r~El coche del cliente ha sido destruido.", "~r~Машина уничтожена.", "~r~El coche del cliente ha sido destruido.", "~r~El coche del cliente ha sido destruido." } },
    { "VAL_B3", { "~s~The cops are on to you. Clear the heat before following the valet in to the car park.", "~s~Les flics sont à tes trousses_! Sème-les avant de suivre le voiturier dans le parking.", "~s~Die Bullen sind hinter dir her. Häng sie ab, bevor du dem Park-Boy zu der Parkgarage folgst.", "~s~Hai addosso i poliziotti. Liberati delle loro attenzioni prima di seguire il parcheggiatore nel parcheggio.", "~s~La poli va a por ti. Líbrate de la presión policial antes de seguir al aparcacoches a la zona de coches.", "~s~Тобой заинтересовались копы. Избавься от них, после чего езжай на стоянку отеля.", "~s~La poli va a por ti. Líbrate de la presión policial antes de seguir al aparcacoches a la zona de coches.", "~s~La poli va a por ti. Líbrate de la presión policial antes de seguir al aparcacoches a la zona de coches." } },
    { "VAL_B4", { "~r~The cops saw you entering the car park.", "~r~Les flics t'ont vu entrer dans le parking.", "~r~Die Bullen haben gesehen, wie du die Parkgarage betreten hast.", "~r~I poliziotti ti hanno visto entrare nel parcheggio.", "~r~La poli te ha visto entrar en la zona de coches.", "~r~Копы видели, как ты заехал на стоянку.", "~r~La poli te ha visto entrar en la zona de coches.", "~r~La poli te ha visto entrar en la zona de coches." } },
    { "VAL_B5", { "~r~You're wanted by the cops. Now your cover's blown.", "~r~T'es recherché par les flics. Ta couverture est foutue.", "~r~Die Bullen suchen dich. Jetzt ist deine Tarnung aufgeflogen.", "~r~Sei ricercato dai poliziotti: la tua copertura è saltata.", "~r~La poli te busca. Tu tapadera se ha descubierto.", "~r~Тебя ищут копы. Твое прикрытие раскусили.", "~r~La poli te busca. Tu tapadera se ha descubierto.", "~r~La poli te busca. Tu tapadera se ha descubierto." } },
    { "VAL_B1", { "~r~You no longer have the valet uniform.", "~r~T'as plus d'uniforme de voiturier.", "~r~Du hast die Parkservice-Uniform nicht mehr.", "~r~Non possiedi più l'uniforme da parcheggiatore.", "~r~Ya no tienes el uniforme de aparcacoches.", "~r~У тебя больше нет униформы лакея.", "~r~Ya no tienes el uniforme de aparcacoches.", "~r~Ya no tienes el uniforme de aparcacoches." } },
    { "VAL_B2", { "~r~The car's visibly damaged. It's too late to get it fixed.", "~r~La caisse est visiblement endommagée. C'est trop tard pour la faire réparer.", "~r~Der Wagen ist sichtlich beschädigt. Es ist zu spät, ihn reparieren zu lassen.", "~r~La vettura è visibilmente danneggiata. È troppo tardi per farla riparare.", "~r~El coche está visiblemente dañado. Es demasiado tarde para arreglarlo.", "~r~Машина очень сильно повреждена. Уже поздно будет чинить ее.", "~r~El coche está visiblemente dañado. Es demasiado tarde para arreglarlo.", "~r~El coche está visiblemente dañado. Es demasiado tarde para arreglarlo." } },
    { "VAL_A30", { "~s~A valet is coming to return the D.A.'s car. Get ~y~outside~s~ the valet car park and call the cops.", "~s~Un voiturier arrive pour ramener la caisse du procureur. Va ~y~devant~s~ l'auvent des voituriers pour appeler les flics.", "~s~Ein Park-Boy kommt, um den Wagen des Staatsanwalts zurückzubringen. Begib dich raus zum Car Port des Parkservice und rufe die Cops an.", "~s~Un parcheggiatore sta tornando per consegnare la vettura del procuratore distrettuale. ~y~Esci~s~ dal parcheggio e chiama i poliziotti.", "~s~Un aparcacoches viene a devolver el coche del fiscal. ~y~Sal~s~ de la zona de aparcacoches y llama a la policía.", "~s~Лакей идет, чтобы забрать машину прокурора. Выходи с ~y~территории~s~ стоянки и позвони копам.", "~s~Un aparcacoches viene a devolver el coche del fiscal. ~y~Sal~s~ de la zona de aparcacoches y llama a la policía.", "~s~Un aparcacoches viene a devolver el coche del fiscal. ~y~Sal~s~ de la zona de aparcacoches y llama a la policía." } },
    { "VAL_A34", { "~r~You were too slow. The D.A. picked up his car.", "~r~T'as pas été assez rapide. Le procureur a récupéré sa caisse.", "~r~Du warst zu langsam. Der Staatsanwalt hat seinen Wagen abgeholt.", "~r~Sei stato troppo lento. Il procuratore distrettuale ha ripreso la sua vettura.", "~r~Demasiado lento. El fiscal ha recogido su coche.", "~r~Ты опоздал. Прокурор забрал свою машину.", "~r~Demasiado lento. El fiscal ha recogido su coche.", "~r~Demasiado lento. El fiscal ha recogido su coche." } },
    { "VAL_A35", { "~r~You've resprayed the car. The D.A. may notice the difference!", "~r~T'as repeint la caisse. Le procureur va s'en rendre compte_!", "~r~Du hast den Wagen umlackiert. Der Staatsanwalt könnte den Unterschied bemerken!", "~r~Hai riverniciato la vettura. Il procuratore distrettuale potrebbe notare la differenza!", "~r~Has repintado el coche. ¡El fiscal podría darse cuenta de la diferencia!", "~r~Ты перекрасил машину. Прокурор может заметить разницу!", "~r~Has repintado el coche. ¡El fiscal podría darse cuenta de la diferencia!", "~r~Has repintado el coche. ¡El fiscal podría darse cuenta de la diferencia!" } },
    { "VAL_A1", { "~r~You've given yourself away.", "~r~Tu t'es fait découvrir.", "~r~Du hast dich verraten.", "~r~Ti stai buttando via.", "~r~Has dejado que te descubran.", "~r~Ты ушел с территории отеля.", "~r~Has dejado que te descubran.", "~r~Has dejado que te descubran." } },
