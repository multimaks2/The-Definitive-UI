    { "DRV6_1", { "~s~Go and pick up the ~b~decoy car.", "~s~Va chercher la ~b~caisse qui servira de leurre~s~.", "~s~Hol das ~b~Lockvogel-Fahrzeug~s~ ab.", "~s~Recupera una ~b~macchina esca.", "~s~Ve a recoger el ~b~coche señuelo.", "~s~Садись в ~b~машину-приманку.", "~s~Ve a recoger el ~b~coche señuelo.", "~s~Ve a recoger el ~b~coche señuelo." } },
    { "DRV6_4", { "~s~If the doors get too damaged, the bikers will be able to see into the car.", "~s~Si les portières sont trop endommagées, les bikers pourront voir l'intérieur de la caisse.", "~s~Werden die Türen zu stark beschädigt, können die Biker in das Auto sehen.", "~s~Se le portiere si danneggeranno troppo, i motociclisti saranno in grado di vedere dentro l'auto.", "~s~Si las puertas se dañan demasiado, los motoristas podrán ver el interior del coche.", "~s~Если двери будут сильно повреждены, байкеры могут увидеть, кто находится внутри машины.", "~s~Si las puertas se dañan demasiado, los motoristas podrán ver el interior del coche.", "~s~Si las puertas se dañan demasiado, los motoristas podrán ver el interior del coche." } },
