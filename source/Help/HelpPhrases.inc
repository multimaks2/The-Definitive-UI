    { "RM4_26", { "Studio lights off!", "Spots éteints_!", "Studiobeleuchtung aus!", "Luci dello studio spente!", "¡Se han apagado las luces!", "ОГНИ ПОГАСЛИ!", "¡Se han apagado las luces!", "¡Se han apagado las luces!" } },
    { "RM4_27", { "Ahh, I'm blinded!", "Ahh, j'y vois plus rien_!", "Ahh, ich kann nichts mehr sehen!", "Ahh! Non ci vedo più!", "¡Ahh, no veo una mierda!", "АААА, Я ОСЛЕП!", "¡Ahh, no veo una mierda!", "¡Ahh, no veo una mierda!" } },
    { "RM4_29", { "Don't just stand there Get him boys!", "Restez pas plantés là, attrapez-le, les gars_!", "Steht nicht dumm rum! Schnappt ihn euch, Jungs!", "Non state lì senza far nulla. Prendetelo ragazzi!", "¡No os quedéis ahí, a por él, muchachos!", "ЧТО ТЫ ТАМ СТОИШЬ. ВЗЯТЬ ЕГО, ПАРНИ!", "¡No os quedéis ahí, a por él, muchachos!", "¡No os quedéis ahí, a por él, muchachos!" } },
    { "RM4_30", { "Good shot but let's see if you're that good in the dark!", "Joli tir mais voyons si t'es toujours aussi bon dans le noir_!", "Guter Schuss! Aber mal sehen. ob du im Dunkeln auch so gut triffst!", "Bel colpo, ma veniamo se riesci a essere così bravo anche al buio!", "Buen disparo, pero vamos a ver si eres tan bueno a oscuras.", "ХОРОШИИ ВЫСТРЕЛ НО ДАВАИ ПОСМОТРИМ ТАК ЖЕ ТЫ МЕТКО СТРЕЛЯЕШЬ В ТЕМНОТЕ!", "Buen disparo, pero vamos a ver si eres tan bueno a oscuras.", "Buen disparo, pero vamos a ver si eres tan bueno a oscuras." } },
    { "RM4_31", { "~s~Smoke has switched the lights off go get the ~g~thermal goggles ~s~by the lower window.", "~s~Smoke a éteint la lumière, va chercher les ~g~lunettes de vision nocturne ~s~près de la fenêtre la plus basse.", "~s~Smoke hat das Licht ausgeschaltet. Hol dir das ~g~Thermo-Sichtgerät~s~ beim unteren Fenster.", "~s~Smoke ha spento le luci. Vai a prendere il ~g~visore notturno ~s~vicino la finestra di sotto.", "~s~Smoke ha apagado las luces, coge las ~g~gafas térmicas ~s~que hay en la ventana inferior.", "~s~Смоук вырубил свет, подбери ~g~прибор теплового видения~s~ у окна.", "~s~Smoke ha apagado las luces, coge las ~g~gafas térmicas ~s~que hay en la ventana inferior.", "~s~Smoke ha apagado las luces, coge las ~g~gafas térmicas ~s~que hay en la ventana inferior." } },
    { "RM4_33", { "~s~Use the night vision goggles you have just picked up from Big Smoke to help you see in the dark and ~y~escape ~s~the building as quick as possible.", "~s~Utilise les lunettes de vision nocturne que tu viens de chourer à Big Smoke pour voir dans le noir et t'~y~enfuir ~s~du bâtiment le plus vite possible.", "~s~Benutze das Nachtsichtgerät, das du gerade von Big Smoke ergattert hast, um im Dunkeln zu sehen und das Gebäude so schnell wie möglich zu ~y~verlassen~s~.", "~s~Usa il visore notturno che hai appena preso da Big Smoke per poter vedere al buio e ~y~fuggire ~s~dall'edificio il più rapidamente possibile.", "~s~Usa las gafas de visión nocturna que has conseguido de Big Smoke para ayudarte a ver en la oscuridad y ~y~escapar ~s~del edificio tan rápido como puedas.", "~s~Используй прибор ночного видения, который ты подобрал у тела Биг Смоука (он поможет тебе видеть в темноте), чтобы покинуть ~y~здание~s~ как можно быстрее.", "~s~Usa las gafas de visión nocturna que has conseguido de Big Smoke para ayudarte a ver en la oscuridad y ~y~escapar ~s~del edificio tan rápido como puedas.", "~s~Usa las gafas de visión nocturna que has conseguido de Big Smoke para ayudarte a ver en la oscuridad y ~y~escapar ~s~del edificio tan rápido como puedas." } },
    { "RM4_34", { "Time", "Temps", "Zeit", "Tempo", "Tiempo", "Время", "Tiempo", "Tiempo" } },
    { "RM4_35", { "~s~This floor is on fire use a ~g~fire extinguisher ~s~to help you get out!", "~s~Cet étage est en flammes, utilise un ~g~extincteur ~s~pour sortir de là_!", "~s~Diese Etage steht in Brand. Benutze einen ~g~Feuerlöscher~s~, um hier rauszukommen!", "~s~Questo piano è in fiamme, usa un ~g~estintore ~s~per uscire!", "~s~¡Este piso está en llamas, usa un ~g~extintor ~s~para salir de ella!", "~s~На этом этаже бушует пожар, используй ~g~огнетушитель~s~, чтобы пройти через огонь!", "~s~¡Este piso está en llamas, usa un ~g~extintor ~s~para salir de ella!", "~s~¡Este piso está en llamas, usa un ~g~extintor ~s~para salir de ella!" } },
    { "RM4_37", { "Burn, CJ!", "Tu vas cramer, CJ_!", "Brenn, CJ!", "Brucia, CJ!", "¡Arde, CJ!", "ГОРИ, СИДЖЕИ!", "¡Arde, CJ!", "¡Arde, CJ!" } },
    { "RM4_38", { "~s~Tenpenny has caused an explosion, the lighting in the building is off and the whole place is beginning to burn down. You need to get out of here quick!", "~s~Tenpenny a provoqué une explosion, il n'y a plus de lumière dans le bâtiment et l'immeuble commence à flamber de partout. Faut te tirer de là vite fait_!", "~s~Tenpenny hat eine Explosion ausgelöst. Die Beleuchtung im Gebäude ist ausgefallen. Es brennt ab. Du musst schnell hier raus!", "~s~Tenpenny ha provocato un'esplosione, l'illuminazione dell'edificio è saltata e l'intero posto è in fiamme. Devi fuggire da qui in fretta!", "~s~Tenpenny ha causado una explosión, las luces del edificio se han apagado y todo el sitio está empezando a incendiarse. ¡Tienes que salir rápido de aquí!", "~s~Тенпенни устроил пожар, из-за чего освещение вырубилось, а все здание скоро взорвется. Ты должен поскорее выбираться оттуда!", "~s~Tenpenny ha causado una explosión, las luces del edificio se han apagado y todo el sitio está empezando a incendiarse. ¡Tienes que salir rápido de aquí!", "~s~Tenpenny ha causado una explosión, las luces del edificio se han apagado y todo el sitio está empezando a incendiarse. ¡Tienes que salir rápido de aquí!" } },
    { "RM4_39", { "Smoke's Health", "Smoke", "Smoke", "Salute di Smoke", "Smoke", "Смоук", "Smoke", "Smoke" } },
    { "RM4_41", { "~s~Follow Tenpenny and make sure ~b~Sweet ~s~is safe, stay close to the firetruck and do not lose Tenpenny.", "~s~Suis Tenpenny et assure-toi que ~b~Sweet ~s~est en sécurité, reste près du camion de pompiers et perds pas Tenpenny.", "Folge Tenpenny und sorge dafür, dass ~b~Sweet~s~ nichts passiert. Bleib dicht an dem Feuerwehrwagen dran und lass dich von Tenpenny nicht abhängen.", "~s~Segui Tenpenny e assicurati che ~b~Sweet ~s~sia in salvo. Stai vicino all'autopompa e non perdere Tenpenny.", "~s~Sigue a Tenpenny y asegúrate de que ~b~Sweet ~s~está a salvo. Mantente cerca del coche de bomberos y no pierdas a Tenpenny.", "~s~Следуй за Тенпенни и убедись, что ~b~Свит~s~ в порядке. Не отставай от пожарной машины, чтобы не упустить Тенпенни.", "~s~Sigue a Tenpenny y asegúrate de que ~b~Sweet ~s~está a salvo. Mantente cerca del coche de bomberos y no pierdas a Tenpenny.", "~s~Sigue a Tenpenny y asegúrate de que ~b~Sweet ~s~está a salvo. Mantente cerca del coche de bomberos y no pierdas a Tenpenny." } },
    { "RM4_42", { "~s~Do not attempt to damage the firetruck or you may injure ~b~Sweet~s~.", "~s~N'essaie pas d'endommager le camion de pompiers, tu risquerais de blesser ~b~Sweet~s~.", "~s~Versuche nicht, den Feuerwehrwagen zu rammen. Du könntest ~b~Sweet~s~ sonst verletzen.", "~s~Non tentare di danneggiare l'autopompa: potresti ferire ~b~Sweet~s~.", "~s~No intentes dañar el coche de bomberos o podrías herir a ~b~Sweet~s~.", "~s~Не пытайся таранить пожарную машину, ты можешь причинить вред ~b~Свиту~s~.", "~s~No intentes dañar el coche de bomberos o podrías herir a ~b~Sweet~s~.", "~s~No intentes dañar el coche de bomberos o podrías herir a ~b~Sweet~s~." } },
    { "RM4_43", { "~s~The cop is stamping on ~s~Sweet's fingers get your car close to him in case he loses his grip.", "~s~Le flic écrase les ~s~doigts de Sweet, rapproche ta caisse de lui au cas où il lâcherait prise.", "~s~Der Cop tritt ~b~Sweet~s~ auf die Finger. Bring deinen Wagen nahe an ihn heran, falls er sich nicht mehr halten kann.", "~s~Il poliziotto sta schiacciando le ~s~dita di Sweet. Porta la tua macchina più vicino in caso perda la presa.", "~s~El poli está pisándole los ~s~dedos a Sweet, acércale el coche por si se suelta.", "~s~Коп пытается сбросить Свита с лестницы, наступая на его пальцы. Держи свою машину прямо под ним, пока его хватка не ослабла.", "~s~El poli está pisándole los ~s~dedos a Sweet, acércale el coche por si se suelta.", "~s~El poli está pisándole los ~s~dedos a Sweet, acércale el coche por si se suelta." } },
    { "RM4_44", { "~b~Sweet ~s~is about to lose his grip get your car directly underneath the end of the ladder and catch ~s~Sweet ~s~before he loses his grip!", "~b~Sweet ~s~va bientôt lâcher prise, amène ta caisse au-dessous de l'extrémité de l'échelle et rattrape ~s~Sweet ~s~avant qu'il se casse la gueule_!", "~s~Gleich kann ~b~Sweet~s~ sich nicht mehr halten. Bring deinen Wagen direkt unter die Leiter und fang ~b~Sweet~s~ auf, bevor er den Halt verliert!", "~b~Sweet ~s~sta per perdere la presa! Porta la tua macchina al di sotto della scaletta e prendi ~s~Sweet ~s~prima che sia troppo tardi!", "~b~Sweet ~s~está a punto de soltarse, ¡pon el coche justo debajo del final de la escalera y atrápalo antes de que se caiga!", "~b~Свит~s~ вот-вот разожмет пальцы, подведи машину под конец лестницы, чтобы поймать ~s~Свита~s~ до того, как он упадет!", "~b~Sweet ~s~está a punto de soltarse, ¡pon el coche justo debajo del final de la escalera y atrápalo antes de que se caiga!", "~b~Sweet ~s~está a punto de soltarse, ¡pon el coche justo debajo del final de la escalera y atrápalo antes de que se caiga!" } },
    { "RM4_45", { "~r~Sweet died! You are supposed to catch him, next time get your car underneath Sweet when he begins to lose grip!", "~r~Sweet est mort_! T'étais censé le rattraper. La prochaine fois, amène ta voiture en dessous de lui pour le rattraper dès qu'il lâchera prise_!", "~r~Sweet ist tot! Du sollst ihn auffangen. Bring deinen Wagen das nächste Mal unter Sweet, wenn er droht, den Halt zu verlieren!", "~r~Sweet è morto! Dovevi prenderlo! La prossima volta porta la macchina sotto di lui prima che perda la presa!", "~r~¡Sweet ha muerto! Se supone que tienes que cogerlo. ¡La próxima vez ponle coche debajo cuando empiece a soltarse!", "~r~Свит мертв! Ты должен был поймать его. В следующий раз он должен находиться над капотом твоей машины прежде, чем он сорвется с лестницы!", "~r~¡Sweet ha muerto! Se supone que tienes que cogerlo. ¡La próxima vez ponle coche debajo cuando empiece a soltarse!", "~r~¡Sweet ha muerto! Se supone que tienes que cogerlo. ¡La próxima vez ponle coche debajo cuando empiece a soltarse!" } },
