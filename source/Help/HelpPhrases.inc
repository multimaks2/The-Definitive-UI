    { "CONS_5", { "Press ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ to change camera view.", "Appuie sur ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ pour changer d'angle de vue.", "Drücke ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~, um den Blickwinkel zu ändern.", "Premi ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ per cambiare visuale.", "Pulsa ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ para cambiar la vista de la cámara.", "~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ - сменить вид камеры.", "Pulsa ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ para cambiar la vista de la cámara.", "Pulsa ~k~~CAMERA_CHANGE_VIEW_ALL_SITUATIONS~ para cambiar la vista de la cámara." } },
    { "CRA1_35", { "Aim fire extinguisher at the base of a fire to put it out.", "Dirige l'extincteur sur la source d'un feu pour l'éteindre.", "Richte den Feuerlöscher auf den Kern eines Feuers, um es zu löschen.", "Punta l'estintore verso la base delle fiamme per spegnerle.", "Apunta el extintor a la base de las llamas para apagarlas.", "Наведи огнетушитель на основную часть пламени, чтобы потушить его.", "Apunta el extintor a la base de las llamas para apagarlas.", "Apunta el extintor a la base de las llamas para apagarlas." } },
    { "CRO_GOT", { "The croupier uniform has been delivered to your wardrobe!", "L'uniforme de croupier a été livré dans ta penderie_!", "Die Croupier-Uniform steht ab jetzt in deinem Kleiderschrank zur Verfügung!", "L'uniforme da croupier è stata inviata al tuo guardaroba!", "Se ha llevado a tu ropero el uniforme de crupier.", "Униформа крупье доставлена в твой гардероб!", "Se ha llevado a tu ropero el uniforme de crupier.", "Se ha llevado a tu ropero el uniforme de crupier." } },
    { "CR_2", { "~k~~VEHICLE_ENTER_EXIT~ Enter Crane", "~k~~VEHICLE_ENTER_EXIT~ Monter dans la grue", "~k~~VEHICLE_ENTER_EXIT~: In Kran steigen", "~k~~VEHICLE_ENTER_EXIT~ Sali sulla gru", "~k~~VEHICLE_ENTER_EXIT~ Subir a la grúa", "~k~~VEHICLE_ENTER_EXIT~ - залезть на кран.", "~k~~VEHICLE_ENTER_EXIT~ Subir a la grúa", "~k~~VEHICLE_ENTER_EXIT~ Subir a la grúa" } },
    { "CR_3", { "~k~~VEHICLE_ENTER_EXIT~ Exit Crane", "~k~~VEHICLE_ENTER_EXIT~ Sortir de la grue", "~k~~VEHICLE_ENTER_EXIT~: Aus Kran aussteigen", "~k~~VEHICLE_ENTER_EXIT~ Scendi dalla gru", "~k~~VEHICLE_ENTER_EXIT~ Bajar de la grúa", "~k~~VEHICLE_ENTER_EXIT~ - покинуть кран.", "~k~~VEHICLE_ENTER_EXIT~ Bajar de la grúa", "~k~~VEHICLE_ENTER_EXIT~ Bajar de la grúa" } },
    { "CSH3_10", { "If you press ~k~~PED_LOCK_TARGET~ while armed with a gun you can strafe.", "Si tu appuies sur ~k~~PED_LOCK_TARGET~ alors que tu es armé, tu peux te déplacer latéralement.", "Wenn du eine Schusswaffe aktiviert hast und ~k~~PED_LOCK_TARGET~ drückst, kannst du dich seitwärts bewegen.", "Se premi ~k~~PED_LOCK_TARGET~ impugnando un'arma da fuoco, puoi effettuare uno spostamento laterale.", "Si pulsas ~k~~PED_LOCK_TARGET~ mientras estés armado, puedes desplazarte lateralmente.", "Если нажать ~k~~PED_LOCK_TARGET~, когда у тебя в руках оружие, ты сможешь стрейфиться.", "Si pulsas ~k~~PED_LOCK_TARGET~ mientras estés armado, puedes desplazarte lateralmente.", "Si pulsas ~k~~PED_LOCK_TARGET~ mientras estés armado, puedes desplazarte lateralmente." } },
    { "CSH3_11", { "When strafing you can manually aim and shoot by using the camera movement controls.", "Lorsque tu te déplaces latéralement, tu peux viser manuellement avec les contrôles de mouvement de la caméra et tirer.", "Während du dich seitwärts bewegst, kannst du mit der Kamerakontrolle manuell zielen und schießen.", "Spostandoti lateralmente, puoi mirare manualmente e sparare usando i comandi della visuale.", "Cuando te desplazas lateralmente puedes apuntar manualmente y disparar mediante los controles de movimiento de cámara.", "Во время стрейфа ты можешь прицеливаться вручную и стрелять, используя клавиши управления камерой.", "Cuando te desplazas lateralmente puedes apuntar manualmente y disparar mediante los controles de movimiento de cámara.", "Cuando te desplazas lateralmente puedes apuntar manualmente y disparar mediante los controles de movimiento de cámara." } },
    { "CSH3_12", { "Strafing allows you to look around corners and position yourself more effectively in gun fights.", "Le déplacement latéral te permet de regarder au détour d'un coin et de mieux te placer dans les fusillades.", "Durch Seitwärtsbewegungen kannst du um Ecken sehen und dich bei Schießereien effektiver positionieren.", "Lo spostamento laterale ti permette di vedere dietro gli angoli e posizionarti più efficacemente nelle sparatorie.", "El desplazamiento lateral te permitirá mirar tras las esquinas y colocarte de forma más efectiva durante los tiroteos.", "Стрейф позволяет тебя смотреть за углы и выбирать себе более эффективную позицию в перестрелках.", "El desplazamiento lateral te permitirá mirar tras las esquinas y colocarte de forma más efectiva durante los tiroteos.", "El desplazamiento lateral te permitirá mirar tras las esquinas y colocarte de forma más efectiva durante los tiroteos." } },
    { "CSH3_51", { "Rolling is useful in gun fights as it allows you to dodge gunfire and surprise enemies. You can roll left or right.", "Fais des roulades lors d'échanges de coups de feu pour esquiver les balles et surprendre l'ennemi. Tu peux faire une roulade vers la gauche ou vers la droite.", "Das Abrollen nützt dir bei Schießereien, denn so kannst du feindlichem Feuer ausweichen und den Gegner überraschen. Du kannst dich sowohl nach links, als auch nach rechts abrollen.", "Rotolare è molto utile negli scontri a fuoco poiché ti permette di evitare i colpi e sorprendere i nemici. Puoi rotolare sia a sinistra che a destra.", "Rodar es muy útil durante los tiroteos, ya que te permite esquivar los disparos y sorprender a los enemigos. Puedes rodar a la izquierda o la derecha.", "Перекатывание очень полезно в перестрелках, благодаря ему ты можешь уклоняться от пуль и вводить в заблуждение врагов. Перекатываться можно влево и вправо.", "Rodar es muy útil durante los tiroteos, ya que te permite esquivar los disparos y sorprender a los enemigos. Puedes rodar a la izquierda o la derecha.", "Rodar es muy útil durante los tiroteos, ya que te permite esquivar los disparos y sorprender a los enemigos. Puedes rodar a la izquierda o la derecha." } },
    { "CSH3_52", { "To roll you must be crouched and have a gun equipped, then press and hold ~k~~PED_LOCK_TARGET~ and use ~k~~GO_LEFT~ and ~k~~GO_RIGHT~ to roll.", "Pour faire une roulade, tu dois être accroupi et tenir un flingue. Maintiens ~k~~PED_LOCK_TARGET~ enfoncée et utilise ~k~~GO_LEFT~ et ~k~~GO_RIGHT~ pour rouler.", "Um dich abzurollen, musst du in der Hocke sein und eine Waffe aktiviert haben. Halte dann ~k~~PED_LOCK_TARGET~ gedrückt und rolle dich mit ~k~~GO_LEFT~ und ~k~~GO_RIGHT~ ab.", "Per rotolare devi essere abbassato e avere un'arma in mano. Tieni premuto ~k~~PED_LOCK_TARGET~ e usa ~k~~GO_LEFT~ e ~k~~GO_RIGHT~ per rotolare.", "Para rodar debes estar agachado y tener un arma equipada. A continuación, pulsa y mantén ~k~~PED_LOCK_TARGET~ y usa ~k~~GO_LEFT~ y ~k~~GO_RIGHT~ para rodar.", "Чтобы перекатиться по земле, ты должен присесть и взять в руки оружие. После этого ты должен нажать и держать ~k~~PED_LOCK_TARGET~ и использовать ~k~~GO_LEFT~ и ~k~~GO_RIGHT~ для перекатываний по земле.", "Para rodar debes estar agachado y tener un arma equipada. A continuación, pulsa y mantén ~k~~PED_LOCK_TARGET~ y usa ~k~~GO_LEFT~ y ~k~~GO_RIGHT~ para rodar.", "Para rodar debes estar agachado y tener un arma equipada. A continuación, pulsa y mantén ~k~~PED_LOCK_TARGET~ y usa ~k~~GO_LEFT~ y ~k~~GO_RIGHT~ para rodar." } },
    { "CSH3_7", { "The door is locked. Damaging the keypad might get it open.", "La porte est fermée, bousille le clavier pour l'ouvrir.", "Die Tür ist verschlossen. Schrotte das Keypad, dann geht sie vielleicht auf.", "La porta è chiusa! Danneggia il tastierino numerico per farla aprire.", "La puerta está cerrada. Destruye la cerradura electrónica para poder abrirla.", "Ворота закрыты. Выстрели в панель управления, чтобы они открылись.", "La puerta está cerrada. Destruye la cerradura electrónica para poder abrirla.", "La puerta está cerrada. Destruye la cerradura electrónica para poder abrirla." } },
    { "CTUTOR", { "Press ~k~~TOGGLE_SUBMISSIONS~ to toggle Vigilante missions on or off.", "Appuie sur ~k~~TOGGLE_SUBMISSIONS~ pour activer ou désactiver les missions Autodéfense.", "Drücke ~k~~TOGGLE_SUBMISSIONS~, um Bürgerwehr-Missionen an- oder abzuschalten.", "Premi ~k~~TOGGLE_SUBMISSIONS~ per attivare/disattivare le missioni da vigilante.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones de vigilante.", "~k~~TOGGLE_SUBMISSIONS~ - заняться работой полицейского или отказаться от нее.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones de vigilante.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones de vigilante." } },
    { "C_COMP1", { "Vigilante mission level 12 complete: Your max Body Armor increased to 150%", "Mission Autodéfense niveau 12 terminée. Ta protection pare-balles max. passe à 150%.", "Bürgerwehr-Mission Level 12 beendet: Deine max. Panzerung erhöht sich auf 150%", "Missione da vigilante livello 12 completa: armatura massima incrementata a 150!", "Misión de vigilante nivel 12 completada: tu blindaje corporal máximo sube hasta 150%", "Завершен 12 уровень миссии полицейского: максимальный запас брони повышен до 150%.", "Misión de vigilante nivel 12 completada: tu blindaje corporal máximo sube hasta 150%", "Misión de vigilante nivel 12 completada: tu blindaje corporal máximo sube hasta 150%" } },
    { "DES1_59", { "Hold down ~k~~VEHICLE_HANDBRAKE~ to use 4-wheel steering.", "Maintiens ~k~~VEHICLE_HANDBRAKE~ enfoncée pour utiliser les 4 roues directrices.", "Halte ~k~~VEHICLE_HANDBRAKE~ gedrückt, um mit Vierradsteuerung zu fahren.", "Tieni premuto ~k~~VEHICLE_HANDBRAKE~ per usare lo sterzo su 4 ruote.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas.", "Удерживай ~k~~VEHICLE_HANDBRAKE~, чтобы управлять обоими мостами при поворотах.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas." } },
    { "DES1_60", { "Hold down ~k~~VEHICLE_HANDBRAKE~ to use 4-wheel steering.", "Maintiens ~k~~VEHICLE_HANDBRAKE~ enfoncée pour utiliser les 4 roues directrices.", "Halte ~k~~VEHICLE_HANDBRAKE~ gedrückt, um mit Vierradsteuerung zu fahren.", "Tieni premuto ~k~~VEHICLE_HANDBRAKE~ per usare lo sterzo su 4 ruote.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas.", "Удерживай ~k~~VEHICLE_HANDBRAKE~, чтобы управлять обоими мостами при поворотах.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas." } },
    { "DES1_61", { "Hold down ~k~~VEHICLE_HANDBRAKE~ to use 4-wheel steering.", "Maintiens ~k~~VEHICLE_HANDBRAKE~ enfoncée pour utiliser les 4 roues directrices.", "Halte ~k~~VEHICLE_HANDBRAKE~ gedrückt, um mit Vierradsteuerung zu fahren.", "Tieni premuto ~k~~VEHICLE_HANDBRAKE~ per usare lo sterzo su 4 ruote.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas.", "Удерживай ~k~~VEHICLE_HANDBRAKE~, чтобы управлять обоими мостами при поворотах.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas.", "Deja pulsado ~k~~VEHICLE_HANDBRAKE~ para usar la dirección en las 4 ruedas." } },
    { "DES6_12", { "~s~Keep an eye on your 'visibility bar' to stay under the radar.", "~s~Garde un oeil sur ta \"barre de visibilité\" pour rester sous le radar.", "~s~Beobachte die 'Sichtbarkeitsanzeige', um unter dem Radar zu bleiben.", "~s~Tieni d'occhio la 'barra di visibilità' per restare sotto al radar.", "~s~Vigila la barra de tu \"visibilidad\" para que no te detecte el radar.", "~s~Следи за 'шкалой видимости', чтобы оставаться ниже зоны действия радара.", "~s~Vigila la barra de tu \"visibilidad\" para que no te detecte el radar.", "~s~Vigila la barra de tu \"visibilidad\" para que no te detecte el radar." } },
    { "DGS1_2", { "If enemies are using cover it may be better to use manual aiming whilst shooting.", "Si l'ennemi se met à couvert, il vaut mieux viser avec précision à l'aide de la visée manuelle quand tu tires.", "Wenn Gegner in Deckung gehen, ist es oft besser, manuell zu zielen, während du schießt.", "Se i nemici si riparano, può essere opportuno usare la mira manuale.", "Si los enemigos emplean cobertura, es mejor que uses la puntería manual cuando dispares.", "Если противники используют укрытия, при стрельбе лучше всего использовать ручное прицеливание.", "Si los enemigos emplean cobertura, es mejor que uses la puntería manual cuando dispares.", "Si los enemigos emplean cobertura, es mejor que uses la puntería manual cuando dispares." } },
    { "DGS1_63", { "Shooting whilst you are crouching improves your accuracy.", "Tes tirs sont plus précis quand t'es accroupi.", "Schießen in geduckter Haltung steigert die Zielgenauigkeit.", "Sparando mentre si è abbassati migliora la precisione.", "Al disparar mientras estés agachado mejorarás tu precisión.", "При стрельбе сидя твоя меткость повышается.", "Al disparar mientras estés agachado mejorarás tu precisión.", "Al disparar mientras estés agachado mejorarás tu precisión." } },
    { "DGS1_64", { "To look around on the bike use the camera movement controls. To fire press ~k~~PED_FIREWEAPON~.", "Pour regarder autour de toi sur la moto, utilise les contrôles de mouvement de la caméra. Pour tirer, appuie sur ~k~~PED_FIREWEAPON~.", "Benutze die Kamerakontrolle, um dich auf dem Motorrad sitzend umzusehen. Zum Feuern benutze ~k~~PED_FIREWEAPON~.", "Per guardarti intorno sulla moto usa i comandi della visuale. Per sparare usa ~k~~PED_FIREWEAPON~.", "Para mirar alrededor en la moto, usa los controls de movimiento de cámara. Para disparar, usa ~k~~PED_FIREWEAPON~.", "Чтобы вращать камеру, сидя на мотоцикле, используй клавиши управления камерой. Чтобы стрелять, нажми ~k~~PED_FIREWEAPON~.", "Para mirar alrededor en la moto, usa los controls de movimiento de cámara. Para disparar, usa ~k~~PED_FIREWEAPON~.", "Para mirar alrededor en la moto, usa los controls de movimiento de cámara. Para disparar, usa ~k~~PED_FIREWEAPON~." } },
    { "DGS1_65", { "You can also use ~k~~VEHICLE_FIREWEAPON_ALT~ to fire.", "Tu peux aussi utiliser ~k~~VEHICLE_FIREWEAPON_ALT~ pour tirer.", "Du kannst auch ~k~~VEHICLE_FIREWEAPON_ALT~ verwenden, um zu feuern.", "Puoi anche usare ~k~~VEHICLE_FIREWEAPON_ALT~ per sparare.", "También puedes usar ~k~~VEHICLE_FIREWEAPON_ALT~ para disparar.", "Можно также использовать клавишу ~k~~VEHICLE_FIREWEAPON_ALT~, чтобы стрелять.", "También puedes usar ~k~~VEHICLE_FIREWEAPON_ALT~ para disparar.", "También puedes usar ~k~~VEHICLE_FIREWEAPON_ALT~ para disparar." } },
    { "DRV3_H", { "When you're close to a ~r~package~w~, tap ~k~~VEHICLE_FIREWEAPON_ALT~ to snatch it.", "Quand t'es assez près d'un ~r~paquet~s~, appuie sur ~k~~VEHICLE_FIREWEAPON_ALT~ pour le récupérer.", "Bist du in der Nähe eines ~r~Päckchens~s~, tippe auf ~k~~VEHICLE_FIREWEAPON_ALT~, um es dir zu schnappen.", "Quando sei vicino a un ~r~pacco~w~, premi rapidamente ~k~~VEHICLE_FIREWEAPON_ALT~ per prenderlo.", "Cuando estés cerca de un ~r~paquete~w~, pulsa brevemente ~k~~VEHICLE_FIREWEAPON_ALT~ para cogerlo.", "Когда ты находишься рядом с ~r~пакетом~w~, нажми ~k~~VEHICLE_FIREWEAPON_ALT~, чтобы отобрать его.", "Cuando estés cerca de un ~r~paquete~w~, pulsa brevemente ~k~~VEHICLE_FIREWEAPON_ALT~ para cogerlo.", "Cuando estés cerca de un ~r~paquete~w~, pulsa brevemente ~k~~VEHICLE_FIREWEAPON_ALT~ para cogerlo." } },
    { "DST8_10", { "Damage the ~y~vent grate ~w~and drop into it to gain entry.", "Tire sur la ~y~grille de ventilation~w~ et passe par le conduit pour entrer.", "Schieß den ~y~Lüftungsrost~w~ kaputt und spring in den Schacht, um dir Zutritt zu verschaffen.", "Colpisci la ~y~grata di ventilazione~w~ e passaci in mezzo per accedere alla struttura.", "Dispara a la ~y~rejilla de ventilación~w~ y déjate caer por ella para entrar.", "~y~Вентиляционную решетку~w~ можно открыть, просто ударив по ней.", "Dispara a la ~y~rejilla de ventilación~w~ y déjate caer por ella para entrar.", "Dispara a la ~y~rejilla de ventilación~w~ y déjate caer por ella para entrar." } },
    { "DST8_27", { "Press ~k~~PED_SPRINT~ to increase thrust - this will make you ascend.", "Appuie sur ~k~~PED_SPRINT~ pour augmenter la poussée et t'élever ainsi dans les airs.", "Drücke ~k~~PED_SPRINT~, um den Schub zu erhöhen. Dies bewirkt, dass du steigst.", "Premi ~k~~PED_SPRINT~ per aumentare la potenza: in questo modo ti alzerai dal terreno.", "Pulsa ~k~~PED_SPRINT~ para aumentar el impulso: te hará ascender.", "~k~~PED_SPRINT~ - усилить мощность джетпака, чтобы подняться вверх.", "Pulsa ~k~~PED_SPRINT~ para aumentar el impulso: te hará ascender.", "Pulsa ~k~~PED_SPRINT~ para aumentar el impulso: te hará ascender." } },
    { "DST8_28", { "To move in a direction with the jet pack use the movement controls while in the air.", "Pour aller dans une direction avec le jetpack, utilise les contrôles de déplacement quand t'es en l'air.", "Um mit dem Jet Pack in der Luft die Richtung zu ändern, benutze die Bewegungskontrolle.", "Per spostarti in una direzione col jet pack usa i comandi di movimento mentre sei in aria.", "Para moverte en una dirección con la mochila propulsora, usa los controles de movimiento mientras estés en el aire.", "Используй клавиши передвижения, чтобы лететь в нужном направлении.", "Para moverte en una dirección con la mochila propulsora, usa los controles de movimiento mientras estés en el aire.", "Para moverte en una dirección con la mochila propulsora, usa los controles de movimiento mientras estés en el aire." } },
    { "DST8_29", { "To descend quickly press ~k~~PED_JUMPING~.", "Pour redescendre rapidement, appuie sur ~k~~PED_JUMPING~.", "Um schnell zu sinken, drücke ~k~~PED_JUMPING~.", "Per scendere rapidamente premi ~k~~PED_JUMPING~.", "Para descender rápidamente pulsa ~k~~PED_JUMPING~.", "~k~~PED_JUMPING~ - ослабить мощность джетпака, чтобы опуститься вниз.", "Para descender rápidamente pulsa ~k~~PED_JUMPING~.", "Para descender rápidamente pulsa ~k~~PED_JUMPING~." } },
    { "DST8_30", { "To strafe right while in the jetpack press ~k~~GO_RIGHT~.", "Pour te déplacer sur la droite avec le jetpack, appuie sur ~k~~GO_RIGHT~.", "Um mit dem Jet Pack seitwärts nach rechts zu fliegen, drücke ~k~~GO_RIGHT~.", "Per spostarti lateralmente a destra col jet pack, premi ~k~~GO_RIGHT~.", "Para desplazarte lateralmente a la derecha mientras usas la mochila propulsora, pulsa ~k~~GO_RIGHT~.", "~k~~GO_RIGHT~ - лететь вправо.", "Para desplazarte lateralmente a la derecha mientras usas la mochila propulsora, pulsa ~k~~GO_RIGHT~.", "Para desplazarte lateralmente a la derecha mientras usas la mochila propulsora, pulsa ~k~~GO_RIGHT~." } },
    { "DST8_31", { "To strafe left while in the jetpack press ~k~~GO_LEFT~.", "Pour te déplacer sur la gauche avec le jetpack, appuie sur ~k~~GO_LEFT~.", "Um mit dem Jet Pack seitwärts nach links zu fliegen, drücke ~k~~GO_LEFT~.", "Per spostarti lateralmente a sinistra col jet pack, premi ~k~~GO_LEFT~.", "Para desplazarte lateralmente a la izquierda mientras usas la mochila propulsora, pulsa ~k~~GO_LEFT~.", "~k~~GO_LEFT~ - лететь влево.", "Para desplazarte lateralmente a la izquierda mientras usas la mochila propulsora, pulsa ~k~~GO_LEFT~.", "Para desplazarte lateralmente a la izquierda mientras usas la mochila propulsora, pulsa ~k~~GO_LEFT~." } },
    { "DST8_33", { "You can fire a single-handed weapon as normal while piloting the jetpack.", "Tu peux tirer normalement avec une arme à une main quand tu pilotes le jetpack.", "Während du mit dem Jet Pack fliegst, kannst du mit einhändigen Waffen ganz normal feuern.", "Mentre piloti il jet pack, puoi utilizzare normalmente qualsiasi arma che puoi reggere con una mano.", "Puedes disparar un arma de mano con normalidad mientras pilotas la mochila propulsora.", "При полете на джетпаке у тебя есть возможность стрелять из оружия SМG-типа.", "Puedes disparar un arma de mano con normalidad mientras pilotas la mochila propulsora.", "Puedes disparar un arma de mano con normalidad mientras pilotas la mochila propulsora." } },
    { "DST8_37", { "When goggles are selected, press ~k~~PED_FIREWEAPON~ to toggle thermal vision on and off.", "Une fois les lunettes sélectionnées, appuie sur ~k~~PED_FIREWEAPON~ pour activer ou non la vision nocturne.", "Ist das Sichtgerät selektiert, drücke ~k~~PED_FIREWEAPON~, um die Thermo-Sicht an- oder abzuschalten.", "Quando il visore è selezionato, premi ~k~~PED_FIREWEAPON~ per attivare e disattivare la visione notturna.", "Cuando tengas las gafas seleccionadas, pulsa ~k~~PED_FIREWEAPON~ para activar o desactivar la visión térmica.", "Выбери прибор теплового видения в оружейном инвентаре и нажми ~k~~PED_FIREWEAPON~, чтобы включить или выключить режим теплового видения.", "Cuando tengas las gafas seleccionadas, pulsa ~k~~PED_FIREWEAPON~ para activar o desactivar la visión térmica.", "Cuando tengas las gafas seleccionadas, pulsa ~k~~PED_FIREWEAPON~ para activar o desactivar la visión térmica." } },
    { "DUAL_A", { "~k~~VEHICLE_ENTER_EXIT~ Use Videogame", "~k~~VEHICLE_ENTER_EXIT~ Jouer au jeu vidéo", "~k~~VEHICLE_ENTER_EXIT~: Videospiel spielen", "~k~~VEHICLE_ENTER_EXIT~ Usa videogioco", "~k~~VEHICLE_ENTER_EXIT~ Usar videojuego", "~k~~VEHICLE_ENTER_EXIT~ - сыграть в видеоигру.", "~k~~VEHICLE_ENTER_EXIT~ Usar videojuego", "~k~~VEHICLE_ENTER_EXIT~ Usar videojuego" } },
    { "DUMBELL", { "Go to the dumbbell icon (displayed on the radar) and check out the gym.", "Va vers l'icone en forme d'altère (sur le radar) et pointe-toi dans un gymnase.", "Begib dich zu dem Hantel-Symbol (auf dem Radar) und sieh dir das Fitnesscenter an.", "Raggiungi l'icona dei manubri (indicata sul radar) per visitare la palestra.", "Dirígete al icono de la pesa (mostrado en el radar) y visita el gimnasio.", "Спортзал отмечен на радаре иконкой в виде гантели.", "Dirígete al icono de la pesa (mostrado en el radar) y visita el gimnasio.", "Dirígete al icono de la pesa (mostrado en el radar) y visita el gimnasio." } },
    { "EMMET_G", { "You can visit Emmet's at any time to get a gun!", "Va chez Emmet quand tu veux pour te trouver un flingue_!", "Du kannst dir jederzeit bei Emmet eine Waffe besorgen!", "Puoi visitare Emmet in qualsiasi momento per recuperare un'arma.", "Puedes visitar a Emmet cuando quieras para obtener un arma.", "Ты можешь навестить Эммета в любое время, чтоб получить пушку!", "Puedes visitar a Emmet cuando quieras para obtener un arma.", "Puedes visitar a Emmet cuando quieras para obtener un arma." } },
    { "FEG_HOW", { "To take a photo with a camera press ~k~~PED_FIREWEAPON~.", "Pour prendre une photo avec un appareil, appuie sur ~k~~PED_FIREWEAPON~.", "Um mit einer Kamera ein Foto zu machen, drücke ~k~~PED_FIREWEAPON~.", "Per scattare una foto premi ~k~~PED_FIREWEAPON~.", "Para hacer una foto con una cámara, pulsa ~k~~PED_FIREWEAPON~.", "~k~~PED_FIREWEAPON~ - сделать снимок.", "Para hacer una foto con una cámara, pulsa ~k~~PED_FIREWEAPON~.", "Para hacer una foto con una cámara, pulsa ~k~~PED_FIREWEAPON~." } },
    { "FIREPRO", { "~s~Fire Truck Mission level 12 complete. You are now completely fireproof!", "~s~Mission Pompiers niveau 12 terminée. Maintenant, tu seras toujours à l'épreuve du feu_!", "~s~Feuerwehr-Mission Level 12 abgeschlossen. Jetzt bist du absolut feuerfest!!", "~s~Missione Pompiere livello 12 completata. Ora sei completamente ignifugo!", "~s~Nivel 12 de misión de coche de bomberos completado. ¡Ahora eres completamente ignífugo!", "~s~Завершен 12 уровень миссии пожарного. Теперь ты можешь не бояться огня!", "~s~Nivel 12 de misión de coche de bomberos completado. ¡Ahora eres completamente ignífugo!", "~s~Nivel 12 de misión de coche de bomberos completado. ¡Ahora eres completamente ignífugo!" } },
    { "FIRE_EX", { "Press ~k~~PED_FIREWEAPON~ to use the fire extinguisher. Use ~k~~PED_LOCK_TARGET~ for a better view. Aim at the base of a fire to put it out.", "Appuie sur ~k~~PED_FIREWEAPON~ pour utiliser un extincteur. Utilise ~k~~PED_LOCK_TARGET~ pour une meilleure vue. Vise la base des flammes.", "Drücke ~k~~PED_FIREWEAPON~, um den Feuerlöscher zu benutzen. Drücke ~k~~PED_LOCK_TARGET~ für einen besseren Blickwinkel. Ziele auf den Kern des Feuers, um es zu löschen.", "Premi ~k~~PED_FIREWEAPON~ per usare l'estintore. Usa ~k~~PED_LOCK_TARGET~ per una visuale migliore. Mira alla base del fuoco per spegnerlo.", "Pulsa Press ~k~~PED_FIREWEAPON~ para usar el extintor. Usa ~k~~PED_LOCK_TARGET~ para ajustar tu posición. Usa ~k~~PED_LOCK_TARGET~ para ver mejor. Apunta a la base del fuego para apagarlo.", "~k~~PED_FIREWEAPON~ - использовать огнетушитель. Нажми ~k~~PED_LOCK_TARGET~, чтобы было удобнее целиться. Наведи огнетушитель на основную часть пламени, чтобы потушить его.", "Pulsa Press ~k~~PED_FIREWEAPON~ para usar el extintor. Usa ~k~~PED_LOCK_TARGET~ para ajustar tu posición. Usa ~k~~PED_LOCK_TARGET~ para ver mejor. Apunta a la base del fuego para apagarlo.", "Pulsa Press ~k~~PED_FIREWEAPON~ para usar el extintor. Usa ~k~~PED_LOCK_TARGET~ para ajustar tu posición. Usa ~k~~PED_LOCK_TARGET~ para ver mejor. Apunta a la base del fuego para apagarlo." } },
    { "FOOD_H", { "Use ~k~~GO_LEFT~ or ~k~~GO_RIGHT~ to select a meal.~N~~k~~PED_SPRINT~ Buy~N~~k~~VEHICLE_ENTER_EXIT~ Quit", "Utilise ~k~~GO_LEFT~ ou ~k~~GO_RIGHT~ pour choisir un menu.~N~~k~~PED_SPRINT~ Acheter~N~~k~~VEHICLE_ENTER_EXIT~ Quitter", "Benutze ~k~~GO_LEFT~ oder ~k~~GO_RIGHT~, um ein Essen auszuwählen.~N~~k~~PED_SPRINT~ Kaufen~N~~k~~VEHICLE_ENTER_EXIT~ Beenden", "Usa ~k~~GO_LEFT~ o ~k~~GO_RIGHT~ per scegliere un pasto.~N~~k~~PED_SPRINT~ Compra~N~~k~~VEHICLE_ENTER_EXIT~ Esci", "Usa ~k~~GO_LEFT~ o ~k~~GO_RIGHT~ para seleccionar una comida.~N~~k~~PED_SPRINT~ Comprar~N~~k~~VEHICLE_ENTER_EXIT~ Salir.", "~k~~GO_LEFT~ и ~k~~GO_RIGHT~ - выбрать блюдо.~N~~k~~PED_SPRINT~ - купить.~N~~k~~VEHICLE_ENTER_EXIT~ - выход.", "Usa ~k~~GO_LEFT~ o ~k~~GO_RIGHT~ para seleccionar una comida.~N~~k~~PED_SPRINT~ Comprar~N~~k~~VEHICLE_ENTER_EXIT~ Salir.", "Usa ~k~~GO_LEFT~ o ~k~~GO_RIGHT~ para seleccionar una comida.~N~~k~~PED_SPRINT~ Comprar~N~~k~~VEHICLE_ENTER_EXIT~ Salir." } },
    { "FOTO100", { "All photos taken! Weapons delivered to the San Fierro garage!", "T'as pris toutes les photos_! Des armes ont été livrées au garage de San Fierro_!", "Alle Schnappschüsse gemacht! Waffen an die Werkstatt in San Fierro geliefert!", "Tutte le foto sono state scattate! Delle armi sono state consegnate al garage di San Fierro!", "¡Has hecho todas las fotos! ¡Se han llevado armas al garaje de San Fierro!", "Все снимки сделаны! В гараж Сан-Фиерро доставлено оружие!", "¡Has hecho todas las fotos! ¡Se han llevado armas al garaje de San Fierro!", "¡Has hecho todas las fotos! ¡Se han llevado armas al garaje de San Fierro!" } },
    { "FREI_03", { "~s~Deliver the cargo to the stations within the time limit!", "~s~Livre le chargement aux stations dans le temps imparti_!", "~s~Liefere die Fracht innerhalb des Zeitlimits an die Bahnhöfe!", "~s~Porta il carico alle stazioni entro il tempo limite!", "~s~¡Entrega el cargamento a las estaciones dentro del límite de tiempo!", "~s~Доставь груз на все станции, пока не кончилось время!", "~s~¡Entrega el cargamento a las estaciones dentro del límite de tiempo!", "~s~¡Entrega el cargamento a las estaciones dentro del límite de tiempo!" } },
    { "FREI_12", { "~s~If you go too fast you will derail!", "~s~Va pas trop vite ou tu risques de dérailler.", "~s~Wenn du zu schnell fährst, entgleist du.", "~s~Se vai troppo veloce, rischi di deragliare!", "~s~Si vas demasiado rápido, descarrilarás.", "~s~При очень высокой скорости состав может сойти с рельс!", "~s~Si vas demasiado rápido, descarrilarás.", "~s~Si vas demasiado rápido, descarrilarás." } },
    { "FREI_13", { "~s~Brake early or you will overshoot the station!", "~s~Commence à freiner tôt ou tu rateras la gare.", "~s~Bremse rechtzeitig, sonst schießt du über den Bahnhof hinaus!", "~s~Frena in anticipo o sorpasserai la stazione.", "~s~Frena pronto o te pasarás la estación.", "~s~Тормозить следует заранее, чтобы не проехать станцию!", "~s~Frena pronto o te pasarás la estación.", "~s~Frena pronto o te pasarás la estación." } },
    { "FREI_16", { "The freight oddjob has been passed. You can replay it to make extra cash.", "La mission Train de marchandises a été réussie. Tu peux la rejouer pour te faire plus de thunes.", "Die Fracht-Mission wurde erfüllt. Du kannst sie wiederholen, um dir noch mehr Geld dazuzuverdienen.", "Il lavoro del treno merci è stato completato. Puoi ripetere la missione per raccogliere altri soldi.", "Has superado el trabajo del carguero. Puedes volver a jugarlo para ganar dinero extra.", "Миссии железнодорожника завершены. Вы можете улучшить свой результат по времени, чтобы получить дополнительный заработок.", "Has superado el trabajo del carguero. Puedes volver a jugarlo para ganar dinero extra.", "Has superado el trabajo del carguero. Puedes volver a jugarlo para ganar dinero extra." } },
    { "FTUTOR", { "Press ~k~~TOGGLE_SUBMISSIONS~ to toggle fire truck missions on or off.", "Appuie sur ~k~~TOGGLE_SUBMISSIONS~ pour activer ou désactiver les missions Pompiers.", "Drücke ~k~~TOGGLE_SUBMISSIONS~, um Feuerwehr-Missionen an- oder abzuschalten.", "Premi ~k~~TOGGLE_SUBMISSIONS~ per attivare/disattivare le missioni da pompiere.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones del coche de bomberos.", "~k~~TOGGLE_SUBMISSIONS~ - заняться работой пожарного или отказаться от нее.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones del coche de bomberos.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones del coche de bomberos." } },
    { "FTUTORA", { "Press ~k~~TOGGLE_SUBMISSIONS~ to toggle freight train missions on or off.", "Appuie sur ~k~~TOGGLE_SUBMISSIONS~ pour activer ou désactiver les missions Train de marchandises.", "Drücke ~k~~TOGGLE_SUBMISSIONS~, um Fracht-Missionen an- oder abzuschalten.", "Premi ~k~~TOGGLE_SUBMISSIONS~ per attivare/disattivare le missioni del treno merci.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones de tren de carga.", "~k~~TOGGLE_SUBMISSIONS~ - заняться работой железнодорожника или отказаться от нее.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones de tren de carga.", "Pulsa ~k~~TOGGLE_SUBMISSIONS~ para alternar la activación de las misiones de tren de carga." } },
    { "FUDHLP1", { "If you do not eat you will lose weight and eventually energy. The red bar shows how much energy you have.", "Si tu ne manges pas, tu perds du poids puis de l'énergie. La barre rouge indique ton niveau d'énergie actuel.", "Wenn du nichts isst, verlierst du Gewicht und irgendwann auch Energie. Der rote Balken zeigt an, wie viel Energie du hast.", "Se non mangi, perdi peso e successivamente energia. La barra rossa ti indica quanta energia hai.", "Si no comes, perderás peso y, finalmente, energía. La barra roja indica cuánta energía tienes.", "Если ты не будешь есть, то со временем твой вес, а затем и здоровье будут уменьшаться. Шкала красного цвета отображает запас твоего здоровья.", "Si no comes, perderás peso y, finalmente, energía. La barra roja indica cuánta energía tienes.", "Si no comes, perderás peso y, finalmente, energía. La barra roja indica cuánta energía tienes." } },
    { "FUDHLP2", { "When you eat, you gain energy but eat too much and you will become fat.", "Quand tu manges, tu regagnes de l'énergie mais si tu manges trop, tu deviendras obèse.", "Essen gibt dir Energie, aber wenn du zu viel isst, wirst du fett.", "Se mangi, guadagni energia, ma se mangi troppo ingrassi.", "Cuando comas, recuperarás energía, pero si comes demasiado engordarás.", "Когда ты ешь, твое здоровье восстанавливается, однако если ты будешь есть чересчур много, ты быстро наберешь вес.", "Cuando comas, recuperarás energía, pero si comes demasiado engordarás.", "Cuando comas, recuperarás energía, pero si comes demasiado engordarás." } },
    { "FUDHLP3", { "Press ~k~~PED_ANSWER_PHONE~ to view stats. This shows CJ's current condition. Whenever a stat changes it will appear at the top left of the screen.", "Appuie sur ~k~~PED_ANSWER_PHONE~ pour voir tes stats. Elles représentent la condition actuelle de CJ. Chaque fois qu'une stat change, elle apparaît en haut à gauche de l'écran.", "Halte ~k~~PED_ANSWER_PHONE~ gedrückt, um dir Statistiken anzusehen. Dies zeigt CJs augenblicklichen Zustand an. Immer wenn sich eine Statistik ändert, erscheint sie oben links auf dem Bildschirm.", "Premi ~k~~PED_ANSWER_PHONE~ per visualizzare le statistiche, che indicano le condizioni attuali di CJ. Quando una di esse cambia, appare in alto a sinistra.", "Pulsa ~k~~PED_ANSWER_PHONE~ para ver las estatdísticas. Esto muestra la condición actual de CJ. Cuando una estadística cambie, dicho cambio se indicará en la parte superior izquierda de la pantalla.", "~k~~PED_ANSWER_PHONE~ - открыть окно сведений о персонаже. Это окно отображает текущее состояние СJ'я. Когда состояние Карла изменяется, в верхней левой части экрана выводится соответствующая информация.", "Pulsa ~k~~PED_ANSWER_PHONE~ para ver las estatdísticas. Esto muestra la condición actual de CJ. Cuando una estadística cambie, dicho cambio se indicará en la parte superior izquierda de la pantalla.", "Pulsa ~k~~PED_ANSWER_PHONE~ para ver las estatdísticas. Esto muestra la condición actual de CJ. Cuando una estadística cambie, dicho cambio se indicará en la parte superior izquierda de la pantalla." } },
    { "GAME100", { "100% achieved! Stats and cash have been boosted! Rhino and Hydra delivered to CJ's house in Grove Street.", "100% atteint_! Tes stats et ta thune ont été boostées_! Un Rhino et un Hydra Jet ont été livrés chez CJ, à Grove Street.", "100% erreicht! Statistikwerte und Barvermögen wurden erhöht! Rhino und Hydra an CJs Haus in der Grove Street geliefert.", "Ottenuto il 100%! Statistiche e soldi sono stati aumentati! Rhino e Hydra consegnati alla casa di CJ in Grove Street!", "¡Obtenido el 100%! ¡Tus estadísticas y dinero mejoran! Se han llevado un Rhino y un Hydra a la casa de CJ en Grove Street.", "100% ДОСТИГНУТО! ХАРАКТЕРИСТИКИ И ДЕНЬГИ УВЕЛИЧИЛИСЬ! НОСОРОГ И ГИДРА БЫЛИ ДОСТАВЛЕНЫ В ДОМ СИДЖЕЯ НА ГРОУВ СТРИТ.", "¡Obtenido el 100%! ¡Tus estadísticas y dinero mejoran! Se han llevado un Rhino y un Hydra a la casa de CJ en Grove Street.", "¡Obtenido el 100%! ¡Tus estadísticas y dinero mejoran! Se han llevado un Rhino y un Hydra a la casa de CJ en Grove Street." } },
    { "GAR1_23", { "Press ~k~~VEHICLE_HORN~ to sound car horn.", "Appuie sur ~k~~VEHICLE_HORN~ pour klaxonner.", "Drücke ~k~~VEHICLE_HORN~, um zu hupen", "Premi ~k~~VEHICLE_HORN~ per suonare il clacson.", "Pulsa ~k~~VEHICLE_HORN~ para tocar el claxon del coche.", "~k~~VEHICLE_HORN~ - посигналить.", "Pulsa ~k~~VEHICLE_HORN~ para tocar el claxon del coche.", "Pulsa ~k~~VEHICLE_HORN~ para tocar el claxon del coche." } },
    { "GAR2_42", { "Be careful to avoid explosive barrels!", "Evite les barils d'explosifs_!", "Sei vorsichtig! Meide die explosiven Fässer!", "Evita i barili esplosivi!", "¡Procura evitar los barriles explosivos!", "Будь осторожен, избегай бочек с горючим!", "¡Procura evitar los barriles explosivos!", "¡Procura evitar los barriles explosivos!" } },
    { "GF_0020", { "Push ~k~~GO_FORWARD~ and ~k~~GO_BACK~ in rhythm~n~~k~~PED_FIREWEAPON~ Change view~n~~k~~PED_JUMPING~ Change position~n~~k~~VEHICLE_ENTER_EXIT~ Quit", "Appuie sur ~k~~GO_FORWARD~ et ~k~~GO_BACK~ en rythme~n~~k~~PED_FIREWEAPON~ changer de vue~n~~k~~PED_JUMPING~ changer de position~n~~k~~VEHICLE_ENTER_EXIT~ quitter", "Drücke rhythmisch ~k~~GO_FORWARD~ und ~k~~GO_BACK~.~n~~k~~PED_FIREWEAPON~ Blickwinkel ändern~n~~k~~PED_JUMPING~ Stellung ändern~n~~k~~VEHICLE_ENTER_EXIT~ Beenden", "Premi ~k~~GO_FORWARD~ e ~k~~GO_BACK~ a tempo~n~~k~~PED_FIREWEAPON~ Cambia visuale~n~~k~~PED_JUMPING~ Cambia posizione~n~~k~~VEHICLE_ENTER_EXIT~ Esci", "Pulsa ~k~~GO_FORWARD~ and ~k~~GO_BACK~ al ritmo.~n~~k~~PED_FIREWEAPON~ Cambiar la vista~n~~k~~PED_JUMPING~ Cambiar la posición~n~~k~~VEHICLE_ENTER_EXIT~ Salir", "Нажимай ~k~~GO_FORWARD~ и ~k~~GO_BACK~ в ритме.~n~~k~~PED_FIREWEAPON~ - сменить вид.~n~~k~~PED_JUMPING~ - сменить позицию.~n~~k~~VEHICLE_ENTER_EXIT~ - выход.", "Pulsa ~k~~GO_FORWARD~ and ~k~~GO_BACK~ al ritmo.~n~~k~~PED_FIREWEAPON~ Cambiar la vista~n~~k~~PED_JUMPING~ Cambiar la posición~n~~k~~VEHICLE_ENTER_EXIT~ Salir", "Pulsa ~k~~GO_FORWARD~ and ~k~~GO_BACK~ al ritmo.~n~~k~~PED_FIREWEAPON~ Cambiar la vista~n~~k~~PED_JUMPING~ Cambiar la posición~n~~k~~VEHICLE_ENTER_EXIT~ Salir" } },
    { "GF_0021", { "Press ~k~~PED_ANSWER_PHONE~ to kiss.", "Appuie sur ~k~~PED_ANSWER_PHONE~ pour embrasser.", "Zum Küssen drücke ~k~~PED_ANSWER_PHONE~.", "Premi ~k~~PED_ANSWER_PHONE~ per baciare.", "Pulsa ~k~~PED_ANSWER_PHONE~ para besar.", "~k~~PED_ANSWER_PHONE~ - поцеловать подружку.", "Pulsa ~k~~PED_ANSWER_PHONE~ para besar.", "Pulsa ~k~~PED_ANSWER_PHONE~ para besar." } },
    { "GF_0036", { "Pick a place that your girl might like and take her there. Choose between fast-food, restaurant, bar or diner, as indicated on the map.", "Trouve un endroit que ta meuf appréciera pour la sortir. Choisis entre fast-food, resto, bar ou une petite bouffe, tous indiqués sur la carte.", "Such dir ein Lokal aus, das deiner Freundin gefallen könnte, und bring sie hin. Es stehen Schnellimbisse, Restaurants, Bars, und Diners zur Auswahl, die alle auf der Karte bezeichnet sind.", "Scegli un posto che potrebbe piacere alla tua fidanzata e portala lì. Fast food, ristoranti, bar e tavole calde sono indicati sulla mappa.", "Escoge un sitio que le pueda gustar a tu chica y llévala allí. Elige entre comida rápida, restaurante, bar o cafetería, según lo indicado por el mapa.", "Выбери место, которое может понравиться твоей девушке, и отвези ее туда. Выбирай между фаст-фудами, ресторанами, барами и столовыми, отмеченными на карте.", "Escoge un sitio que le pueda gustar a tu chica y llévala allí. Elige entre comida rápida, restaurante, bar o cafetería, según lo indicado por el mapa.", "Escoge un sitio que le pueda gustar a tu chica y llévala allí. Elige entre comida rápida, restaurante, bar o cafetería, según lo indicado por el mapa." } },
    { "GF_0037", { "Take your girl through areas she might like and watch your speed.", "Emmène ta meuf dans des quartiers qui pourraient lui plaire et surveille ta vitesse.", "Fahr dein Mädchen durch Gegenden, die ihr gefallen könnten und auchte auf deine Geschwindigkeit.", "Porta la tua fidanzata in zone che le potrebbero piacere e occhio alla velocità.", "Lleva a tu chica por las zonas que le puedan gustar y vigila tu velocidad.", "Покатай свою девушку по тем местам города, которые ей нравятся. Следи за своей скоростью.", "Lleva a tu chica por las zonas que le puedan gustar y vigila tu velocidad.", "Lleva a tu chica por las zonas que le puedan gustar y vigila tu velocidad." } },
    { "GF_0038", { "Take your girl to a club and impress her with your dancing. Check the map to see where the closest club is located.", "Sors ta meuf en boîte et impressionne-la par tes talents de danseur. Jette un oeil sur la carte pour voir ou se trouve la boîte de nuit la plus proche.", "Geh mit deinem Mädchen in einen Club und beeindrucke sie mit deinen tänzerischen Fähigkeiten. Schau auf die Karte, um die naheliegendste Disco zu finden.", "Porta la tua fidanzata in una discoteca e impressionala con le tue doti di ballerino. Controlla la mappa per trovare la discoteca più vicina.", "Lleva a tu chica a un club e impresiónala con tu habilidad de baile. Consulta el mapa para ver donde se encuentra el club más cercano.", "Отведи свою девушку в клуб и порази ее своим умением танцевать. Сверься с картой и узнай, где находится ближайший клуб.", "Lleva a tu chica a un club e impresiónala con tu habilidad de baile. Consulta el mapa para ver donde se encuentra el club más cercano.", "Lleva a tu chica a un club e impresiónala con tu habilidad de baile. Consulta el mapa para ver donde se encuentra el club más cercano." } },
    { "GF_0039", { "Your girlfriend is dead.", "Ta meuf est morte.", "Deine Freundin ist tot.", "La tua fidanzata è morta.", "Tu novia ha muerto.", "Твоя девушка мертва.", "Tu novia ha muerto.", "Tu novia ha muerto." } },
    { "GF_0043", { "Press ~k~~PED_SPRINT~ when the power bar is full~n~~k~~PED_FIREWEAPON~ Change view~n~~k~~VEHICLE_ENTER_EXIT~ Quit", "Appuie sur ~k~~PED_SPRINT~ quand la barre de puissance est pleine.~n~~k~~PED_FIREWEAPON~ changer de vue~n~~k~~VEHICLE_ENTER_EXIT~ quitter", "Drücke ~k~~PED_SPRINT~, wenn der Power-Balken voll ist. ~n~~k~~PED_FIREWEAPON~ Blickwinkel ändern~n~~k~~VEHICLE_ENTER_EXIT~ Beenden", "Premi ~k~~PED_SPRINT~ quando la barra della potenza è al massimo~n~~k~~PED_FIREWEAPON~ Cambia visuale~n~~k~~VEHICLE_ENTER_EXIT~ Esci", "Pulsa ~k~~PED_SPRINT~ cuando la barra de potencia esté llena~n~~k~~PED_FIREWEAPON~ Cambiar la vista~n~~k~~VEHICLE_ENTER_EXIT~ Salir", "Нажми ~k~~PED_SPRINT~, когда шкала энергии заполнится.~n~~k~~PED_FIREWEAPON~ - сменить вид.~n~~k~~VEHICLE_ENTER_EXIT~ - выход.", "Pulsa ~k~~PED_SPRINT~ cuando la barra de potencia esté llena~n~~k~~PED_FIREWEAPON~ Cambiar la vista~n~~k~~VEHICLE_ENTER_EXIT~ Salir", "Pulsa ~k~~PED_SPRINT~ cuando la barra de potencia esté llena~n~~k~~PED_FIREWEAPON~ Cambiar la vista~n~~k~~VEHICLE_ENTER_EXIT~ Salir" } },
    { "GF_0048", { "Your girlfriend is not at home right now. Try again later.", "Ta meuf est pas encore rentrée chez elle, reviens plus tard.", "Deine Freundin ist gerade nicht zu Hause. Versuche es später noch einmal.", "La tua fidanzata ora non è a casa. Passa più tardi.", "Ahora mismo tu novia no está en casa. Inténtalo más tarde.", "Твоей девушки нет дома. Приходи позже.", "Ahora mismo tu novia no está en casa. Inténtalo más tarde.", "Ahora mismo tu novia no está en casa. Inténtalo más tarde." } },
    { "GF_0049", { "Go and get a nice car for your girlfriend!", "Va chercher une belle caisse pour ta meuf_!", "Besorg einen hübschen Wagen für deine Freundin!", "Vai a procurarti una bella auto per la tua ragazza!", "¡Ve a por un buen coche para tu novia!", "Найди хорошую машину для своей девушки!", "¡Ve a por un buen coche para tu novia!", "¡Ve a por un buen coche para tu novia!" } },
    { "GF_APP0", { "You missed your date with Denise. She won't be happy.", "T'as posé un lapin à Denise. Elle va faire la gueule.", "Du hast dein Date mit Denise verpasst. Sie wird darüber nicht begeistert sein.", "Hai mancato l'appuntamento con Denise... non sarà contenta.", "Se te ha pasado tu cita con Denise. No se va a alegrar por ello.", "Ты пропустил свое свидание с Дениз. Она будет расстроена.", "Se te ha pasado tu cita con Denise. No se va a alegrar por ello.", "Se te ha pasado tu cita con Denise. No se va a alegrar por ello." } },
