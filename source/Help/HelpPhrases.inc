    { "DS1_29", { "~s~Do 5 laps in as quick a time as possible.~n~Target time is under 40 seconds.", "~s~Boucle 5 tours le plus vite possible.~n~Tu dois faire moins de 40 secondes.", "~s~Fahre so schnell wie möglich 5 Runden.~n~Ziel ist es, unter 40 Sekunden zu bleiben.", "~s~Fai 5 giri di pista in più velocemente possibile.~n~Il tuo obiettivo è stare sotto i 40 secondi.", "~s~Da 5 vueltas tan rápido como puedas.~n~El tiempo objetivo está por debajo de los 40 segundos.", "~s~Пройди 5 кругов как можно быстрее.~n~Ты должен уложиться в 40 секунд.", "~s~Da 5 vueltas tan rápido como puedas.~n~El tiempo objetivo está por debajo de los 40 segundos.", "~s~Da 5 vueltas tan rápido como puedas.~n~El tiempo objetivo está por debajo de los 40 segundos." } },
    { "DS1_31", { "~s~Drive to the other side of the city and back without damaging the car.~n~The target time is UNDER 120 seconds (2 minutes).", "~s~Fais un aller-retour jusqu'à l'autre bout de la ville sans esquinter la caisse.~n~Tu dois faire ça EN MOINS de 120 secondes.", "~s~Fahr auf die andere Seite der Stadt und wieder zurück, ohne den Wagen zu beschädigen.~n~Ziel ist es, unter 120 Sekunden zu bleiben.", "~s~Guida fino all'altro capo della città e ritorna senza danneggiare l'auto.~n~Tempo limite: meno di 120 secondi.", "~s~Conduce hasta el otro lado de la ciudad y vuelve sin dañar el coche.~n~El tiempo objetivo es menos de 120 segundos (2 minutos).", "~s~Езжай на другой конец города и возвратись назад, не повредив машину.~n~Ты должен уложиться в 120 сек. (2 минуты).", "~s~Conduce hasta el otro lado de la ciudad y vuelve sin dañar el coche.~n~El tiempo objetivo es menos de 120 segundos (2 minutos).", "~s~Conduce hasta el otro lado de la ciudad y vuelve sin dañar el coche.~n~El tiempo objetivo es menos de 120 segundos (2 minutos)." } },
    { "DS1_32", { "~s~Powerslide around a tight corner and stop in the allocated area.", "~s~Fais un dérapage contrôlé dans un virage serré et arrête-toi à l'endroit indiqué.", "~s~Mache einen Powerslide um eine enge Kurve und halte in dem markierten Bereich.", "~s~Prendi in derapata una curva stretta e fermati nella zona prevista.", "~s~Haz un derrape alrededor de una esquina cerrada y detente en la zona designada.", "~s~Соверши поворот при помощи заноса и остановись в обозначенном месте.", "~s~Haz un derrape alrededor de una esquina cerrada y detente en la zona designada.", "~s~Haz un derrape alrededor de una esquina cerrada y detente en la zona designada." } },
    { "DS1_34", { "~s~Keep the car on two wheels until the end of the track.", "~s~Reste sur deux roues jusqu'au bout de la piste.", "~s~Halte den Wagen bis Ende der Strecke auf zwei Reifen.", "~s~Mantieni l'auto su due ruote fino alla fine del tracciato.", "~s~Mantén el coche sobre dos ruedas hasta el final de la pista.", "~s~Проедь на двух колесах до конца трассы.", "~s~Mantén el coche sobre dos ruedas hasta el final de la pista.", "~s~Mantén el coche sobre dos ruedas hasta el final de la pista." } },
    { "DS1_35", { "~s~Perform a P.I.T. Maneuver to spin the other car around with minimum damage.~n~Finish as close to the other car as possible.", "~s~Fais une manoeuvre d'intervention rapide pour envoyer valser l'autre caisse avec un minimum de dégâts.~n~Termine le plus près possible de l'autre bagnole.", "~s~Bring das andere Auto ins Schleudern, ohne dass du größeren Schaden nimmst.~n~Fahre so nah wie möglich an dem anderen Auto durchs Ziel.", "~s~Esegui una manovra P.I.T. per far sbandare l'altra auto senza troppi danni.~n~Cerca di arrivare il più vicino possibile all'altra macchina.", "~s~Usa la técnica de detención para hacer girar al otro coche con el mínimo daño.~n~Acaba tan cerca del otro coche como puedas.", "~s~Выполни Р.I.Т. разворот, чтобы повернуть другую машину на 180 градусов с минимумом повреждений.~n~Остановись как можно ближе к ней.", "~s~Usa la técnica de detención para hacer girar al otro coche con el mínimo daño.~n~Acaba tan cerca del otro coche como puedas.", "~s~Usa la técnica de detención para hacer girar al otro coche con el mínimo daño.~n~Acaba tan cerca del otro coche como puedas." } },
    { "DS1_36", { "~s~Weave through the cones quickly and then return to the start position.", "~s~Tourne rapidement autour des cônes et reviens à la position de départ.", "~s~Schlängle dich rasch durch die Pylone und begib dich wieder in Startposition.", "~s~Passa tra i coni rapidamente e poi torna alla posizione iniziale.", "~s~Pasa entre los conos rápidamente y vuelve a la posición de inicio.", "~s~Быстро объедь конусы и вернись на стартовую позицию.", "~s~Pasa entre los conos rápidamente y vuelve a la posición de inicio.", "~s~Pasa entre los conos rápidamente y vuelve a la posición de inicio." } },
