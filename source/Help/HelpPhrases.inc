    { "MUS1_2", { "~s~When you get to the beach party, go and talk to the ~y~DJ~s~.", "~s~Quand t'arriveras à la fête sur la plage, va parler à la ~y~DJ~s~.", "~s~Wenn du bei der Beachparty bist, sprich mit der ~y~DJ-Frau~s~.", "~s~Quando arrivi alla festa sulla spiaggia, parla con la ~y~DJ~s~.", "~s~Al llegar a la fiesta en la playa, ve a hablar con la ~y~DJ~s~.", "~s~Когда прибудешь на пляжную вечеринку, поговори с ~y~ДиДжеем~s~.", "~s~Al llegar a la fiesta en la playa, ve a hablar con la ~y~DJ~s~.", "~s~Al llegar a la fiesta en la playa, ve a hablar con la ~y~DJ~s~." } },
    { "MUS1_3", { "~s~If you talk for a while, the DJ will ask you to dance for her.", "~s~Si tu lui parles assez longtemps, la DJ te demandera de danser pour elle.", "~s~Wenn ihr eine Weile plaudert, wird die DJ-Frau dich bitten, für sie zu tanzen.", "~s~Se parli per un po', la DJ ti chiederà di ballare per lei.", "~s~Si hablas durante un rato, la DJ te pedirá que bailes para ella.", "~s~ЕСЛИ ТЫ РАЗГОВОРИШЬ ЕЕ, ДИДЖЕИ ПОПРОСИТ ТЕБЯ СТАНЦЕВАТЬ ДЛЯ НЕЕ.", "~s~Si hablas durante un rato, la DJ te pedirá que bailes para ella.", "~s~Si hablas durante un rato, la DJ te pedirá que bailes para ella." } },
    { "MUS1_4", { "~s~Get a score of 2500 or greater to gain access to the sound van.", "~s~Obtiens un score de 2500 ou plus pour accéder à la camionnette de la sono.", "~s~Erreiche mindestens 2500 Punkte, um Zugriff auf den Sound Van zu erhalten.", "~s~Ottieni un punteggio di 2500 o superiore per accedere al furgone con l'apparecchiatura.", "~s~Obtén una puntuación de 2500 o más para acceder a la furgoneta con el equipo de música.", "~s~Набери 2500 очков и больше, чтобы получить доступ к фургону с аудиоаппаратурой.", "~s~Obtén una puntuación de 2500 o más para acceder a la furgoneta con el equipo de música.", "~s~Obtén una puntuación de 2500 o más para acceder a la furgoneta con el equipo de música." } },
    { "MUS1_5", { "~s~Go to the ~y~beach party~s~.", "~s~Va à la ~y~fête sur la plage~s~.", "~s~Fahr zu der ~y~Beachparty~s~.", "~s~Vai alla ~y~festa sulla spiaggia~s~.", "~s~Ve a la ~y~fiesta en la playa~s~.", "~s~Отправляйся на ~y~пляжную вечеринку~s~.", "~s~Ve a la ~y~fiesta en la playa~s~.", "~s~Ve a la ~y~fiesta en la playa~s~." } },
    { "MUS1_6", { "~s~Get back into the ~b~sound van~s~.", "~s~Remonte dans la ~b~camionnette de la sono~s~.", "~s~Steig wieder in den ~b~Sound Van~s~.", "~s~Ritorna nel ~b~furgone con l'impianto audio~s~.", "~s~Vuelve a la ~b~furgoneta con el equipo de música~s~.", "~s~Вернись в ~b~фургон с аппаратурой~s~.", "~s~Vuelve a la ~b~furgoneta con el equipo de música~s~.", "~s~Vuelve a la ~b~furgoneta con el equipo de música~s~." } },
    { "MUS1_C", { "Moves correct (%)", "Mouvements corrects (%)", "Korrekte Moves (%)", "Mosse corrette (%)", "Movimientos correctos (%)", "Верных движений, %", "Movimientos correctos (%)", "Movimientos correctos (%)" } },
    { "MUS1_7", { "~s~Steal the ~b~sound van.", "~s~Vole la ~b~camionnette de la sono~s~.", "~s~Klau den ~b~Sound-Van~s~.", "~s~Ruba il ~b~furgone musicale~s~.", "~s~Roba el ~b~furgón de sonido~s~.", "~s~Угони ~b~фургон с аппаратурой~s~.", "~s~Roba el ~b~furgón de sonido~s~.", "~s~Roba el ~b~furgón de sonido~s~." } },
    { "MUS1_19", { "~s~Get the van back to the ~y~garage.", "~s~Ramène la camionnette au ~y~garage~s~.", "~s~Fahr den Van zur ~y~Werkstatt~s~.", "~s~Porta il furgone al ~y~garage~s~.", "~s~Mete el furgón en el ~y~garaje~s~.", "~s~Пригони фургон к ~y~гаражу~s~.", "~s~Mete el furgón en el ~y~garaje~s~.", "~s~Mete el furgón en el ~y~garaje~s~." } },
    { "MUS1_20", { "~r~The van was destroyed!", "~r~La camionnette est niquée_!", "~r~Der Van wurde zerstört!", "~r~Il furgone è stato distrutto!", "~r~¡El furgón ha sido destruido!", "~r~Фургон уничтожен!", "~r~¡El furgón ha sido destruido!", "~r~¡El furgón ha sido destruido!" } },
    { "MUS1_21", { "~r~You wrecked the party!", "~r~T'as gâché la teuf_!", "~r~Du hast die Party in einen Trümmerhaufen verwandelt!", "~r~Hai rovinato la festa!", "~r~¡Te has cargado la fiesta!", "~r~Ты разогнал вечеринку!", "~r~¡Te has cargado la fiesta!", "~r~¡Te has cargado la fiesta!" } },
    { "MUS1_1", { "~s~Go to the beach party and talk to the ~y~DJ.", "~s~Va à la fête sur la plage et parle à la ~y~DJ~s~.", "~s~Geh auf die Beachparty und sprich mit dem ~y~DJ.", "~s~Vai al party sulla spiaggia e parla con la ~y~DJ.", "~s~Ve a la fiesta en la playa y habla con la ~y~DJ~s~.", "~s~ИДИ НА ПЛЯЖНУЮ ВЕЧЕРИНКУ И ПОГОВОРИ С ~y~ДИДЖЕЕМ.", "~s~Ve a la fiesta en la playa y habla con la ~y~DJ~s~.", "~s~Ve a la fiesta en la playa y habla con la ~y~DJ~s~." } },
    { "MUS1_18", { "~r~The DJ died!", "~r~La DJ est morte_!", "~r~Der DJ ist tot!", "~r~La DJ è morta!", "~r~¡La DJ ha muerto!", "~r~ДиДжей мертв!", "~r~¡La DJ ha muerto!", "~r~¡La DJ ha muerto!" } },
    { "STP2_32", { "Using the camera movement controls you can rotate the camera, this is for looking around corners and spotting enemies.", "Utilise les contrôles de mouvement de la caméra pour faire pivoter la caméra_: tu peux alors jeter un coup d'oeil au détour d'un coin et repérer tes ennemis.", "Mit der Kamerakontrolle kannst du die Kamera drehen und so um Ecken sehen und Gegner ausmachen.", "Puoi ruotare la telecamera usando i comandi della visuale, utile per guardare oltre gli angoli e avvistare i nemici.", "Usa los controles de movimiento de cámara para rotar la cámara, te servirá para mirar detrás de las esquinas y descubrir a los enemigos.", "Используя мышь или клавиши управления камерой ты можешь вращать камеру. Благодаря этому очень удобно смотреть за перемещением врагов и что происходит за углами.", "Usa los controles de movimiento de cámara para rotar la cámara, te servirá para mirar detrás de las esquinas y descubrir a los enemigos.", "Usa los controles de movimiento de cámara para rotar la cámara, te servirá para mirar detrás de las esquinas y descubrir a los enemigos." } },
    { "STP2_34", { "~s~To use the skateboard pick it up and select it from the weapons inventory items. Press ~k~~PED_ANSWER_PHONE~ whilst over it to pick it up if your inventory is full.", "~s~Pour utiliser le skateboard, prends-le et sélectionne-le dans l'inventaire des armes. Appuie sur ~k~~PED_ANSWER_PHONE~ quand t'es dessus pour le ramasser si ton inventaire est déjà plein.", "~s~Um das Skateboard zu benutzen, heb es auf und wähle es im Waffeninventar aus. Drücke ~k~~PED_ANSWER_PHONE~, während du darüber stehst, falls dein Inventar voll ist.", "~s~Per usare lo skateboard, raccoglilo e selezionalo tra gli oggetti dell'inventario delle armi. Se il tuo inventario è pieno, per raccoglierlo premi ~k~~PED_ANSWER_PHONE~ mentre ti ci trovi sopra.", "~s~Para usar el monopatín, recógelo y selecciónalo en tu inventario de armas. Pulsa ~k~~PED_ANSWER_PHONE~ cuando estés sobre él para recogerlo si tu inventario está lleno.", "~s~ЧТОБЫ ИСПОЛЬЗОВАТЬ СКEnterБОРД ПОДНИМИТЕ ЕГО И ВЫБЕРИТЕ ИЗ СПИСКА ВАШЕГО ИНВЕНТАРЯ. ЖМИТЕ ~k~~PED_ANSWER_PHONE~ НАХОДЯСЬ ОКОЛО НЕГО ЧТОБЫ ВЫБРАТЬ ЕСЛИ ВАШ ИНВЕНТАРЬ ПЕРЕПОЛНЕН.", "~s~Para usar el monopatín, recógelo y selecciónalo en tu inventario de armas. Pulsa ~k~~PED_ANSWER_PHONE~ cuando estés sobre él para recogerlo si tu inventario está lleno.", "~s~Para usar el monopatín, recógelo y selecciónalo en tu inventario de armas. Pulsa ~k~~PED_ANSWER_PHONE~ cuando estés sobre él para recogerlo si tu inventario está lleno." } },
    { "STP2_38", { "To use the skateboard, select the it from your weapons inventory. Use the movement controls to steer the skateboard. Tapping ~k~~PED_SPRINT~ helps you pick up speed and ~k~~PED_JUMPING~ makes you jump.", "Pour utiliser le skateboard, sélectionne-le dans l'inventaire des armes. Utilise les contrôles de déplacement pour le diriger. Appuie plusieurs fois sur ~k~~PED_SPRINT~ pour prendre de la vitesse et sur ~k~~PED_JUMPING~ pour sauter.", "Um das Skateboard zu benutzen, wähle es im Waffeninventar aus. Benutze die Bewegungskontrolle, um das Skateboard zu steuern. Durch Tippen auf ~k~~PED_SPRINT~ wirst du schneller, mit ~k~~PED_JUMPING~ springst du.", "Per usare lo skateboard, selezionalo dall'inventario delle armi. Usa i comandi di movimento per sterzare. Premendo ~k~~PED_SPRINT~ potrai guadagnare velocità e con ~k~~PED_JUMPING~ potrai saltare.", "Para usar el monopatín, selecciónalo del inventario de armas. Usa los controles de movimiento para maniobrar con él. Pulsar ~k~~PED_SPRINT~ te ayuda a ganar velocidad y con ~k~~PED_JUMPING~ puedes saltar.", "Чтобы использовать скейтборд, выбери его в своем инвентаре для оружия. Клавиши управления - повороты. Многократное нажатие ~k~~PED_SPRINT~ - ускорение, ~k~~PED_JUMPING~ - прыжок.", "Para usar el monopatín, selecciónalo del inventario de armas. Usa los controles de movimiento para maniobrar con él. Pulsar ~k~~PED_SPRINT~ te ayuda a ganar velocidad y con ~k~~PED_JUMPING~ puedes saltar.", "Para usar el monopatín, selecciónalo del inventario de armas. Usa los controles de movimiento para maniobrar con él. Pulsar ~k~~PED_SPRINT~ te ayuda a ganar velocidad y con ~k~~PED_JUMPING~ puedes saltar." } },
    { "STP2_39", { "~r~Madd Dogg's personal security ~s~are patrolling the mansion. Do not use any guns on your way to the rhyme book - you will alert them. Use stealth to steal the rhyme book.", "Le ~r~service de sécurité de Madd Dogg ~s~patrouille dans le manoir. N'utilise pas de flingue en allant récupérer le bouquin de lyrics ou tu te ferais repérer. Sois discret.", "~r~Leibwächter~s~ patrouillieren in der Villa. Setze hier keine Schusswaffen ein, sonst alarmierst du sie. Schleich dich unbemerkt rein und klau das Buch.", "~r~Le guardie personali di Madd Dogg ~s~sono di pattuglia. Non usare armi da fuoco o le allerterai. Muoviti furtivamente per rubare il quaderno.", "~r~El personal de seguridad de Madd Dogg~s~ patrulla la mansión. No uses armas o los alertarás. Usa el sigilo para robar el libro de rimas.", "~r~Личная охрана Мэдд Догга~s~ патрулирует особняк. Не используй никакого огнестрельного оружия по пути к студии звукозаписи - ты можешь поднять тревогу.", "~r~El personal de seguridad de Madd Dogg~s~ patrulla la mansión. No uses armas o los alertarás. Usa el sigilo para robar el libro de rimas.", "~r~El personal de seguridad de Madd Dogg~s~ patrulla la mansión. No uses armas o los alertarás. Usa el sigilo para robar el libro de rimas." } },
    { "STP2_40", { "~y~Exit ~s~the mansion and get the rhyme book back to OG loc. It's safe to use your weapons now, although it may be less risky if you use stealth to get past any ~r~guards ~s~on patrol.", "~y~Quitte ~s~le manoir et rends le bouquin de lyrics à OG Loc. Tu peux te servir de tes flingues maintenant, mais ce sera toujours plus risqué que d'essayer de passer discrètement les ~r~gardes ~s~en patrouille.", "~y~Verlasse ~s~die Villa und bring das Versbuch zu OG Loc. Jetzt kannst du deine Waffen einsetzen, obwohl es wahrscheinlich weniger riskant ist, dich unbemerkt an den ~r~Wachen ~s~vorbei zu schleichen.", "~y~Esci ~s~dalla casa e porta il quaderno delle rime a OG Loc. Ora puoi usare le armi, sebbene sia meno rischioso ricorrere al movimento furtivo per superare le ~r~guardie ~s~.", "~y~Sal ~s~de la mansión y llévale el libro de rimas a OG Loc. Ya puedes usar armas, aunque es menos arriesgado emplear el sigilo para esquivar a cualquier ~r~guardia ~s~de patrulla.", "~y~Покинь~s~ особняк и отнеси книжку со стихами ОG Lос'у. Теперь ты можешь использовать огнестрельное оружие, но лучше пройти к выходу мимо ~r~охранников~s~, не вызывая тревоги.", "~y~Sal ~s~de la mansión y llévale el libro de rimas a OG Loc. Ya puedes usar armas, aunque es menos arriesgado emplear el sigilo para esquivar a cualquier ~r~guardia ~s~de patrulla.", "~y~Sal ~s~de la mansión y llévale el libro de rimas a OG Loc. Ya puedes usar armas, aunque es menos arriesgado emplear el sigilo para esquivar a cualquier ~r~guardia ~s~de patrulla." } },
    { "STP2_1", { "~s~Go to ~y~Madd Dogg's mansion~s~.", "~s~Va au ~y~manoir de Madd Dogg~s~.", "~s~Begib dich zu ~y~Madd Doggs Villa~s~.", "~s~Vai alla ~y~casa di Madd Dogg~s~.", "~s~Ve a la ~y~mansión de Madd Dogg~s~.", "~s~Отправляйся к ~y~особняку Мэдд Догга~s~.", "~s~Ve a la ~y~mansión de Madd Dogg~s~.", "~s~Ve a la ~y~mansión de Madd Dogg~s~." } },
    { "STP2_2", { "~s~The ~y~main door ~s~is around the back of the mansion.", "~s~La ~y~porte principale ~s~se trouve à l'arrière du manoir.", "~s~Der ~y~Haupteingang~s~ befindet sich auf der Rückseite der Villa.", "~s~La ~y~porta principale ~s~è sul retro dell'edificio.", "~s~La ~y~puerta ~s~está en la parte de atrás de la mansión.", "~s~~y~Парадный вход~s~ расположен за особняком.", "~s~La ~y~puerta ~s~está en la parte de atrás de la mansión.", "~s~La ~y~puerta ~s~está en la parte de atrás de la mansión." } },
    { "STP2_3", { "~s~The ~g~rhyme book ~s~is in Madd Dogg's recording studio.", "~s~Le ~g~bouquin de lyrics ~s~est dans le studio d'enregistrement de Madd Dogg.", "~s~Das ~g~Versbuch~s~ ist in Madd Doggs Aufnahmestudio.", "~s~Il ~g~libro delle rime ~s~è nello studio di registrazione di Madd Dogg.", "~s~El ~g~libro de rimas ~s~está en el estudio de grabación de Madd Dogg.", "~s~~g~Книжка со стихами~s~ находится в студии звукозаписи Мэдд Догга.", "~s~El ~g~libro de rimas ~s~está en el estudio de grabación de Madd Dogg.", "~s~El ~g~libro de rimas ~s~está en el estudio de grabación de Madd Dogg." } },
    { "STP2_4", { "~r~Madd Dogg's personal security ~s~are patrolling the mansion. You do not have any powerful weapons, stealth is your best option here.", "La ~r~sécurité personnelle de Madd Dogg ~s~patrouille dans le manoir. T'as pas d'armes puissantes, il va falloir y employer la méthode ninja.", "~r~Madd Doggs Leibwächter~s~ patrouillieren in der Villa. Du hast keine Schusswaffen. Versuche, unbemerkt zu bleiben.", "~r~Le guardie di sicurezza di Madd Dogg ~s~stanno pattugliando la casa. Non hai armi potenti, per cui la furtività sarà la tua migliore alleata.", "~r~El personal de seguridad de Madd Dogg~s~ patrulla la mansión. No tienes armas potentes, tu mejor opción es el sigilo.", "~r~Личная охрана Мэдд Догга~s~ патрулирует особняк. У тебя нет мощного оружия, скрытность - лучшее решение при перемещении по дому.", "~r~El personal de seguridad de Madd Dogg~s~ patrulla la mansión. No tienes armas potentes, tu mejor opción es el sigilo.", "~r~El personal de seguridad de Madd Dogg~s~ patrulla la mansión. No tienes armas potentes, tu mejor opción es el sigilo." } },
    { "STP2_5", { "~s~The first ~r~guard ~s~cannot see you. This means you can sneak up behind him with a melee weapon and perform a ~h~stealth kill~s~.", "~s~Le premier ~r~garde~s~ peut pas te voir. Tu peux donc t'approcher de lui avec une arme de corps à corps et le ~h~buter discrètement~s~.", "~s~Der erste ~r~Wachmann~s~ kann dich nicht sehen. Du kannst dich also mit einer Nahkampfwaffe heranschleichen und ihn ~h~unbemerkt ausschalten~s~.", "~s~La prima ~r~guardia ~s~non può vederti. Ciò significa che puoi raggiungerla furtivamente con un'arma da corpo a corpo e ~h~ucciderla in silenzio~s~.", "~s~El primer ~r~guardia ~s~no te ve. Puedes acercarte sigilosamente con un arma de combate cuerpo a cuerpo y ~h~eliminarlo en silencio~s~.", "~s~Первый ~r~охранник~s~ не видит тебя. Это значит, что ты можешь подкрасться к нему сзади и произвести ~h~стелс-убийство~s~ при помощи оружия ближнего боя.", "~s~El primer ~r~guardia ~s~no te ve. Puedes acercarte sigilosamente con un arma de combate cuerpo a cuerpo y ~h~eliminarlo en silencio~s~.", "~s~El primer ~r~guardia ~s~no te ve. Puedes acercarte sigilosamente con un arma de combate cuerpo a cuerpo y ~h~eliminarlo en silencio~s~." } },
    { "STP2_13", { "~s~A ~r~guard ~s~is patrolling the swimming pool area. Observing his route will allow you to work out how to get past him undetected.", "~s~Un ~r~garde~s~ patrouille près de la piscine. Observe bien son trajet pour passer discrètement.", "~s~Ein ~r~Wachmann~s~ patroulliert im Bereich des Pools. Wenn du seine Route beobachtest, kannst du planen, wie du ihn unbemerkt umgehen kannst.", "~s~Una ~r~guardia ~s~sta pattugliando la zona della piscina. Studiando il suo percorso potrai decidere come superarla.", "~s~Un ~r~guardia ~s~patrulla la zona de la piscina. Observar su ruta te permitirá planear cómo pasar sin que te detecte.", "~s~~r~Охранник~s~ патрулирует помещение с бассейном. Проследи его перемещение по комнате и проберись мимо него незамеченным.", "~s~Un ~r~guardia ~s~patrulla la zona de la piscina. Observar su ruta te permitirá planear cómo pasar sin que te detecte.", "~s~Un ~r~guardia ~s~patrulla la zona de la piscina. Observar su ruta te permitirá planear cómo pasar sin que te detecte." } },
    { "STP2_14", { "~s~There are lots of shadows in this area to hide in. Hiding in shadows makes it difficult for a ~r~guard ~s~to spot you.", "~s~Il y a beaucoup de zones d'ombre pour te planquer par ici. Lorsque tu te caches dans l'ombre, les ~r~gardes ~s~ont plus de mal à te repérer.", "~s~In diesem Bereich gibt es viele Schatten, in denen du dich verstecken kannst. So bist du für einen ~r~Wachmann~s~ schlecht zu sehen.", "~s~Ci sono diverse zone in ombra tra cui nascondersi, in questo modo la ~r~guardia ~s~farà più fatica a vederti.", "~s~En esta zona hay muchas sombras en las que ocultarse. Ocultarse en las sombras dificulta que un ~r~guardia ~s~te descubra.", "~s~Вокруг бассейна есть тенистые места, в которых можно спрятаться, при этом ~r~охраннику~s~ будет сложнее тебя обнаружить.", "~s~En esta zona hay muchas sombras en las que ocultarse. Ocultarse en las sombras dificulta que un ~r~guardia ~s~te descubra.", "~s~En esta zona hay muchas sombras en las que ocultarse. Ocultarse en las sombras dificulta que un ~r~guardia ~s~te descubra." } },
    { "STP2_15", { "~s~A ~r~guard ~s~is coming.", "~s~Un ~r~garde ~s~arrive.", "~s~Ein ~r~Wachmann~s~ kommt.", "~s~Sta arrivando una ~r~guardia~s~.", "~s~Se acerca un ~r~guardia~s~.", "~s~~r~Охранник~s~ приближается.", "~s~Se acerca un ~r~guardia~s~.", "~s~Se acerca un ~r~guardia~s~." } },
    { "STP2_16", { "~s~Find a suitable place to hide before he spots you. Look for an area with shadows.", "~s~Trouve un endroit où te planquer avant de te faire repérer. Cherche une zone d'ombre.", "Such dir ein geeignetes Versteck, bevor er dich bemerkt. Such nach einem Bereich, wo es Schatten gibt.", "~s~Trova un posto adatto per nasconderti prima che ti veda. Cerca una zona in ombra.", "~s~Busca una zona con sombras para esconderte antes de que te descubra.", "~s~Найди подходящее тенистое место, чтобы спрятаться там до того, как тебя обнаружат.", "~s~Busca una zona con sombras para esconderte antes de que te descubra.", "~s~Busca una zona con sombras para esconderte antes de que te descubra." } },
    { "STP2_19", { "~s~If you walk straight past the ~r~guard ~s~here he will see you. Try crouching and walking past the bar to remain out of his line of sight.", "~s~Si t'essaies de passer devant le ~r~garde ~s~ici, il te verra. Accroupis-toi et passe devant le bar pour rester hors de son champ de vision.", "~s~Wenn du hier einfach an dem ~r~Wachmann~s~ vorbeigehst, sieht er dich. Duck dich und geh an der Bar vorbei, um unentdeckt zu bleiben.", "~s~Se cercherai di oltrepassare la ~r~guardia~s~ in questo punto, ti vedrà. Tenta di stare basso e passare lungo il bancone.", "~s~El ~r~guardia ~s~te verá si pasas por aquí. Pasa agachado por detrás de la barra para permanecer fuera de su línea visual.", "~s~Если ты просто пройдешь мимо ~r~охранника~s~, он заметит тебя. Попробуй присесть и пройти вдоль барной стойки, где он не сможет тебя увидеть.", "~s~El ~r~guardia ~s~te verá si pasas por aquí. Pasa agachado por detrás de la barra para permanecer fuera de su línea visual.", "~s~El ~r~guardia ~s~te verá si pasas por aquí. Pasa agachado por detrás de la barra para permanecer fuera de su línea visual." } },
    { "STP2_29", { "~s~Use the skills you have learned to get past any ~r~guards ~s~on patrol and ~y~exit ~s~the mansion so you can get the rhyme book back to OG Loc.", "~s~Mets en pratique ce que t'as appris pour éviter les ~r~gardes ~s~en patrouille, ~y~sors ~s~du manoir et va donner le bouquin de lyrics à OG Loc.", "~s~Setze die erlernten Fähigkeiten ein, um an jedem der patrouillierenden ~r~Wachmänner~s~ vorbeizukommen. ~y~Verlasse~s~ die Villa, damit du OG Loc das Versbuch bringen kannst.", "~s~Usa le tecniche che hai appreso per superare le ~r~guardie ~s~di pattuglia e ~y~uscire ~s~dalla casa, così da riportare il libro delle rime a OG Loc.", "~s~Usa las habilidades que has aprendido para eludir a los ~r~guardias ~s~de patrulla y ~y~sal ~s~de la mansión para llevarle el libro de rimas a OG Loc.", "~s~Используй опыт, который ты получил, чтобы пройти мимо ~r~охранников~s~ и ~y~покинуть~s~ особняк, после чего передай книгу с рифмами ОG Lос'у.", "~s~Usa las habilidades que has aprendido para eludir a los ~r~guardias ~s~de patrulla y ~y~sal ~s~de la mansión para llevarle el libro de rimas a OG Loc.", "~s~Usa las habilidades que has aprendido para eludir a los ~r~guardias ~s~de patrulla y ~y~sal ~s~de la mansión para llevarle el libro de rimas a OG Loc." } },
    { "STP2_30", { "~s~You need to take the rhyme book back to OG Loc. He is at ~y~Burger Shot~s~.", "~s~Il faut que tu rapportes les lyrics à OG Loc. Il est au ~y~Burger Shot~s~.", "~s~Du musst das Versbuch zu OG Loc bringen. Er ist im ~y~Burger Shot~s~.", "~s~Devi riportare il libro delle rime a OG Loc, si trova al ~y~Burger Shot~s~.", "~s~Tienes que llevarle el libro de rimas a OG Loc, está en el ~y~Burger Shot~s~.", "~s~ТЫ ДОЛЖЕН ПЕРЕДАТЬ КНИГУ РИФМ ОУДЖИ ЛОКУ. ОН НАХОДИТСЯ В ~y~БУРГЕР-ШОТ~s~.", "~s~Tienes que llevarle el libro de rimas a OG Loc, está en el ~y~Burger Shot~s~.", "~s~Tienes que llevarle el libro de rimas a OG Loc, está en el ~y~Burger Shot~s~." } },
    { "STP3_34", { "~s~Press and hold ~k~~VEHICLE_ENTER_EXIT~ to bail out now!", "~s~Appuie et maintiens ~k~~VEHICLE_ENTER_EXIT~ enfoncée pour sauter maintenant_!", "~s~Halte ~k~~VEHICLE_ENTER_EXIT~ gedrückt, um jetzt rauszuspringen!", "~s~Tieni premuto ~k~~VEHICLE_ENTER_EXIT~ per gettarti fuori!", "~s~¡Ahora, pulsa y mantén ~k~~VEHICLE_ENTER_EXIT~ para tirarte del vehículo!", "~s~Нажми и держи ~k~~VEHICLE_ENTER_EXIT~, чтобы выпрыгнуть из машины!", "~s~¡Ahora, pulsa y mantén ~k~~VEHICLE_ENTER_EXIT~ para tirarte del vehículo!", "~s~¡Ahora, pulsa y mantén ~k~~VEHICLE_ENTER_EXIT~ para tirarte del vehículo!" } },
    { "STP3_35", { "~s~Keep your speed up to the end of the pier then press and hold ~k~~VEHICLE_ENTER_EXIT~ to bail out.", "~s~Maintiens ta vitesse jusqu'au bout de la jetée, puis appuie et maintiens ~k~~VEHICLE_ENTER_EXIT~ enfoncée pour sauter.", "~s~Halte das Tempo bis zum Ende des Piers und halte dann ~k~~VEHICLE_ENTER_EXIT~ gedrückt, um rauszuspringen.", "~s~Tieni alta la velocità fino alla fine del molo e poi tieni premuto ~k~~VEHICLE_ENTER_EXIT~ per gettarti fuori.", "~s~Mantén tu velocidad hasta el final del muelle y pulsa ~k~~VEHICLE_ENTER_EXIT~ para tirarte el vehículo.", "~s~Сохраняй скорость до конца пирса, после чего нажми ~k~~VEHICLE_ENTER_EXIT~, чтобы выпрыгнуть из машины.", "~s~Mantén tu velocidad hasta el final del muelle y pulsa ~k~~VEHICLE_ENTER_EXIT~ para tirarte el vehículo.", "~s~Mantén tu velocidad hasta el final del muelle y pulsa ~k~~VEHICLE_ENTER_EXIT~ para tirarte el vehículo." } },
    { "STP3_27", { "~s~Press ~k~~VEHICLE_ENTER_EXIT~ to bail out now!", "~s~Appuie sur ~k~~VEHICLE_ENTER_EXIT~ pour t'éjecter maintenant_!", "~s~Drücke ~k~~VEHICLE_ENTER_EXIT~, um sofort rauszuspringen!", "~s~Ora premi ~k~~VEHICLE_ENTER_EXIT~ per lanciarti fuori!", "~s~¡Ahora, pulsa ~k~~VEHICLE_ENTER_EXIT~ para saltar!", "~s~Нажми и держи ~k~~VEHICLE_ENTER_EXIT~, чтобы выпрыгнуть из машины!", "~s~¡Ahora, pulsa ~k~~VEHICLE_ENTER_EXIT~ para saltar!", "~s~¡Ahora, pulsa ~k~~VEHICLE_ENTER_EXIT~ para saltar!" } },
    { "STP3_29", { "~s~Keep your speed up to the end of the pier then press ~k~~VEHICLE_ENTER_EXIT~ to bail out.", "~s~Maintiens ta vitesse jusqu'au bout de la jetée et appuie sur ~k~~VEHICLE_ENTER_EXIT~ pour t'éjecter.", "~s~Behalte dein Tempo bis zum Ende des Piers bei und drücke dann ~k~~VEHICLE_ENTER_EXIT~, um rauszuspringen.", "~s~Mantieni la velocità fino alla fine del molo e premi ~k~~VEHICLE_ENTER_EXIT~ per lanciarti fuori.", "~s~Mantén la velocidad hasta el final del muelle y luego pulsa ~k~~VEHICLE_ENTER_EXIT~ para saltar.", "~s~Сохраняй свою скорость до конца пирса, после чего нажми ~k~~VEHICLE_ENTER_EXIT~, чтобы выпрыгнуть из машины.", "~s~Mantén la velocidad hasta el final del muelle y luego pulsa ~k~~VEHICLE_ENTER_EXIT~ para saltar.", "~s~Mantén la velocidad hasta el final del muelle y luego pulsa ~k~~VEHICLE_ENTER_EXIT~ para saltar." } },
    { "STP3_33", { "~s~Go and meet up with the other ~y~drivers~s~ before 10pm. Don't damage your car!", "~s~Va retrouver les autres ~y~chauffeurs~s~ avant 22h00. Ruine pas ta caisse_!", "~s~Triff dich vor 22 Uhr mit den anderen ~y~Fahrern~s~. Beschädige dein Auto nicht!", "~s~Incontrati con gli altri ~y~autisti~s~ prima delle 22. Non danneggiare la tua automobile!", "~s~Ve y reúnete con los otros ~y~conductores~s~ antes de 22:00. ¡No dañes el coche!", "~s~Езжай на встречу с остальными ~y~водителями~s~, ты должен успеть до 22:00. Только не поцарапай тачку!", "~s~Ve y reúnete con los otros ~y~conductores~s~ antes de 22:00. ¡No dañes el coche!", "~s~Ve y reúnete con los otros ~y~conductores~s~ antes de 22:00. ¡No dañes el coche!" } },
    { "STP3_01", { "~s~One of Madd Dogg's Manager's ~r~drivers~s~ is eating at the Burger Shot across town.", "~s~Un des ~r~chauffeurs~s~ du manager de Madd Dogg est en train de manger au Burger Shot, de l'autre côté de la ville.", "~s~Einer der ~r~Fahrer~s~ von Madd Doggs Manager isst im Burger Shot auf der anderen Seite der Stadt.", "~s~Uno degli ~r~autisti~s~ del manager di Madd Dogg sta mangiando al Burger Shot dall'altra parte della città.", "~s~Uno de los ~r~conductores~s~ del mánager de Madd Dogg está comiendo en el Burger Shot al otro lado de la ciudad.", "~s~ОДИН ИЗ ~r~ВОДИТЕЛЕЙ~s~ МЕНЕДЖЕРА БЕЩЕНЫХ ПСОВ ОБЕДАЕТ В БУРГЕР ШОТ, ЭТО НЕДАЛЕКО ОТСЮДА.", "~s~Uno de los ~r~conductores~s~ del mánager de Madd Dogg está comiendo en el Burger Shot al otro lado de la ciudad.", "~s~Uno de los ~r~conductores~s~ del mánager de Madd Dogg está comiendo en el Burger Shot al otro lado de la ciudad." } },
    { "STP3_02", { "~s~Go and steal his ~r~car~s~ and meet the other drivers before 10pm.", "~s~Va chourer sa ~r~caisse~s~ et retrouve les autres chauffeurs avant 22 heures.", "~s~Klau ihm sein ~r~Auto~s~ und triff dich vor 22 Uhr mit den anderen Fahrern.", "~s~Vai a rubare la sua ~r~macchina~s~ e incontrati con gli altri autisti prima delle 22:00.", "~s~Ve allí, róbale el ~r~coche~s~ y reúnete con los otros conductores antes de las 22:00.", "~s~Угони его ~r~машину~s~ и встреть остальных водителей до 22:00.", "~s~Ve allí, róbale el ~r~coche~s~ y reúnete con los otros conductores antes de las 22:00.", "~s~Ve allí, róbale el ~r~coche~s~ y reúnete con los otros conductores antes de las 22:00." } },
    { "STP3_03", { "~r~You were too slow!", "~r~T'as été trop lent_!", "~r~Du warst zu langsam!", "~r~Sei andato troppo piano!", "~r~¡Has sido demasiado lento!", "~r~Ты не успел!", "~r~¡Has sido demasiado lento!", "~r~¡Has sido demasiado lento!" } },
    { "STP3_04", { "~s~Go and meet up with the other ~y~drivers~s~. Don't damage your car!", "~s~Va retrouver les autres ~y~chauffeurs~s~. Fais gaffe à pas bousiller la caisse_!", "~s~Triff dich mit den anderen ~y~Fahrern~s~. Aber fahr dein Auto nicht kaputt!", "~s~Vai a incontrarti con gli altri ~y~autisti~s~. Non danneggiare la tua auto!", "~s~Ve a reunirte con los otros ~y~conductores~s~. ¡No dañes el coche!", "~s~Встреться с остальными ~y~водителями~s~. Не поцарапай свою машину!", "~s~Ve a reunirte con los otros ~y~conductores~s~. ¡No dañes el coche!", "~s~Ve a reunirte con los otros ~y~conductores~s~. ¡No dañes el coche!" } },
    { "STP3_05", { "THE MOOTV AWARDS CEREMONY", "CEREMONIE DES MOOTV AWARDS", "DIE MOOTV-PREISVERLEIHUNG", "LA CERIMONIA DEGLI MOOTV AWARDS", "CEREMONIA DE PREMIOS DE LA MOOTV", "ЦЕРЕМОНИЯ НАГРАЖДЕНИЯ МОО-ТV ", "CEREMONIA DE PREMIOS DE LA MOOTV", "CEREMONIA DE PREMIOS DE LA MOOTV" } },
    { "STP3_06", { "~s~Keep in the middle of the two cars until you reach the awards ceremony.", "~s~Reste entre les deux caisses jusqu'à la cérémonie des Awards.", "~s~Halte dich zwischen den beiden Autos, bis du bei der Preisverleihung bist.", "~s~Tieniti nel mezzo delle due macchine finché non raggiungerai la cerimonia di premiazione.", "~s~Mantente en el medio de los dos coches hasta que llegues a la ceremonia de premios.", "~s~Держись между двумя машинами, пока не доедешь до Церемонии награждения.", "~s~Mantente en el medio de los dos coches hasta que llegues a la ceremonia de premios.", "~s~Mantente en el medio de los dos coches hasta que llegues a la ceremonia de premios." } },
    { "STP3_07", { "~r~You strayed too far and alerted the other drivers!", "~r~Tu t'es trop éloigné et t'as alerté les autres chauffeurs_!", "~r~Du bist zu weit abgekommen und hast die anderen Fahrer alarmiert!", "~r~Ti sei allontanato troppo e hai allertato gli altri autisti!", "~r~¡Te has alejado demasiado y has alertado a los otros conductores!", "~r~Ты отбился от других водителей, и они забили тревогу!", "~r~¡Te has alejado demasiado y has alertado a los otros conductores!", "~r~¡Te has alejado demasiado y has alertado a los otros conductores!" } },
    { "STP3_08", { "~s~There is a ~y~pier~s~ to the South that you can dump the car off.", "~s~Il y a une ~y~jetée~s~ au sud. Tu pourras y balancer la caisse.", "~s~Im Süden ist ein ~y~Pier~s~, wo du das Auto versenken kannst.", "~s~A sud c'è un ~y~molo~s~ dal quale puoi lanciare la macchina.", "~s~Hay un ~y~muelle~s~ al sur donde puedes tirar el coche.", "~s~Езжай к ~y~пирсу~s~ к югу отсюда, там ты сможешь сбросить машину в воду.", "~s~Hay un ~y~muelle~s~ al sur donde puedes tirar el coche.", "~s~Hay un ~y~muelle~s~ al sur donde puedes tirar el coche." } },
    { "STP3_09", { "~s~Dump the car in the water but make sure no-one sees you!", "~s~Balance la caisse à la flotte, mais personne doit te voir_!", "~s~Versenke das Auto im Wasser, aber pass auf, dass dich niemand sieht!", "~s~Liberati della macchina lanciandola in acqua, ma assicurati che nessuno ti veda!", "~s~Tira el coche al agua, ¡pero asegúrate de que no te vea nadie!", "~s~Сбрось машину в воду, при этом убедись, что тебя никто не увидит!", "~s~Tira el coche al agua, ¡pero asegúrate de que no te vea nadie!", "~s~Tira el coche al agua, ¡pero asegúrate de que no te vea nadie!" } },
    { "STP3_10", { "~r~The convoy vehicle has been destroyed!", "~r~La caisse du convoi est foutue_!", "~r~Das Konvoi-Fahrzeug wurde zerstört!", "~r~L'auto del convoglio è stata distrutta!", "~r~¡El vehículo de la comitiva está destrozado!", "~r~Машина сопровождения уничтожена!", "~r~¡El vehículo de la comitiva está destrozado!", "~r~¡El vehículo de la comitiva está destrozado!" } },
    { "STP3_11", { "~S~Get in the ~r~car~s~.", "~S~Monte dans la ~r~caisse~s~.", "~S~Steig in das ~r~Auto~s~.", "~S~Sali in ~r~macchina~s~.", "~S~Sube al ~r~coche~s~.", "~s~Садись в ~r~машину~s~.", "~S~Sube al ~r~coche~s~.", "~S~Sube al ~r~coche~s~." } },
    { "STP3_12", { "~r~You left the car and alerted the other drivers!", "~r~T'es sorti de la caisse et t'as alerté les autres chauffeurs_!", "~r~Du hast das Auto verlassen und die anderen Fahrer alarmiert!", "~r~Hai abbandonato l'auto e allertato gli altri autisti!", "~r~¡Has abandonado el coche y alertado a los otros conductores!", "~r~Ты покинул машину и вызвал тревогу у других водителей!", "~r~¡Has abandonado el coche y alertado a los otros conductores!", "~r~¡Has abandonado el coche y alertado a los otros conductores!" } },
    { "STP3_13", { "~s~Get back in the ~b~car~s~ and get on with the mission.", "~s~Remonte dans la ~b~caisse~s~ et continue ta mission.", "~s~Steig wieder in das ~b~Auto~s~, und setz deine Mission fort.", "~s~Torna in ~b~macchina~s~ e continua la missione.", "~s~Vuelve al ~b~coche~s~ y sigue con la misión.", "~s~Вернись в ~b~машину~s~ и продолжай миссию.", "~s~Vuelve al ~b~coche~s~ y sigue con la misión.", "~s~Vuelve al ~b~coche~s~ y sigue con la misión." } },
    { "STP3_14", { "~s~You have ~1~ seconds to rejoin the convoy.", "~s~T'as ~1~ secondes pour rejoindre le convoi.", "~s~Du hast ~1~ Sekunden, den Konvoi einzuholen.", "~s~Hai ~1~ secondi per riunirti al convoglio.", "~s~Tienes ~1~ segundos para reincorporarte a la comitiva.", "~s~У тебя есть ~1~ сек., чтобы вернуться.", "~s~Tienes ~1~ segundos para reincorporarte a la comitiva.", "~s~Tienes ~1~ segundos para reincorporarte a la comitiva." } },
    { "STP3_15", { "~s~You have ~1~ second to rejoin the convoy.", "~s~T'as ~1~ seconde pour rejoindre le convoi.", "~s~Du hast ~1~ Sekunde, den Konvoi einzuholen.", "~s~Hai ~1~ secondo per riunirti al convoglio.", "~s~Tienes ~1~ segundo para reincorporarte a la comitiva.", "~s~У тебя есть ~1~ сек., чтобы вернуться.", "~s~Tienes ~1~ segundo para reincorporarte a la comitiva.", "~s~Tienes ~1~ segundo para reincorporarte a la comitiva." } },
    { "STP3_16", { "~r~You killed a cop and alerted the other drivers!", "~r~T'as tué un flic et alerté les autres chauffeurs_!", "~r~Du hast einen Cop getötet und die anderen Fahrer alarmiert!", "~r~Hai ucciso un poliziotto e allertato gli altri autisti!", "~r~¡Has matado a un policía y alertado a los otros conductores!", "~r~Убийство копа встревожило других водителей!", "~r~¡Has matado a un policía y alertado a los otros conductores!", "~r~¡Has matado a un policía y alertado a los otros conductores!" } },
    { "STP3_17", { "~r~You killed one of the other drivers!", "~r~T'as tué un des autres chauffeurs_!", "~r~Du hast einen der anderen Fahrer getötet!", "~r~Hai ucciso uno degli autisti!", "~r~¡Has matado a uno de los otros conductores!", "~r~Ты убил одного из водителей!", "~r~¡Has matado a uno de los otros conductores!", "~r~¡Has matado a uno de los otros conductores!" } },
