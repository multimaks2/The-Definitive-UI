    { "DOC2_X", { "~s~Find a way to save Madd Dogg before he jumps!", "~s~Trouve un moyen de sauver Madd Dogg avant qu'il saute_!", "~s~Suche einen Weg, Madd Dogg zu retten, bevor er springt!", "~s~Cerca un modo per salvare Madd Dogg prima che salti!", "~s~¡Encuentra una forma de salvar a Madd Dogg antes de que salte!", "~s~Найди способ спасти Мэдд Догга, пока он не прыгнул!", "~s~¡Encuentra una forma de salvar a Madd Dogg antes de que salte!", "~s~¡Encuentra una forma de salvar a Madd Dogg antes de que salte!" } },
    { "DOC2_01", { "~s~Use the ~b~pickup truck~s~ around the corner to rescue Madd Dogg!", "~s~Utilise le ~b~camion ~s~ au coin de la rue pour rattraper Madd Dogg_!", "~s~Nimm den ~b~Van~s~, der um die Ecke steht, um Madd Dogg zu retten!", "~s~Usa il ~b~furgone ~s~posteggiato dietro l'angolo per salvare Madd Dogg!", "~s~¡Usa la ~b~furgo ~s~que hay a la vuelta de la esquina para rescatar a Madd Dogg!", "~s~Используй ~b~пикап~s~, стоящий за углом, чтобы спасти Мэдд Догга!", "~s~¡Usa la ~b~furgo ~s~que hay a la vuelta de la esquina para rescatar a Madd Dogg!", "~s~¡Usa la ~b~furgo ~s~que hay a la vuelta de la esquina para rescatar a Madd Dogg!" } },
    { "DOC2_05", { "~s~Catch ~b~Madd Dogg ~s~when he jumps.", "~s~Rattrape ~b~Madd Dogg ~s~quand il saute.", "~s~Fang ~b~Madd Dogg ~s~auf, wenn er springt.", "~s~Prendi ~b~Madd Dogg ~s~quando salta.", "~s~Coge a ~y~Madd Dogg ~s~cuando salte.", "~s~Поймай ~b~Мэдд Догга~s~, когда он прыгнет.", "~s~Coge a ~y~Madd Dogg ~s~cuando salte.", "~s~Coge a ~y~Madd Dogg ~s~cuando salte." } },
    { "DOC2_06", { "~s~Drive Madd Dogg to ~y~hospital ~s~CAREFULLY. Each bump reduces his chance of survival.", "~s~Emmène Madd Dogg à l'~y~hôpital ~s~ET EN DOUCEUR. Le moindre choc diminue ses chances de survie.", "~s~Fahre Madd Dogg VORSICHTIG in die ~y~Klinik~s~. Jede Erschütterung mindert seine Überlebenschancen.", "~s~Porta Madd Dogg all'~y~ospedale ~s~GUIDANDO CON CAUTELA. Ogni impatto riduce le sue speranze di sopravvivenza.", "~s~Lleva a Madd Dogg al ~y~hospital ~s~CON CUIDADO. Cada golpe reduce sus posibilidades de supervivencia.", "~s~АККУРАТНО доставь Мэдд Догга в ~y~госпиталь~s~. Каждый толчок снижает его шансы выжить.", "~s~Lleva a Madd Dogg al ~y~hospital ~s~CON CUIDADO. Cada golpe reduce sus posibilidades de supervivencia.", "~s~Lleva a Madd Dogg al ~y~hospital ~s~CON CUIDADO. Cada golpe reduce sus posibilidades de supervivencia." } },
