    { "HEIH", { "Press ~k~~CONVERSATION_NO~ to answer NO or ~k~~CONVERSATION_YES~ for YES.", "Appuie sur ~k~~CONVERSATION_NO~ pour répondre NON ou sur ~k~~CONVERSATION_YES~ pour répondre OUI.", "Drücke ~k~~CONVERSATION_NO~, um mit NEIN zu antworten oder ~k~~CONVERSATION_YES~ für JA.", "Premi ~k~~CONVERSATION_NO~ per rispondere NO o ~k~~CONVERSATION_YES~ per rispondere SÌ.", "Pulsa ~k~~CONVERSATION_NO~ para responder NO o ~k~~CONVERSATION_YES~ para responder SÍ.", "~k~~CONVERSATION_NO~ - ответить НЕТ, ~n~~k~~CONVERSATION_YES~ - ответить ДА.", "Pulsa ~k~~CONVERSATION_NO~ para responder NO o ~k~~CONVERSATION_YES~ para responder SÍ.", "Pulsa ~k~~CONVERSATION_NO~ para responder NO o ~k~~CONVERSATION_YES~ para responder SÍ." } },
    { "HEIH2", { "Move close to the receptionist and press ~k~~PED_LOCK_TARGET~ to restart conversation.", "Approche-toi de la réceptionniste et appuie sur ~k~~PED_LOCK_TARGET~ pour reprendre la conversation.", "Geh zur Empfangsdame hin und drücke ~k~~PED_LOCK_TARGET~, um das Gespräch erneut zu beginnen.", "Avvicinati alla receptionist e premi ~k~~PED_LOCK_TARGET~ per riprendere la conversazione.", "Acércate a la recepcionista y pulsa ~k~~PED_LOCK_TARGET~ para reiniciar la conversación.", "Подойди к регистратуре и нажми ~k~~PED_LOCK_TARGET~, чтобы начать разговор заново.", "Acércate a la recepcionista y pulsa ~k~~PED_LOCK_TARGET~ para reiniciar la conversación.", "Acércate a la recepcionista y pulsa ~k~~PED_LOCK_TARGET~ para reiniciar la conversación." } },
    { "HEI1_28", { "~s~Face the blueprints then hold ~k~~PED_LOCK_TARGET~ and press ~k~~PED_FIREWEAPON~ to take a photograph.", "~s~Mets-toi face aux plans, puis maintiens ~k~~PED_LOCK_TARGET~ enfoncée et appuie sur ~k~~PED_FIREWEAPON~ pour prendre une photo.", "~s~Stell dich vor die Pläne. Halte dann ~k~~PED_LOCK_TARGET~ gedrückt und drücke ~k~~PED_FIREWEAPON~, um ein Foto zu machen.", "~s~Voltati verso i piani, tieni premuto ~k~~PED_LOCK_TARGET~ e premi ~k~~PED_FIREWEAPON~ per scattare una foto.", "~s~Ponte de cara a los planos, luego mantén pulsado ~k~~PED_LOCK_TARGET~ y pulsa ~k~~PED_FIREWEAPON~ para hacer una fotografía.", "~s~Встань перед чертежом, удерживай ~k~~PED_LOCK_TARGET~ и нажми ~k~~PED_FIREWEAPON~, чтобы сделать снимок.", "~s~Ponte de cara a los planos, luego mantén pulsado ~k~~PED_LOCK_TARGET~ y pulsa ~k~~PED_FIREWEAPON~ para hacer una fotografía.", "~s~Ponte de cara a los planos, luego mantén pulsado ~k~~PED_LOCK_TARGET~ y pulsa ~k~~PED_FIREWEAPON~ para hacer una fotografía." } },
    { "HEI1_29", { "~s~Take the camera film to the back entrance of the ~y~Four Dragons Casino~s~.", "~s~Amène la pellicule à la porte derrière le ~y~Four Dragons Casino~s~.", "~s~Bring den Film zum Hintertür von dem ~y~Four Dragons Casino~s~.", "~s~Porta il rullino fotografico all'entrata sul retro del ~y~casinò Four Dragons~s~.", "~s~Lleva la película a la entrada trasera del ~y~Casino Four Dragons~s~.", "~s~Доставь пленку к заднему входу ~y~казино Четыре Дракона~s~.", "~s~Lleva la película a la entrada trasera del ~y~Casino Four Dragons~s~.", "~s~Lleva la película a la entrada trasera del ~y~Casino Four Dragons~s~." } },
    { "HEI1_40", { "~s~You've got a camera, now head to the ~y~planning department~s~ building.", "~s~Maintenant que t'as un appareil photo, va jusqu'au bâtiment du ~y~service de l'urbanisme~s~.", "~s~Du hast eine Kamera. Begib dich jetzt zum Gebäude der ~y~Planungsbehörde~s~.", "~s~Hai una macchina fotografica, ora dirigiti all'~y~Ufficio di Urbanistica~s~.", "~s~Tienes una cámara, ahora dirígete al edificio de la ~y~oficina de urbanismo~s~.", "~s~У тебя есть фотоаппарат, отправляйся в ~y~центр планирования города~s~.", "~s~Tienes una cámara, ahora dirígete al edificio de la ~y~oficina de urbanismo~s~.", "~s~Tienes una cámara, ahora dirígete al edificio de la ~y~oficina de urbanismo~s~." } },
    { "HEI1_1", { "~s~Security's strict in the ~y~planning department~s~. Don't start trouble!", "~s~La sécurité est très stricte au ~y~service de l'urbanisme~s~. Evite les embrouilles_!", "~s~In der ~y~Planungsbehörde~s~ herrschen strenge Sicherheitsvorschriften. Mach keinen Ärger!", "~s~Le misure di sicurezza nell'~y~Ufficio di Urbanistica~s~ sono severe. Non creare fastidi!", "~s~En la ~y~oficina de urbanismo~s~ la seguridad es muy estricta. ¡No inicies un altercado!", "~s~В ~y~Центре планирования города~s~ очень серьезная охрана. Постарайся не попасть в неприятности!", "~s~En la ~y~oficina de urbanismo~s~ la seguridad es muy estricta. ¡No inicies un altercado!", "~s~En la ~y~oficina de urbanismo~s~ la seguridad es muy estricta. ¡No inicies un altercado!" } },
    { "HEI1_6", { "~s~You can't photo the casino blueprints with the guard around! You need to divert his attention.", "~s~Tu peux pas photographier les plans du casino si le garde est dans le coin_! Tu dois créer une diversion.", "~s~Du kannst die Casino-Pläne nicht fotografieren, wenn der Wachmann in der Nähe ist! Du musst ihn ablenken.", "~s~Non puoi fotografare i piani del casinò quando la guardia è vicina. Devi sviare la sua attenzione.", "~s~¡No puedes fotografiar los planos del casino con el guardia cerca! Tienes que distraer su atención.", "~s~Ты не можешь сфотографировать чертежи казино, пока рядом находится охранник! Тебе надо его отвлечь.", "~s~¡No puedes fotografiar los planos del casino con el guardia cerca! Tienes que distraer su atención.", "~s~¡No puedes fotografiar los planos del casino con el guardia cerca! Tienes que distraer su atención." } },
    { "HEI1_7", { "~s~There's a ~y~document depository~s~ downstairs. Head down to see if you can cause a distraction", "~s~Il y a des ~y~archives~s~ en bas. Va voir si tu peux faire diversion.", "~s~Unten ist ein ~y~Dokumentenarchiv~s~. Geh runter und sieh zu, ob du ein Ablenkungsmanöver starten kannst.", "~s~Di sotto c'è un ~y~archivio di documenti~s~. Scendi a controllare se puoi creare un diversivo.", "~s~Hay un ~y~archivo~s~ bajando las escaleras. Ve allí a ver si puedes crear una distracción.", "~s~На втором этаже находится ~y~архив документов~s~. Отправляйся туда и придумай, как отвлечь внимание охранника.", "~s~Hay un ~y~archivo~s~ bajando las escaleras. Ve allí a ver si puedes crear una distracción.", "~s~Hay un ~y~archivo~s~ bajando las escaleras. Ve allí a ver si puedes crear una distracción." } },
    { "HEI1_9", { "~s~This is a civic building. No visible guns or you'll be ejected from the premises", "~s~C'est un bâtiment officiel. Faut que tu planques tes flingues si tu veux pas te faire jeter.", "~s~Dies ist eine Behörde. Keine offen getragenen Waffen, sonst wirft man dich vom Gelände.", "~s~Questo è un edificio civico. Niente armi in vista, altrimenti verrai allontanato.", "~s~Esto es un edificio civil. Nada de armas a la vista o te expulsarán.", "~s~Это муниципальное заведение. Спрячь оружие, если не хочешь, чтобы тебя выгнали.", "~s~Esto es un edificio civil. Nada de armas a la vista o te expulsarán.", "~s~Esto es un edificio civil. Nada de armas a la vista o te expulsarán." } },
    { "HEI1_10", { "~s~Those old ~g~air con units~s~ are decrepit. Destroy them anyway you can.", "~s~Ces vieux ~g~climatiseurs~s~ ont l'air complètement nazes. Bousille-les comme tu voudras.", "~s~Diese ~g~Klimaanlagen~s~ sind ziemlich altersschwach. Zerstöre sie irgendwie.", "~s~Quei vecchi ~g~condizionatori~s~ sono decrepiti. Distruggili con qualsiasi mezzo.", "~s~Esas ~g~unidades de aire acondicionado~s~ están muy viejas. Destrúyelas como puedas.", "~s~Эти старые ~g~кондиционеры~s~ сильно износились. Уничтожь их любым способом.", "~s~Esas ~g~unidades de aire acondicionado~s~ están muy viejas. Destrúyelas como puedas.", "~s~Esas ~g~unidades de aire acondicionado~s~ están muy viejas. Destrúyelas como puedas." } },
    { "HEI1_11", { "~s~If you need another ~r~camera~s~ or film, head back to the casino area and persuade a tourist to part with theirs!", "~s~Si t'as besoin d'un autre ~g~appareil photo~s~ ou de pellicule, retourne dans le secteur du casino et persuade un touriste de te dépanner_!", "~s~Falls du noch eine ~r~Kamera~s~ oder einen Film brauchst, begib dich wieder Richtung Casino und überrede einen Touristen, seine Ausrüstung herauszurücken.", "~s~Se hai bisogno di un'altra ~g~macchina fotografica~s~ o di pellicola, torna al casinò e convinci un turista a dartela!", "~s~¡Si necesitas otra ~g~cámara~s~ o película, vuelve al casino y persuade a un turista para que te dé la suya!", "~s~Если тебе нужен еще один ~r~фотоаппарат~s~ или пленка, отправляйся назад к казино и заставь еще одного туриста расстаться с ним!", "~s~¡Si necesitas otra ~g~cámara~s~ o película, vuelve al casino y persuade a un turista para que te dé la suya!", "~s~¡Si necesitas otra ~g~cámara~s~ o película, vuelve al casino y persuade a un turista para que te dé la suya!" } },
    { "HEI1_20", { "~s~That's it! That fire alarm ought to occupy those guards.", "~s~Voilà_! Cette alarme d'incendie devrait occuper les gardes.", "~s~Das war's! Der Feueralarm dürfte die Wachmänner beschäftigen.", "~s~Ecco fatto! L'allarme antincendio dovrebbe tenere occupate le guardie.", "~s~¡Bien! La alarma de incendios distraerá a esos guardias.", "~s~Есть! Пожарная тревога должна отвлечь охрану.", "~s~¡Bien! La alarma de incendios distraerá a esos guardias.", "~s~¡Bien! La alarma de incendios distraerá a esos guardias." } },
    { "HEI1_22", { "~s~Okay! They're busy with the evacuation just now. Get upstairs and photograph those ~y~blueprints~s~ pinned to the wall.", "~s~Bon_! Les voilà occupés à faire évacuer les lieux. Monte à l'étage et va photographier les ~y~plans~s~ accrochés au mur.", "~s~Okay! Sie sind jetzt mit der Evakuierung beschäftigt. Geh nach oben und fotografiere die ~y~Pläne~s~ an der Wand.", "~s~Va bene! Ora sono occupati con l'evacuazione dell'edificio. Sali di sopra e fotografa i ~y~piani~s~ appesi al muro.", "~s~¡Vale! Ahora están ocupados con la evacuación. Sube y fotografía los ~y~planos~s~ sujetos a la pared.", "~s~Отлично! Теперь охрана будет занята эвакуацией. Поднимайся на третий этаж и сфотографируй ~y~чертежи~s~ казино.", "~s~¡Vale! Ahora están ocupados con la evacuación. Sube y fotografía los ~y~planos~s~ sujetos a la pared.", "~s~¡Vale! Ahora están ocupados con la evacuación. Sube y fotografía los ~y~planos~s~ sujetos a la pared." } },
    { "HEI1_25", { "~s~Great! You've photographed the casino blueprints! Get out of the ~y~building~s~ before you're caught.", "~s~Cool_! T'as photographié les plans du casino_! Sors vite du ~y~bâtiment~s~ avant de te faire choper.", "~s~Sehr gut! Du hast die Casino-Pläne fotografiert! Verlass jetzt das ~y~Gebäude~s~, bevor man dich erwischt.", "~s~Ottimo! Hai fotografato i piani del casinò! Esci dall'~y~edificio~s~ prima di essere catturato.", "~s~¡Estupendo! ¡Has fotografiado los planos del casino! Sal del ~y~edificio~s~ antes de que te pillen.", "~s~Отлично! Ты сфотографировал чертежи казино! Убирайся из ~y~здания~s~ до того, как тебя поймают.", "~s~¡Estupendo! ¡Has fotografiado los planos del casino! Sal del ~y~edificio~s~ antes de que te pillen.", "~s~¡Estupendo! ¡Has fotografiado los planos del casino! Sal del ~y~edificio~s~ antes de que te pillen." } },
    { "HEI1_33", { "~s~The ~y~stairwell~s~ is now accessible. Climb up to get to the location of the blueprints.", "~s~L'~y~escalier~s~ est maintenant accessible. Grimpe les marches pour arriver jusqu'aux plans.", "~s~Das ~y~Treppenhaus~s~ ist jetzt zugänglich. Klettere in das Stockwerk hinauf, wo die Pläne aufbewahrt werden.", "~s~Ora le ~y~scale~s~ sono accessibili. Sali e raggiungi la stanza dove si trovano i piani.", "~s~Ahora se puede acceder a las ~y~escaleras~s~. Sube para llegar al lugar donde están los planos.", "~s~Получен доступ к ~y~лестничной клетке~s~. Поднимайся на последний этаж в помещение, где находятся чертежи.", "~s~Ahora se puede acceder a las ~y~escaleras~s~. Sube para llegar al lugar donde están los planos.", "~s~Ahora se puede acceder a las ~y~escaleras~s~. Sube para llegar al lugar donde están los planos." } },
    { "HEI1_34", { "~s~The ~y~blueprints~s~ you need to photograph are in the far room on the top floor.", "~s~Les ~y~plans~s~ que tu dois photographier sont dans la pièce du fond, au dernier étage.", "~s~Die ~y~Pläne~s~, die du fotografieren sollst, sind in dem hinteren Raum im obersten Stockwerk.", "~s~I ~y~piani~s~ che devi fotografare si trovano all'ultimo piano, nella stanza in fondo.", "~s~Los ~y~planos~s~ que necesitas fotografiar están en la habitación más alejada del piso superior.", "~s~~y~Чертежи~s~, которые тебе необходимо сфотографировать, находятся на третьем этаже в дальней комнате.", "~s~Los ~y~planos~s~ que necesitas fotografiar están en la habitación más alejada del piso superior.", "~s~Los ~y~planos~s~ que necesitas fotografiar están en la habitación más alejada del piso superior." } },
    { "HEI1_35", { "~s~There are ~r~tourists~s~ on that ship. Identify one with a camera and take it by force.", "~s~Il y a des ~r~touristes~s~ sur ce bateau. Trouves-en un muni d'un appareil photo et prends-lui de force_!", "~s~Auf diesem Schiff sind ~r~Touristen~s~. Such dir einen mit einer Kamera und nimm sie ihm ab.", "~s~Su quella nave ci sono dei ~r~turisti~s~. Scegline uno munito di macchina fotografica e portagliela via con la forza.", "~s~En ese barco hay ~r~turistas~s~. Encuentra a uno con una cámara y quítasela por la fuerza.", "~s~~r~Туристы~s~ находятся на корабле. Выбери одного с фотоаппаратом и силой отними его.", "~s~En ese barco hay ~r~turistas~s~. Encuentra a uno con una cámara y quítasela por la fuerza.", "~s~En ese barco hay ~r~turistas~s~. Encuentra a uno con una cámara y quítasela por la fuerza." } },
    { "HEI1_39", { "~s~Good! Get that ~g~camera~s~ picked up.", "~s~Parfait_! Va ramasser cet ~g~appareil photo~s~.", "~s~Gut! Nimm dir die ~g~Kamera~s~.", "~s~Bene! Raccogli quella ~g~macchina fotografica~s~.", "~s~¡Bien! Hazte con esa ~g~cámara~s~.", "~s~Отлично! Подбери ~g~фотоаппарат~s~.", "~s~¡Bien! Hazte con esa ~g~cámara~s~.", "~s~¡Bien! Hazte con esa ~g~cámara~s~." } },
    { "HEI1_41", { "~s~You need a camera to get a copy of those casino blueprints. Grab one from some ~r~tourists~s~ at the strip.", "~s~Il te faut un appareil pour photographier les plans du casino. Piques-en un aux ~r~touristes~s~ sur l'avenue branchée.", "~s~Du brauchst eine Kamera, um die Casino-Pläne zu fotografieren. Schnapp dir eine von einem ~r~Touristen~s~ auf dem Strip.", "~s~Ti serve una macchina fotografica per ricavare una copia dei piani del casinò. Prendine una a qualche ~r~turista~s~ lungo la Strip.", "~s~Necesitas una cámara para hacer una copia de los planos del casino. Quítasela a alguno de los ~r~turistas~s~ que hay en el bulevar.", "~s~Тебе понадобится фотоаппарат, чтобы сделать снимки чертежей казино. Забери его у одного из ~r~туристов~s~ на Центральном Шоссе.", "~s~Necesitas una cámara para hacer una copia de los planos del casino. Quítasela a alguno de los ~r~turistas~s~ que hay en el bulevar.", "~s~Necesitas una cámara para hacer una copia de los planos del casino. Quítasela a alguno de los ~r~turistas~s~ que hay en el bulevar." } },
    { "HEI1_46", { "~s~The cops can't shut the bottom doors due to the fire! Use your weapons if you need to.", "~s~Les flics peuvent pas fermer les portes du bas à cause du feu_! Sors ton artillerie si t'as pas le choix.", "~s~Die Cops können wegen des Feuers die unteren Türen nicht schließen! Mach wenn nötig von deinen Waffen Gebrauch.", "~s~I poliziotti non possono chiudere le porte inferiori a causa dell'incendio! Se necessario, usa le armi.", "~s~¡Los policías no pueden cerrar las puertas de abajo debido al fuego! Usa las armas si es necesario.", "~s~Копы не могут закрыть двери, пока не приедут пожарные! По необходимости используй оружие.", "~s~¡Los policías no pueden cerrar las puertas de abajo debido al fuego! Usa las armas si es necesario.", "~s~¡Los policías no pueden cerrar las puertas de abajo debido al fuego! Usa las armas si es necesario." } },
    { "HEI1_50", { "~r~You were told that this is a low-profile job and you were showing off your weaponry!", "~r~On t'a dit que c'était un boulot discret et toi, tu frimes avec ton artillerie_!", "~r~Du solltest dich unauffällig verhalten, und du hast mit deinen Waffen rumgefuchtelt!", "~r~Hai fatto vedere le armi quando sapevi che il lavoro richiedeva discrezione!", "~r~¡Se te dijo que éste era un trabajo discreto y has estado luciendo todo tu armamento!", "~r~Тебе же сказали, что это муниципальное заведение, куда нельзя приносить оружие!", "~r~¡Se te dijo que éste era un trabajo discreto y has estado luciendo todo tu armamento!", "~r~¡Se te dijo que éste era un trabajo discreto y has estado luciendo todo tu armamento!" } },
    { "HEI1_52", { "~r~That's just great! We should have distracted the guard before taking any photographs!", "~r~Ah, bravo_! Il fallait distraire les gardes AVANT de prendre des photos_!", "~r~Na, wunderbar! Du hättest vor dem Fotografieren den Wachmann ablenken sollen.", "~r~Ah, fantastico! Avresti dovuto distrarre le guardie prima di scattare le foto!", "~r~¡Pues vaya! ¡Tenías que haber distraído al guardia antes de tomar las fotografías!", "~r~Замечательно! Ты должен был отвлечь охранника ДО того, как сделаешь снимки!", "~r~¡Pues vaya! ¡Tenías que haber distraído al guardia antes de tomar las fotografías!", "~r~¡Pues vaya! ¡Tenías que haber distraído al guardia antes de tomar las fotografías!" } },
    { "HEI2_11", { "Press ~k~~PED_FIREWEAPON~ to open chute.", "Appuie sur ~k~~PED_FIREWEAPON~ pour ouvrir le parachute.", "Drücke ~k~~PED_FIREWEAPON~, um den Fallschirm zu öffnen.", "Premi ~k~~PED_FIREWEAPON~ per aprire il paracadute.", "Pulsa ~k~~PED_FIREWEAPON~ para abrir el paracaídas.", "~k~~PED_FIREWEAPON~ - открыть парашют.", "Pulsa ~k~~PED_FIREWEAPON~ para abrir el paracaídas.", "Pulsa ~k~~PED_FIREWEAPON~ para abrir el paracaídas." } },
    { "HEI2_2", { "~s~When close to a ~y~generator~s~ press ~k~~VEHICLE_ENTER_EXIT~ to plant the charges. You need one on each ~y~generator~s~.", "~s~Lorsque tu es face à un ~y~générateur~s~, appuie sur ~k~~VEHICLE_ENTER_EXIT~ pour placer les explosifs. Tu dois placer une charge sur chaque ~y~générateur~s~.", "~s~Drücke in der Nähe eines ~y~Generators~s~ ~k~~VEHICLE_ENTER_EXIT~, um die Ladungen zu platzieren. Du brauchst eine Ladung für jeden Generator.", "~s~Quando sei vicino a un ~y~generatore~s~ premi ~k~~VEHICLE_ENTER_EXIT~ per piazzare le cariche. Ne avrai bisogno di una per ~y~generatore~s~.", "~s~Cuando estés cerca de un ~y~generador~s~, pulsa ~k~~VEHICLE_ENTER_EXIT~ para colocar las cargas. Tienes que poner una en cada ~y~generador~s~.", "~s~Подойди к ~y~генератору~s~ и нажми ~k~~VEHICLE_ENTER_EXIT~, чтобы установить взрывчатку. Необходимо установить по одному заряду на каждый ~y~генератор~s~.", "~s~Cuando estés cerca de un ~y~generador~s~, pulsa ~k~~VEHICLE_ENTER_EXIT~ para colocar las cargas. Tienes que poner una en cada ~y~generador~s~.", "~s~Cuando estés cerca de un ~y~generador~s~, pulsa ~k~~VEHICLE_ENTER_EXIT~ para colocar las cargas. Tienes que poner una en cada ~y~generador~s~." } },
