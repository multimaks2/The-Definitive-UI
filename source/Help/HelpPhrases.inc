    { "HEI2_28", { "~s~Get back in the ~b~plane~s~!", "~s~Remonte dans l'~b~avion~s~_!", "~s~Steig wieder in das ~b~Flugzeug~s~!", "~s~Torna nell'~b~aereo~s~!", "¡~s~Vuelve al ~b~avión~s~!", "~s~Вернись в ~b~самолет~s~!", "¡~s~Vuelve al ~b~avión~s~!", "¡~s~Vuelve al ~b~avión~s~!" } },
