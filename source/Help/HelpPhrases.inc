    { "GW_WON", { "~w~That showed them. The area remains yours!", "~w~Ils ont compris la leçon. Le secteur est toujours à toi_!", "~w~Du hast es ihnen gezeigt. Das Gebiet bleibt in deiner Hand!", "~w~Gli servirà di lezione. La zona resta tua!", "~w~Eso les enseñará. ¡Esta zona sigue siendo tuya!", "~w~Ты показал им, с кем они связались. Территория остается за тобой!", "~w~Eso les enseñará. ¡Esta zona sigue siendo tuya!", "~w~Eso les enseñará. ¡Esta zona sigue siendo tuya!" } },
    { "GW_NOSH", { "~w~You left the attack unchecked! You lost influence.", "~w~T'as rien fait pour contrer l'attaque_! T'as perdu de l'influence.", "~w~Du hast nicht auf den Angriff reagiert. Du hast an Einfluss verloren.", "~w~Non hai tenuto l'attacco sotto controllo! Hai perso influenza.", "~w~¡No has respondido al ataque! Has perdido influencia.", "~w~Ты не обратил внимания на атакуемую территорию. Ты потерял над ней контроль.", "~w~¡No has respondido al ataque! Has perdido influencia.", "~w~¡No has respondido al ataque! Has perdido influencia." } },
    { "GW_SLOW", { "~w~It's taken too long! You lost influence.", "~w~Ca a mis trop de temps_! T'as perdu de l'influence.", "~w~Das hat zu lange gedauert! Du hast an Einfluss verloren.", "~w~Ci hai messo troppo! Hai perso influenza.", "~w~¡Has tardado demasiado! Has perdido influencia.", "~w~Ты очень долго отбивал территорию. Ты потерял над ней контроль.", "~w~¡Has tardado demasiado! Has perdido influencia.", "~w~¡Has tardado demasiado! Has perdido influencia." } },
