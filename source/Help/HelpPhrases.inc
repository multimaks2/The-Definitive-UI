    { "CS2_4", { "~s~This is the Los Santos police precinct. Also home to the city's impounded vehicles.", "~s~Voici le poste de police de Los Santos. C'est aussi la fourrière de la ville.", "~s~Das ist das Polizeirevier von Los Santos. Hier werden auch beschlagnahmte Fahrzeuge verwahrt.", "~s~Questo è il distretto di polizia di Los Santos. Qui vengono portati anche i veicoli sequestrati.", "~s~Ésta es la central de la policía de Los Santos. Aquí también se guardan los coches confiscados en la ciudad.", "~s~ЗТО ТЕРРИТОРИЯ ПОЛИЦИИ ЛОС САНТОСА. А ТАКЖЕ ЗДЕСЬ ХРАНЯТ МАШИНЫ, КОТОРЫЕ БЫЛИ ЗВАКУИРОВАНЫ В ГОРОДЕ.", "~s~Ésta es la central de la policía de Los Santos. Aquí también se guardan los coches confiscados en la ciudad.", "~s~Ésta es la central de la policía de Los Santos. Aquí también se guardan los coches confiscados en la ciudad." } },
    { "CS2_5", { "~s~An entrance at the side of the precinct leads to its secure underground car park.", "~s~Une entrée latérale mène au parking souterrain sécurisé.", "~s~Ein Nebeneingang des Reviers führt zu seiner bewachten unterirdischen Parkgarage.", "~s~Un ingresso sul lato del distretto conduce al parcheggio sotterraneo ben sorvegliato.", "~s~Hay una entrada en el lateral del recinto que conduce al aparcamiento subterráneo de seguridad.", "~s~ВХОД С БОКОВОИ СТОРОНЫ ВЕДЕТ НА ОХРАНЯЕМУЮ ПОДЗЕМНУЮ АВТОМОБИЛЬНУЮ СТОЯНКУ.", "~s~Hay una entrada en el lateral del recinto que conduce al aparcamiento subterráneo de seguridad.", "~s~Hay una entrada en el lateral del recinto que conduce al aparcamiento subterráneo de seguridad." } },
    { "CS2_6", { "~s~Impounded vehicles are found down here, but it's a hive of cop activity.", "~s~C'est là qu'ils parquent les véhicules en fourrière, mais ça grouille de flics.", "~s~Dort befinden sich die verwahrten Fahrzuge, aber es wimmelt dort auch von Bullen.", "~s~I veicoli sequestrati si trovano quaggiù, ma è un alveare pullulante di poliziotti.", "~s~Los vehículos confiscados están ahí abajo, pero es un hervidero de actividad policial.", "~s~ЗВАКУИРОВАНЫЕ МАШИНЫ НАХОДЯТСЯ ТАМ, НО ЭТО НАСТОЯШИИ УЛЕИ КОПОВ, КОТОРЫИ ПОСТОЯННО АКТИВЕН.", "~s~Los vehículos confiscados están ahí abajo, pero es un hervidero de actividad policial.", "~s~Los vehículos confiscados están ahí abajo, pero es un hervidero de actividad policial." } },
    { "CS2_7", { "~s~The garage at the rear is where yours and other impounded vehicles are held.", "~s~Ta caisse et les autres bagnoles en fourrière sont dans le garage du fond.", "~s~Dein Auto befindet sich zusammen mit anderen beschlagnahmten Fahrzeugen in der hinteren Garage.", "~s~Il garage sul retro è quello in cui si trovano la tua e le altre auto sequestrate.", "~s~El garaje de atrás es donde están tu coche y otros vehículos requisados.", "~s~ГАРАЖ В ДАЛЬНЕМ КОНЦЕ, ЭТО МЕСТО ГДЕ ХРАНЯТСЯ ТВОЯ И ДРУГИЕ ЗВАКУИРОВАННЫЕ МАШИНЫ.", "~s~El garaje de atrás es donde están tu coche y otros vehículos requisados.", "~s~El garaje de atrás es donde están tu coche y otros vehículos requisados." } },
    { "CS2_15", { "~s~You need a car for Cesar to work on.", "~s~Il te faut une caisse pour que Cesar la bricole.", "~s~Du brauchst ein Auto, mit dem Cesar arbeiten kann.", "~s~Hai bisogno di un'auto su cui far lavorare Cesar.", "~s~Necesitas un coche para que César trabaje en él.", "~s~ТЕБЕ НУЖНА МАШИНА, ЧТОБЫ НАД НЕИ ПОРАБОТАЛ ЦЕЗАРЬ.", "~s~Necesitas un coche para que César trabaje en él.", "~s~Necesitas un coche para que César trabaje en él." } },
    { "CS2_16", { "~r~You're meant to get the car back safely.", "~r~Tu dois ramener la caisse en un seul morceau.", "~r~Du musst das Auto unbeschädigt zu ihm bringen.", "~r~Devi portare indietro l'auto tutta intera.", "~r~Se supone que tienes que traer el coche a salvo.", "~r~ТЫ ДОЛЖЕН БЕЗОПАСНО ВЕРНУТЬ СЕБЕ МАШИНУ.", "~r~Se supone que tienes que traer el coche a salvo.", "~r~Se supone que tienes que traer el coche a salvo." } },
    { "CS2_23", { "~s~Get to the impound and retrieve your ~b~car~s~.", "~s~Va à la fourrière et récupère ta ~b~caisse~s~.", "~s~Begib dich zu der Verwahrstelle und hol dir dein ~b~Auto~s~ wieder.", "~s~Raggiungi il parcheggio e recupera la tua ~b~macchina~s~.", "~s~Ve al depósito y recupera tu ~b~coche~s~.", "~s~ОТПРАВЛЯИСЯ НА ТЕРРИТОРИЮ СТОЯНКИ И ЗАБЕРИ СВОЮ ~b~МАШИНУ~s~.", "~s~Ve al depósito y recupera tu ~b~coche~s~.", "~s~Ve al depósito y recupera tu ~b~coche~s~." } },
    { "CS2_24", { "~s~Get a car and take it to ~y~Cesar's place~s~.", "~s~Prends une caisse et amène-la chez ~y~Cesar~s~.", "~s~Schnapp dir ein Auto und bring es zu ~y~Cesar~s~.", "~s~Prendi un'auto e portala da ~y~Cesar~s~.", "~s~Consigue un coche y llévalo a ~y~casa de César~s~.", "~s~ЗАБЕРИ МАШИНУ И ОТВЕЗИ ЕЕ ~y~К ЦЕЗАРЮ~s~.", "~s~Consigue un coche y llévalo a ~y~casa de César~s~.", "~s~Consigue un coche y llévalo a ~y~casa de César~s~." } },
    { "CS2_25", { "~s~Get back in the ~b~car~s~.", "~s~Remonte dans la ~b~caisse~s~.", "~s~Steig wieder in das ~b~Auto~s~.", "~s~Rientra nella ~b~macchina~s~.", "~s~Vuelve al ~b~coche~s~.", "~s~Gет васк in тhе ~b~саr~s~.", "~s~Vuelve al ~b~coche~s~.", "~s~Vuelve al ~b~coche~s~." } },
    { "CS2_26", { "~s~Get back to ~y~Cesar's place~s~.", "~s~Retourne chez ~y~Cesar~s~.", "~s~Fahr zurück zu ~y~Cesar~s~.", "~s~Ritorna da ~y~Cesar~s~.", "~s~Vuelve a ~y~casa de César~s~.", "~s~Gет васк то ~y~Сеsаr's рlасе~s~.", "~s~Vuelve a ~y~casa de César~s~.", "~s~Vuelve a ~y~casa de César~s~." } },
    { "CS2_27", { "~S~Cesar won't work on this vehicle! Try something else.", "~S~Cesar refusera de bricoler ce tas de ferraille_! Trouve-toi autre chose_!", "~S~Mit der Karre brauchst du Cesar gar nicht zu kommen! Nimm ein anderes.", "~S~Cesar non lavorerà su questo veicolo! Prova qualcos'altro.", "¡~s~César no trabajará en este vehículo! Prueba con otro.", "~S~ЦЕЗАРЬ НЕ БУДЕТ РАБОТАТЬ С ЗТОИ МАШИНОИ ! ПОПРОБУИ ДРУГУЮ.", "¡~s~César no trabajará en este vehículo! Prueba con otro.", "¡~s~César no trabajará en este vehículo! Prueba con otro." } },
