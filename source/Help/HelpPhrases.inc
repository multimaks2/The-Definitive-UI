    { "QUAR_05", { "~s~Get into the ~y~crane.", "~s~Monte dans la ~y~grue~s~.", "~s~Steig in den ~y~Kran~s~.", "~s~Entra nella ~y~gru~s~.", "~s~Sube a la ~y~grúa.", "~s~Залезай на ~y~кран~s~.", "~s~Sube a la ~y~grúa.", "~s~Sube a la ~y~grúa." } },
    { "QUAR_06", { "~s~Use the crane to load the body and the bike into the back of the ~b~dumper truck~s~.", "~s~Utilise la grue pour charger le cadavre et la moto à l'arrière du ~b~dumper~s~.", "~s~Hebe die Leiche und das Motorrad mit dem Kran auf die Ladefläche des ~b~Kippers~s~.", "~s~Usa la gru per caricare il corpo e la moto nel cassone dell'~b~autoribaltabile~s~.", "~s~Usa la grúa para cargar el cadáver y la moto en la parte de atrás del ~b~volquete~s~.", "~s~Используй кран, чтобы погрузить тело и мотоцикл в кузов ~b~самосвала~s~.", "~s~Usa la grúa para cargar el cadáver y la moto en la parte de atrás del ~b~volquete~s~.", "~s~Usa la grúa para cargar el cadáver y la moto en la parte de atrás del ~b~volquete~s~." } },
